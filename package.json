{
  "name": "amisynth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AmiSynth: an LLM-friendly synth & drum machine for the browser (AudioWorklet), designed to be ported to REAPER JSFX.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepare": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "gen:jsfx": "node scripts/gen-jsfx-sliders.js",
    "install:reaper": "node scripts/install-reaper.js",
    "install:clap": "node scripts/install-clap.js",
    "audition:timbre": "node scripts/timbre-audition.js",
    "audition:preset": "node scripts/preset-audition.js",
    "check:performance": "node scripts/performance-check.js",
    "check:catalogs": "node scripts/catalog-integrity.js",
    "deploy": "npm run build && wrangler deploy",
    "jsfx:tools": "bash scripts/build-jsfx-render.sh",
    "jsfx:tools:ysfx-s": "bash scripts/build-jsfx-render.sh --ysfx-s",
    "jsfx:compare": "node scripts/jsfx-compare.js",
    "test:ysfx-s": "node scripts/test-ysfx-s.js",
    "clap:build": "cmake -S clap -B .cache/clap-build -DCMAKE_BUILD_TYPE=Release && cmake --build .cache/clap-build --config Release",
    "test:clap": "node scripts/test-clap.js && node --test tests/clap.test.js"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7"
  }
}
