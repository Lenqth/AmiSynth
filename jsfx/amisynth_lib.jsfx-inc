desc:AmiSynth shared DSP library (port of src/dsp/lib.js)
// Imported by the AmiSynth JSFX instruments. Function names, argument order and
// formulas match src/dsp/lib.js one to one, so the two can be compared sample by
// sample (see jsfx/README.md and tests/jsfx.test.js).
//
// JS  foo_process(o, x) with o.state   ->   o.foo_process(x)  with instance(state)
// Note: EEL2 `==` is fuzzy (|a-b| < 0.00001); exact comparisons use `===`.

@init

// ---------------------------------------------------------------------------
// Memory: a tiny bump allocator for tables and delay lines.
mem_top = 1024;
function mem_alloc(n) local(p) (
  p = mem_top;
  mem_top += n;
  p;
);

// ---------------------------------------------------------------------------
// Utilities

function clamp(x, lo, hi) ( x < lo ? lo : x > hi ? hi : x; );

function db_to_gain(db) ( db <= -60 ? 0 : pow(10, db / 20); );

/** coefficient for an exponential decay reaching -60 dB after `ms` */
function t60_coef(ms) ( exp(-6.907755 / (max(ms, 0.01) * 0.001 * srate)); );

/** one-pole smoother coefficient with time constant `ms` */
function tau_coef(ms) ( exp(-1 / (max(ms, 0.001) * 0.001 * srate)); );

/** tanh-like soft clipper, exactly +/-1 beyond |x| >= 3 */
function soft_clip(x) local(x2) (
  x > 3 ? 1 : x < -3 ? -1 : (
    x2 = x * x;
    (x * (27 + x2)) / (27 + 9 * x2);
  );
);

// Deterministic white noise (Park-Miller LCG in plain double arithmetic; same
// sequence as noise_white() in lib.js).
noise_state = 22222;
function noise_seed(seed) ( noise_state = max(1, floor(seed) % 2147483646); );
function noise_white() (
  noise_state *= 16807;
  noise_state -= floor(noise_state / 2147483647) * 2147483647;
  noise_state / 1073741823.5 - 1;
);
function random_unit() ( (noise_white() + 1) * 0.5; );

/** equal-power pan; writes gl / gr */
function pan_gains(pan) instance(gl gr) local(a) (
  a = (clamp(pan, -1, 1) + 1) * 0.25 * $pi;
  gl = cos(a) * 1.41421356;
  gr = sin(a) * 1.41421356;
);

// ---------------------------------------------------------------------------
// Tuning: a table of degrees (cents) + period; EDO fills the table evenly.
// The reference (tuning_rnote / tuning_rhz) is set by tuning_apply(): the instrument's
// tuning_ref_note / tuning_ref_hz sliders, or the ones of a shared AmiSynth Tuning slot.

tuning_table = mem_alloc(256);
tuning_size = 12;
tuning_period = 1200;
tuning_rnote = 69;
tuning_rhz = 440;
tuning_seen = -1; // serial of the shared slot last read

function tuning_set_edo(divisions, period) local(i) (
  divisions = max(1, min(255, floor(divisions + 0.5)));
  tuning_size = divisions;
  tuning_period = period;
  i = 0;
  while (i < divisions) (
    tuning_table[i] = (i * period) / divisions;
    i += 1;
  );
);

/** count degrees from tuning_tmp (Scala order: degrees 1..N, the last one is the period) */
tuning_tmp = mem_alloc(256);
function tuning_set_table(count) local(i) (
  count = max(1, min(255, count));
  tuning_size = count;
  tuning_table[0] = 0;
  i = 1;
  loop(count - 1, tuning_table[i] = tuning_tmp[i - 1]; i += 1;);
  tuning_period = tuning_tmp[count - 1];
);

// ---- Scala (.scl) reader for the shared scale file REAPER/Data/AmiSynth/tuning.txt
// (a .txt name because JSFX only reads text files with that extension).
// Lines starting with '!' are comments; then a description line, the number of notes, and one
// pitch per line: cents if it contains a '.', otherwise a ratio "a/b" or a whole number.

/** parse a number at tp_pos of #tuning_line into tp_val; tp_dot = 1 if it had a '.'; returns 1 if any digit */
function tuning_parse_number() local(c, sign, any, scale) (
  tp_val = 0; tp_dot = 0; any = 0; sign = 1; scale = 0.1;
  c = str_getchar(#tuning_line, tp_pos);
  c === 45 ? ( sign = -1; tp_pos += 1; ) : c === 43 ? tp_pos += 1;
  c = str_getchar(#tuning_line, tp_pos);
  while ((c >= 48 && c <= 57) || (c === 46 && !tp_dot)) (
    c === 46 ? tp_dot = 1 : (
      any = 1;
      tp_dot ? ( tp_val += (c - 48) * scale; scale *= 0.1; ) : tp_val = tp_val * 10 + (c - 48);
    );
    tp_pos += 1;
    c = str_getchar(#tuning_line, tp_pos);
  );
  tp_val *= sign;
  any;
);

function tuning_skip_space() local(c) (
  c = str_getchar(#tuning_line, tp_pos);
  while (c === 32 || c === 9) ( tp_pos += 1; c = str_getchar(#tuning_line, tp_pos); );
);

/** pitch line -> tp_cents; returns 1 if it held a pitch */
function tuning_parse_pitch() local(a, b) (
  tp_pos = 0;
  tuning_skip_space();
  tuning_parse_number() ? (
    tp_dot ? tp_cents = tp_val : (
      a = tp_val;
      b = 1;
      str_getchar(#tuning_line, tp_pos) === 47 ? ( tp_pos += 1; tuning_parse_number() ? b = tp_val; );
      tp_cents = a > 0 && b > 0 ? 1200 * log(a / b) / log(2) : 0;
    );
    1;
  ) : 0;
);

/**
 * Read a Scala scale from an open file handle (closes it) into tuning_tmp; returns the number of
 * degrees (0 if the file could not be read). tuning_set_table(n) then makes it the tuning.
 */
function tuning_read_scala(h) local(stage, count, k, ok) (
  ok = 0;
  h >= 0 ? (
    file_text(h) ? (
      stage = 0; count = 0; k = 0;
      while ((stage < 2 || k < count) && file_string(h, #tuning_line) > 0) (
        str_getchar(#tuning_line, 0) !== 33 ? (
          stage === 0 ? (
            stage = 1; // description
          ) : stage === 1 ? (
            tp_pos = 0;
            tuning_skip_space();
            tuning_parse_number() ? ( count = min(255, floor(tp_val)); stage = 2; );
          ) : (
            tuning_parse_pitch() ? ( tuning_tmp[k] = tp_cents; k += 1; );
          );
        );
      );
      count > 0 && k === count && tuning_tmp[count - 1] > 0 ? ok = count;
    );
    file_close(h);
  );
  ok;
);

/** read REAPER/Data/AmiSynth/tuning.txt into the tuning table; returns 1 on success */
function tuning_load_file() local(n) (
  n = tuning_read_scala(file_open("AmiSynth/tuning.txt"));
  n > 0 ? tuning_set_table(n);
  n > 0;
);

// ---- Shared scales between AmiSynth JSFX (gmem, namespace "AmiSynth" via options:gmem).
// Slot s (1..8) at gmem[s * 512]: [serial, size, ref note, ref Hz, degree 1 .. degree size (cents)].
// The AmiSynth Tuning JSFX writes the data and then bumps the serial; instruments re-read a slot
// whenever its serial changes (reading the serial first, so a slot being rewritten is read again).

function tuning_publish(slot, count, ref_note, ref_hz) local(b, i) (
  b = slot * 512;
  gmem[b + 1] = count;
  gmem[b + 2] = ref_note;
  gmem[b + 3] = ref_hz;
  i = 0;
  loop(count, gmem[b + 4 + i] = tuning_tmp[i]; i += 1;);
  gmem[b] += 1;
);

/** take the scale of a shared slot; returns 1 if the slot holds one */
function tuning_follow(slot) local(b, n, i) (
  b = slot * 512;
  tuning_seen = gmem[b];
  n = floor(gmem[b + 1]);
  tuning_seen > 0 && n >= 1 && n <= 255 && gmem[b + 3 + n] > 0 ? (
    i = 0;
    loop(n, tuning_tmp[i] = gmem[b + 4 + i]; i += 1;);
    tuning_set_table(n);
    tuning_rnote = gmem[b + 2];
    tuning_rhz = gmem[b + 3];
    1;
  ) : 0;
);

/** 1 when the instrument follows a shared slot that changed since it was last read (call in @block) */
function tuning_shared_changed() (
  tuning_source >= 1.5 && gmem[clamp(floor(tuning_slot + 0.5), 1, 8) * 512] !== tuning_seen;
);

/**
 * Set the instrument's tuning from its sliders (call in @slider, and in @block when
 * tuning_shared_changed()): EDO sliders, the scale file, or a shared slot; EDO if those fail.
 */
function tuning_apply() local(ok) (
  tuning_rnote = tuning_ref_note;
  tuning_rhz = tuning_ref_hz;
  ok = tuning_source >= 1.5 ? tuning_follow(clamp(floor(tuning_slot + 0.5), 1, 8))
    : tuning_source >= 0.5 ? tuning_load_file() : 0;
  !ok ? tuning_set_edo(tuning_divisions, tuning_period_cents);
  tuning_ok = ok;
);

function tuning_note_cents(note) local(steps, period, degree) (
  steps = note - tuning_rnote;
  period = floor(steps / tuning_size);
  degree = steps - period * tuning_size;
  period * tuning_period + tuning_table[degree];
);

function tuning_note_to_hz(note) local(base, frac, c) (
  base = floor(note);
  frac = note - base;
  c = tuning_note_cents(base);
  frac > 0 ? c += frac * (tuning_note_cents(base + 1) - c);
  tuning_rhz * pow(2, c / 1200);
);

// ---------------------------------------------------------------------------
// Oscillator (PolyBLEP). waveform 0 saw, 1 pulse, 2 triangle, 3 sine; pm in cycles.

function osc_reset(p) instance(phase wrapped) ( phase = p; wrapped = 0; );

function osc_set_freq(hz) instance(inc) ( inc = clamp(hz / srate, 0, 0.49); );

function poly_blep(t, dt) (
  t < dt ? (
    t /= dt;
    t + t - t * t - 1;
  ) : t > 1 - dt ? (
    t = (t - 1) / dt;
    t * t + t + t + 1;
  ) : 0;
);

function osc_process(waveform, pw, pm) instance(phase inc wrapped) local(t, t2, y) (
  t = phase + pm;
  t -= floor(t);
  waveform < 0.5 ? (
    y = 2 * t - 1 - poly_blep(t, inc);
  ) : waveform < 1.5 ? (
    t2 = t - pw;
    t2 < 0 ? t2 += 1;
    y = (t < pw ? 1 : -1) + poly_blep(t, inc) - poly_blep(t2, inc) - (2 * pw - 1);
  ) : waveform < 2.5 ? (
    y = 1 - 4 * abs(t - 0.5);
  ) : (
    y = sin(2 * $pi * t);
  );
  phase += inc;
  wrapped = 0;
  phase >= 1 ? (
    phase -= 1;
    wrapped = 1;
  );
  y;
);

/** hard sync: restart at the master's sub-sample wrap position */
function osc_sync(master_phase, master_inc) instance(phase inc) (
  phase = master_inc > 0 ? (master_phase / master_inc) * inc : 0;
);

function sine_process() instance(phase inc) local(y) (
  y = sin(2 * $pi * phase);
  phase += inc;
  phase >= 1 ? phase -= 1;
  y;
);

function square_naive_process() instance(phase inc) local(y) (
  y = phase < 0.5 ? 1 : -1;
  phase += inc;
  phase >= 1 ? phase -= 1;
  y;
);

// ---------------------------------------------------------------------------
// LFO: 0 sine, 1 triangle, 2 saw down, 3 square, 4 sample & hold, 5 duck (sidechain-style pump:
// falls from +1 to -1 in the first 3 % of the cycle, then recovers along a curve)

function lfo_wave(waveform, t, held) local(u, u2) (
  waveform < 0.5 ? sin(2 * $pi * t)
  : waveform < 1.5 ? 1 - 4 * abs(t - 0.5)
  : waveform < 2.5 ? 1 - 2 * t
  : waveform < 3.5 ? (t < 0.5 ? 1 : -1)
  : waveform < 4.5 ? held
  : t < 0.03 ? 1 - t * 66.66666666666667
  : (
    u = (1 - t) * 1.0309278350515465; // 1 / 0.97
    u2 = u * u;
    1 - 2 * u2 * u2;
  );
);

/** free running: value at the current phase, then advance by inc */
function lfo_process(waveform) instance(phase inc held) local(y) (
  y = lfo_wave(waveform, phase, held);
  phase += inc;
  phase >= 1 ? (
    phase -= 1;
    held = noise_white();
  );
  y;
);

/** tempo synced: the phase comes from the host beat position; new S&H value at each wrap */
function lfo_process_at(waveform, ph) instance(phase held) (
  ph < phase ? held = noise_white();
  phase = ph;
  lfo_wave(waveform, ph, held);
);

// ---------------------------------------------------------------------------
// State variable filter (TPT). Outputs in lp / bp / hp after svf_process().

function svf_set(cutoff_hz, kk) instance(g k a1 a2 a3) local(fc) (
  fc = clamp(cutoff_hz, 5, srate * 0.49);
  g = tan(($pi * fc) / srate);
  k = kk;
  a1 = 1 / (1 + g * (g + kk));
  a2 = g * a1;
  a3 = g * a2;
);

function svf_process(x) instance(ic1 ic2 k a1 a2 a3 lp bp hp) local(v1, v2, v3) (
  v3 = x - ic2;
  v1 = a1 * ic1 + a2 * v3;
  v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1;
  ic2 = 2 * v2 - ic2;
  lp = v2;
  bp = v1;
  hp = x - k * v1 - v2;
  v2;
);

/** copy coefficients from another svf (pass its g k a1 a2 a3) */
function svf_copy(gg, kk, aa1, aa2, aa3) instance(g k a1 a2 a3) (
  g = gg; k = kk; a1 = aa1; a2 = aa2; a3 = aa3;
);

/** 0 low-pass, 1 high-pass, 2 band-pass, 3 notch */
function svf_output(mode) instance(lp bp hp) (
  mode < 0.5 ? lp : mode < 1.5 ? hp : mode < 2.5 ? bp : lp + hp;
);

function svf_reset() instance(ic1 ic2) ( ic1 = 0; ic2 = 0; );

// ---------------------------------------------------------------------------
// One-pole filters / smoother

function onepole_set(cutoff_hz) instance(a) (
  a = 1 - exp((-2 * $pi * clamp(cutoff_hz, 1, srate * 0.49)) / srate);
);
function onepole_lp(x) instance(z a) ( z += a * (x - z); z; );
function onepole_hp(x) instance(z a) ( z += a * (x - z); x - z; );

function smoother_init(value) instance(z) ( z = value; );
function smoother_set(ms) instance(c) ( c = tau_coef(ms); );
function smoother_process(target) instance(z c) ( z = target + c * (z - target); z; );

// ---------------------------------------------------------------------------
// ADSR (stage 0 idle, 1 attack, 2 decay/sustain, 3 release)

function adsr_set(attack_ms, decay_ms, sus, release_ms) instance(attack_inc decay_coef release_coef sustain) (
  attack_inc = 1 / (max(attack_ms, 0.01) * 0.001 * srate);
  decay_coef = t60_coef(decay_ms);
  release_coef = t60_coef(release_ms);
  sustain = sus;
);

function adsr_gate_on() instance(stage) ( stage = 1; );
function adsr_gate_off() instance(stage) ( stage !== 0 ? stage = 3; );

function adsr_process() instance(stage value attack_inc decay_coef release_coef sustain) (
  stage === 1 ? (
    value += attack_inc;
    value >= 1 ? (
      value = 1;
      stage = 2;
    );
  ) : stage === 2 ? (
    value = sustain + decay_coef * (value - sustain);
  ) : stage === 3 ? (
    value *= release_coef;
    value < 0.00001 ? (
      value = 0;
      stage = 0;
    );
  );
  value;
);

// ---------------------------------------------------------------------------
// One-shot exponential decay envelope

function decay_env_trigger(level, ms) instance(value coef) ( value = level; coef = t60_coef(ms); );
function decay_env_process() instance(value coef) local(v) (
  v = value;
  value *= coef;
  value < 0.000001 ? value = 0;
  v;
);

// ---------------------------------------------------------------------------
// Fractional delay line in a memory block

function delay_init(n) instance(base size w) ( base = mem_alloc(n); size = n; w = 0; memset(base, 0, n); );
function delay_clear() instance(base size w) ( memset(base, 0, size); w = 0; );
function delay_write(x) instance(base size w) (
  base[w] = x;
  w += 1;
  w >= size ? w = 0;
);
function delay_read(d) instance(base size w) local(pos, i0, frac, i1) (
  pos = w - d;
  while (pos < 0) ( pos += size; );
  i0 = floor(pos);
  frac = pos - i0;
  i1 = i0 + 1 >= size ? 0 : i0 + 1;
  base[i0] + frac * (base[i1] - base[i0]);
);

// ---------------------------------------------------------------------------
// Two-pole resonator (unit impulse -> sine of amplitude `gain`)

function reson_set(hz, t60_ms, gain) instance(a1 a2 b0) local(w, r) (
  hz <= 0 || hz >= srate * 0.45 ? (
    a1 = 0; a2 = 0; b0 = 0;
  ) : (
    w = (2 * $pi * hz) / srate;
    r = t60_coef(t60_ms);
    a1 = 2 * r * cos(w);
    a2 = r * r;
    b0 = sin(w) * gain;
  );
);

function reson_set_decay(hz, t60_ms) instance(a1 a2 b0) local(w, r) (
  b0 !== 0 ? (
    w = (2 * $pi * hz) / srate;
    r = t60_coef(t60_ms);
    a1 = 2 * r * cos(w);
    a2 = r * r;
  );
);

function reson_process(x) instance(y1 y2 a1 a2 b0 amp) local(y, a) (
  y = a1 * y1 - a2 * y2 + b0 * x;
  y2 = y1;
  y1 = y;
  a = abs(y);
  amp = a > amp ? a : amp * 0.9995;
  y;
);

function reson_reset() instance(y1 y2 amp) ( y1 = 0; y2 = 0; amp = 0; );

// Same resonator stored in a memory block (6 slots: y1 y2 a1 a2 b0 amp) so a voice can
// loop over its modes (EEL2 namespaces cannot be indexed).
function rmem_set(p, hz, t60_ms, gain) local(w, r) (
  hz <= 0 || hz >= srate * 0.45 ? (
    p[2] = 0; p[3] = 0; p[4] = 0;
  ) : (
    w = (2 * $pi * hz) / srate;
    r = t60_coef(t60_ms);
    p[2] = 2 * r * cos(w);
    p[3] = r * r;
    p[4] = sin(w) * gain;
  );
);

function rmem_set_decay(p, hz, t60_ms) local(w, r) (
  p[4] !== 0 ? (
    w = (2 * $pi * hz) / srate;
    r = t60_coef(t60_ms);
    p[2] = 2 * r * cos(w);
    p[3] = r * r;
  );
);

function rmem_process(p, x) local(y, a) (
  y = p[2] * p[0] - p[3] * p[1] + p[4] * x;
  p[1] = p[0];
  p[0] = y;
  a = abs(y);
  p[5] = a > p[5] ? a : p[5] * 0.9995;
  y;
);

function rmem_reset(p) ( p[0] = 0; p[1] = 0; p[5] = 0; );

// ---------------------------------------------------------------------------
// First-order all-pass  y = a*x + x1 - a*y1  (phase delay (1-a)/(1+a) at DC)

function ap1_init() instance(x1 y1) ( x1 = 0; y1 = 0; );
function ap1_process(x, a) instance(x1 y1) local(y) (
  y = a * x + x1 - a * y1;
  x1 = x;
  y1 = y;
  y;
);

/** phase delay in samples of the all-pass at normalised angular frequency w (0 < w < pi) */
function ap1_phase_delay(a, w) local(ph) (
  ph = atan2(-sin(w), a + cos(w)) - atan2(-a * sin(w), 1 + a * cos(w));
  -ph / w;
);

/** phase delay in samples of the one-pole low-pass y = (1-b)x + b*y1 at w */
function lp1_phase_delay(b, w) ( atan2(b * sin(w), 1 - b * cos(w)) / w; );

// ---------------------------------------------------------------------------
// Sample-accurate MIDI: @block stores events, @sample pops them at their offset.
//   @block:  midi_queue_read();   @sample: while (midi_pop()) ( handle midi_m1/m2/m3 );  midi_tick();
midi_q = mem_alloc(4 * 1024);
midi_count = 0;
midi_pos = 0;
midi_frame = 0;

function midi_queue_read() local(ofs, m1, m2, m3) (
  midi_count = 0;
  midi_pos = 0;
  midi_frame = 0;
  while (midirecv(ofs, m1, m2, m3)) (
    midi_count < 1024 ? (
      midi_q[midi_count * 4] = ofs;
      midi_q[midi_count * 4 + 1] = m1;
      midi_q[midi_count * 4 + 2] = m2;
      midi_q[midi_count * 4 + 3] = m3;
      midi_count += 1;
    );
    midisend(ofs, m1, m2, m3); // pass through for chaining
  );
);

/** 1 when an event is due at the current sample (fills midi_m1/m2/m3) */
function midi_pop() (
  midi_pos < midi_count && midi_q[midi_pos * 4] <= midi_frame ? (
    midi_m1 = midi_q[midi_pos * 4 + 1];
    midi_m2 = midi_q[midi_pos * 4 + 2];
    midi_m3 = midi_q[midi_pos * 4 + 3];
    midi_pos += 1;
    1;
  ) : 0;
);

function midi_tick() ( midi_frame += 1; );
