import amisynth_lib.jsfx-inc
import amisynth_meter.jsfx-inc

in_pin:none
out_pin:Left
out_pin:Right

@init
meter.meter_init();
voice_steals = 0;
MAX_VOICES = 8;
MAX_UNISON = 9;
MAX_HELD = 16;
noise_seed(12345);

v_active = mem_alloc(MAX_VOICES);
v_note = mem_alloc(MAX_VOICES); // key the voice answers to (note-off matching)
v_pitch = mem_alloc(MAX_VOICES); // note number it sounds at (key + transpose)
v_gate = mem_alloc(MAX_VOICES);
v_sus = mem_alloc(MAX_VOICES);
v_age = mem_alloc(MAX_VOICES);
un_ratio = mem_alloc(MAX_UNISON);
un_gl = mem_alloc(MAX_UNISON);
un_gr = mem_alloc(MAX_UNISON);
un_w = mem_alloc(MAX_UNISON);
// mono / legato note stack (last note priority)
stack_key = mem_alloc(MAX_HELD);
stack_pitch = mem_alloc(MAX_HELD);
stack_vel = mem_alloc(MAX_HELD);
stack_n = 0;
// arpeggiator: held keys (in the order played), notes it is sounding, work arrays
arp_key = mem_alloc(MAX_HELD);
arp_vel = mem_alloc(MAX_HELD);
arp_snd = mem_alloc(MAX_HELD);
arp_ordk = mem_alloc(MAX_HELD);
arp_ordv = mem_alloc(MAX_HELD);
arp_newk = mem_alloc(MAX_HELD);
arp_newv = mem_alloc(MAX_HELD);
arp_pat = mem_alloc(16);
arp_n = 0;
arp_snd_n = 0;
arp_last = 0;
arp_off_pos = 0;
arp_idx = 0;
arp_cur_mode = 0;

// note values in beats (same tables as LFO_SYNC_BEATS / ARP_RATE_BEATS in params.js)
lfo_sync_tab = mem_alloc(17);
lfo_sync_tab[0] = 0; lfo_sync_tab[1] = 16; lfo_sync_tab[2] = 8; lfo_sync_tab[3] = 4; lfo_sync_tab[4] = 2;
lfo_sync_tab[5] = 3; lfo_sync_tab[6] = 4 / 3; lfo_sync_tab[7] = 1; lfo_sync_tab[8] = 1.5; lfo_sync_tab[9] = 2 / 3;
lfo_sync_tab[10] = 0.5; lfo_sync_tab[11] = 0.75; lfo_sync_tab[12] = 1 / 3; lfo_sync_tab[13] = 0.25;
lfo_sync_tab[14] = 0.375; lfo_sync_tab[15] = 1 / 6; lfo_sync_tab[16] = 0.125;
arp_rate_tab = mem_alloc(7);
arp_rate_tab[0] = 1; arp_rate_tab[1] = 0.5; arp_rate_tab[2] = 1 / 3; arp_rate_tab[3] = 0.75;
arp_rate_tab[4] = 0.25; arp_rate_tab[5] = 1 / 6; arp_rate_tab[6] = 0.125;

age_counter = 0;
bend = 0;
modwheel = 0;
sustain_pedal = 0;
last_hz = 0;
cutoff_smooth.smoother_init(1000);
cutoff_smooth.smoother_set(15);
gain_smooth.smoother_init(0);
gain_smooth.smoother_set(20);
// cutoff CC (value 64 = centre)
cc_cutoff_value = 64;
cc_mult = 1;
// clock of the chip / S&H noise in multiples of the note frequency (same as NOISE_CLOCK in synth.js)
noise_clock_tab = mem_alloc(4);
noise_clock_tab[0] = 0; noise_clock_tab[1] = 32; noise_clock_tab[2] = 93; noise_clock_tab[3] = 8;
sfx_claps = mem_alloc(MAX_VOICES * 36); // eighteen independent timer / envelope pairs per voice
sfx_drops = mem_alloc(MAX_VOICES * 24); // droplet timer / envelope / phase / frequency
// host transport: beats (quarter notes), advanced every sample, resynced in @block while playing
beat = 0;
beat_inc = 120 / 60 / srate;
host_tempo = 120;

// ---- effects after the voice sum: chorus -> delay -> reverb. All delay memory is allocated
// here, once (the echo holds DELAY_MAX_SECONDS = 4 s).
fxc.chorus_init();
echo_size = ceil(4 * srate) + 4;
fxd.echo_init(echo_size);
fxr.reverb_init();
fx_chorus_i = fx_delay_i = fx_reverb_i = 0;
delay_d = 1; // smoothed echo time in samples
delay_target = 1;
delay_sync_beats = 0;
delay_coef = tau_coef(60);
// note values in beats (same table as DELAY_SYNC_BEATS in params.js)
delay_sync_tab = mem_alloc(15);
delay_sync_tab[0] = 0; delay_sync_tab[1] = 4; delay_sync_tab[2] = 2; delay_sync_tab[3] = 3; delay_sync_tab[4] = 4 / 3;
delay_sync_tab[5] = 1; delay_sync_tab[6] = 1.5; delay_sync_tab[7] = 2 / 3; delay_sync_tab[8] = 0.5; delay_sync_tab[9] = 0.75;
delay_sync_tab[10] = 1 / 3; delay_sync_tab[11] = 0.25; delay_sync_tab[12] = 0.375; delay_sync_tab[13] = 1 / 6;
delay_sync_tab[14] = 0.125;

/** echo time in samples: a note value at the host tempo, or Delay Time in ms */
function delay_retime() local(n) (
  n = delay_sync_beats > 0 ? (delay_sync_beats * 60 * srate) / host_tempo : fx_delay_time_ms * 0.001 * srate;
  delay_target = clamp(n, 1, echo_size - 2);
);

// ---- mod matrix (see synth.js): sources 1 LFO1, 2 LFO2, 3 mod env, 4 velocity, 5 key track,
// 6 mod wheel, 7 pressure, 8 random per note; destinations 1 pitch, 2 cutoff, 3 resonance, 4 PW,
// 5 osc2 pitch, 6 FM index, 7 amp, 8 pan, 9 LFO1 rate, 10 LFO2 rate, 11 noise level
MOD_SLOTS = 4;
N_SRC = 9;
N_DST = 12;
mm_src = mem_alloc(MOD_SLOTS); // the active slots, packed
mm_dst = mem_alloc(MOD_SLOTS);
mm_amt = mem_alloc(MOD_SLOTS);
mm_use = mem_alloc(N_SRC); // sources in use
mm_has = mem_alloc(N_DST); // destinations in use
mm_g = mem_alloc(N_DST); // per-sample sums of the global sources
mm_v = mem_alloc(N_DST); // per-voice totals
mm_n = 0;
mod_rnd = 777; // own random generator (LFO2 S&H, random per note), separate from noise_white
pressure = 0; // channel pressure 0..1
press_g = 0; // smoothed, for the global destinations
press_a = 1 - tau_coef(10);

function mod_random() (
  mod_rnd *= 16807;
  mod_rnd -= floor(mod_rnd / 2147483647) * 2147483647;
  mod_rnd / 1073741823.5 - 1;
);

/** LFO 2: like lfo_process / lfo_process_at, but its sample & hold draws from mod_random */
function lfo2_tick(waveform) instance(phase inc held) local(ph, y) (
  lfo2_sync_beats > 0 ? (
    ph = beat / lfo2_sync_beats;
    ph -= floor(ph);
    ph < phase ? held = mod_random();
    phase = ph;
    lfo_wave(waveform, ph, held);
  ) : (
    y = lfo_wave(waveform, phase, held);
    phase += inc;
    phase >= 1 ? (
      phase -= 1;
      held = mod_random();
    );
    y;
  );
);

/** keep a mod matrix slot if it does something */
function mm_slot(src, dst, amt) local(si, di) (
  si = clamp(floor(src + 0.5), 0, N_SRC - 1);
  di = clamp(floor(dst + 0.5), 0, N_DST - 1);
  si > 0 && di > 0 && amt !== 0 ? (
    mm_src[mm_n] = si;
    mm_dst[mm_n] = di;
    mm_amt[mm_n] = amt;
    mm_use[si] = 1;
    mm_has[di] = 1;
    mm_n += 1;
  );
);

// ---- wavetable oscillator (port of src/dsp/wavetable.js; same formulas, loops and table layout)
//
// JSFX local memory layout (slot = one double):
//   0 .. 1023                   unused (mem_alloc starts at 1024)
//   1024 .. mem_top-1           mem_alloc heap: tuning tables, MIDI queue, voice / arp / unison arrays
//                               (about 5.7k slots + the effects' delay lines: the echo alone takes
//                               2 x (4 s x srate) slots, about 1.54M at 192 kHz)
//   WT_BASE = 4194304 (2^22)    wavetables: WT_BANKS x WT_FRAMES x WT_MIPS x WT_SIZE = 5 x 8 x 10 x 2048
//                               = 819200 slots; table(bank, frame, mip) at
//                               WT_BASE + ((bank * WT_FRAMES + frame) * WT_MIPS + mip) * WT_SIZE
//   WT_SCRATCH = 5013504        FFT work re / im (2 x 2048), twiddles cos / sin (2 x 1024), spectrum
//                               a / b (2 x 513), vowel formants (15), Digital multipliers (8),
//                               per-bank ready flags (5)
//   WT_END = 5020702            first slot after the region (< 8388608 = default JSFX memory, __memtop())
// The fixed region is far above the heap and nothing else writes there. wt_ok checks once (here,
// after the last mem_alloc of @init) that the heap stays below WT_BASE and the region fits in memory;
// otherwise the wavetable oscillator is silent (and the JSFX comparison test fails) instead of
// reading or overwriting other buffers.
// Banks are built in @slider the first time an oscillator selects them. A bank's ready flag lives
// in the region itself, so if REAPER clears the memory the bank is simply built again.
WT_SIZE = 2048;
WT_FRAMES = 8;
WT_MIPS = 10;
WT_MAX_HARM = 512;
WT_FADE = 0.7071067811865476; // mip crossfade starts 1/2 octave below each level's boundary
WT_BANKS = 5;
WT_FRAME_LEN = WT_MIPS * WT_SIZE;
WT_BANK_LEN = WT_FRAMES * WT_FRAME_LEN;
WT_BASE = 4194304;
WT_SCRATCH = WT_BASE + WT_BANKS * WT_BANK_LEN;
wt_re = WT_SCRATCH;
wt_im = wt_re + WT_SIZE;
wt_twc = wt_im + WT_SIZE;
wt_tws = wt_twc + WT_SIZE / 2;
wt_sa = wt_tws + WT_SIZE / 2;
wt_sb = wt_sa + WT_MAX_HARM + 1;
wt_vow = wt_sb + WT_MAX_HARM + 1;
wt_dmul = wt_vow + 15;
wt_ready = wt_dmul + 8;
WT_END = wt_ready + WT_BANKS;
WT_MAGIC = 20261014.5;
wt_ok = mem_top <= WT_BASE && WT_END <= __memtop();

// vowel formants (Hz) a, e, i, o, u; multipliers of the Digital bank (same as VOWELS / DIGITAL_MUL)
wt_vow[0] = 730; wt_vow[1] = 1090; wt_vow[2] = 2440;
wt_vow[3] = 530; wt_vow[4] = 1840; wt_vow[5] = 2480;
wt_vow[6] = 270; wt_vow[7] = 2290; wt_vow[8] = 3010;
wt_vow[9] = 570; wt_vow[10] = 840; wt_vow[11] = 2410;
wt_vow[12] = 300; wt_vow[13] = 870; wt_vow[14] = 2240;
wt_dmul[0] = 0; wt_dmul[1] = 2; wt_dmul[2] = 3; wt_dmul[3] = 4;
wt_dmul[4] = 5; wt_dmul[5] = 7; wt_dmul[6] = 9; wt_dmul[7] = 13;

/** in-place radix-2 FFT of wt_re / wt_im; sign +1 inverse (unscaled), -1 forward */
function wt_fft(sign) local(n, i, j, m, t, len, half, step, k, wr, wi, a, b, tr, ti) (
  n = WT_SIZE;
  j = 0;
  i = 0;
  loop(n - 1,
    i < j ? (
      t = wt_re[i]; wt_re[i] = wt_re[j]; wt_re[j] = t;
      t = wt_im[i]; wt_im[i] = wt_im[j]; wt_im[j] = t;
    );
    m = n / 2;
    while (m >= 1 && j >= m) ( j -= m; m /= 2; );
    j += m;
    i += 1;
  );
  len = 2;
  while (len <= n) (
    half = len / 2;
    step = n / len;
    i = 0;
    while (i < n) (
      k = 0;
      loop(half,
        wr = wt_twc[k * step];
        wi = sign * wt_tws[k * step];
        a = i + k;
        b = a + half;
        tr = wt_re[b] * wr - wt_im[b] * wi;
        ti = wt_re[b] * wi + wt_im[b] * wr;
        wt_re[b] = wt_re[a] - tr;
        wt_im[b] = wt_im[a] - ti;
        wt_re[a] += tr;
        wt_im[a] += ti;
        k += 1;
      );
      i += len;
    );
    len *= 2;
  );
);

/** sine coefficient of harmonic k of the Basic Shapes anchors: 0 sine, 1 triangle, 2 saw, 3 square */
function wt_basic(shape, k) local(odd, h) (
  odd = k - 2 * floor(k / 2);
  shape === 0 ? (k === 1 ? 1 : 0)
  : shape === 1 ? (
    odd ? (
      h = (k - 1) / 2;
      ((h - 2 * floor(h / 2) ? -8 : 8) / ($pi * $pi)) / (k * k);
    ) : 0;
  ) : shape === 2 ? (odd ? 2 : -2) / ($pi * k)
  : odd ? 4 / ($pi * k) : 0;
);

/** spectrum of a frame of the analytic banks 0..3 into wt_sa (sine) / wt_sb (cosine) */
function wt_spectrum(bank, frame) local(x, p, seg, w, k, duty, g, hz, i, f, d, amp, ph, centre) (
  x = frame / (WT_FRAMES - 1);
  wt_sa[0] = 0;
  wt_sb[0] = 0;
  k = 1;
  bank === 0 ? (
    p = x * 3;
    seg = min(floor(p), 2);
    w = p - seg;
    loop(WT_MAX_HARM,
      wt_sa[k] = (1 - w) * wt_basic(seg, k) + w * wt_basic(seg + 1, k);
      wt_sb[k] = 0;
      k += 1;
    );
  ) : bank === 1 ? (
    duty = 0.5 - 0.45 * x;
    loop(WT_MAX_HARM,
      g = 2 / ($pi * k);
      wt_sa[k] = g * (1 - cos(2 * $pi * k * duty));
      wt_sb[k] = g * sin(2 * $pi * k * duty);
      k += 1;
    );
  ) : bank === 2 ? (
    p = x * 4;
    seg = min(floor(p), 3);
    w = p - seg;
    loop(WT_MAX_HARM,
      hz = k * 110;
      g = 0.03;
      i = 0;
      loop(3,
        f = wt_vow[seg * 3 + i] + w * (wt_vow[seg * 3 + 3 + i] - wt_vow[seg * 3 + i]);
        d = (hz - f) / (i === 0 ? 80 : i === 1 ? 100 : 140);
        g += (i === 0 ? 1 : i === 1 ? 0.6 : 0.3) / (1 + d * d);
        i += 1;
      );
      amp = g / pow(k, 0.7);
      ph = ($pi * k * (k - 1)) / 48;
      wt_sa[k] = amp * cos(ph);
      wt_sb[k] = amp * sin(ph);
      k += 1;
    );
  ) : (
    centre = 5 * x;
    loop(WT_MAX_HARM,
      d = log(k) / log(2) - centre;
      amp = (k === 1 ? 0.5 : 0) + exp(-2 * d * d) / sqrt(k);
      ph = ($pi * k * (k - 1)) / 48;
      wt_sa[k] = amp * cos(ph);
      wt_sb[k] = amp * sin(ph);
      k += 1;
    );
  );
);

/** Digital bank: 8-bit integer waveform v = u XOR (u * mul mod 256), spectrum by forward FFT */
function wt_digital_spectrum(frame) local(mul, n, u, um, k) (
  mul = wt_dmul[frame];
  n = 0;
  loop(WT_SIZE,
    u = floor(n / 8);
    um = u * mul - 256 * floor((u * mul) / 256);
    wt_re[n] = ((u ~ um) / 127.5) - 1;
    wt_im[n] = 0;
    n += 1;
  );
  wt_fft(-1);
  wt_sa[0] = 0;
  wt_sb[0] = 0;
  k = 1;
  loop(WT_MAX_HARM,
    wt_sb[k] = (2 * wt_re[k]) / WT_SIZE;
    wt_sa[k] = (-2 * wt_im[k]) / WT_SIZE;
    k += 1;
  );
);

/** the current spectrum truncated to harm harmonics -> table at dst, times gain */
function wt_render_table(dst, harm, gain) local(i, k) (
  memset(wt_re, 0, WT_SIZE);
  memset(wt_im, 0, WT_SIZE);
  k = 1;
  loop(harm,
    wt_re[k] = wt_sb[k];
    wt_im[k] = -wt_sa[k];
    k += 1;
  );
  wt_fft(1);
  i = 0;
  loop(WT_SIZE, dst[i] = wt_re[i] * gain; i += 1;);
);

/** build every frame and mip level of a bank (no-op when already built) */
function wt_build(bank) local(i, f, base, peak, a, gain, harm, m) (
  wt_ok && wt_ready[bank] !== WT_MAGIC ? (
    i = 0;
    loop(WT_SIZE / 2,
      wt_twc[i] = cos((2 * $pi * i) / WT_SIZE);
      wt_tws[i] = sin((2 * $pi * i) / WT_SIZE);
      i += 1;
    );
    f = 0;
    loop(WT_FRAMES,
      bank === 4 ? wt_digital_spectrum(f) : wt_spectrum(bank, f);
      base = WT_BASE + bank * WT_BANK_LEN + f * WT_FRAME_LEN;
      // mip 0 first: its peak sets the gain of the whole frame
      wt_render_table(base, WT_MAX_HARM, 1);
      peak = 0;
      i = 0;
      loop(WT_SIZE, a = abs(base[i]); a > peak ? peak = a; i += 1;);
      gain = peak > 0 ? 1 / peak : 0;
      i = 0;
      loop(WT_SIZE, base[i] *= gain; i += 1;);
      harm = WT_MAX_HARM;
      m = 1;
      loop(WT_MIPS - 1,
        harm /= 2;
        wt_render_table(base + m * WT_SIZE, harm, gain);
        m += 1;
      );
      f += 1;
    );
    wt_ready[bank] = WT_MAGIC;
  );
);

/** one sample of a wavetable oscillator (same phase / inc / wrapped state as osc_process) */
function wt_process(bank, pos, pm) instance(phase inc wrapped) local(t, m, th, lo, w, fp, f0, ff, x, i0, fr, i1, b0, b1, a, b, c0, c1, a2, b2) (
  t = phase + pm;
  t -= floor(t);
  // lowest mip level whose top harmonic (WT_MAX_HARM / 2^m) * inc stays at or below 0.5
  m = 0;
  th = 0.5 / WT_MAX_HARM;
  while (inc > th && m < WT_MIPS - 1) ( th *= 2; m += 1; );
  // weight of level m + 1 (fewer harmonics, band-safe): 0 below WT_FADE * th, linear in inc up to
  // exactly 1 at the boundary th, so crossing a level never makes the waveform jump; last level: none
  lo = th * WT_FADE;
  w = m < WT_MIPS - 1 && inc > lo ? (inc - lo) / (th - lo) : 0;
  fp = pos * (WT_FRAMES - 1);
  f0 = floor(fp);
  f0 > WT_FRAMES - 2 ? f0 = WT_FRAMES - 2;
  ff = fp - f0;
  x = t * WT_SIZE;
  i0 = floor(x);
  fr = x - i0;
  i1 = i0 + 1 >= WT_SIZE ? 0 : i0 + 1;
  b0 = WT_BASE + bank * WT_BANK_LEN + f0 * WT_FRAME_LEN + m * WT_SIZE;
  b1 = b0 + WT_FRAME_LEN;
  a = b0[i0] + fr * (b0[i1] - b0[i0]);
  b = b1[i0] + fr * (b1[i1] - b1[i0]);
  w > 0 ? (
    c0 = b0 + WT_SIZE;
    c1 = b1 + WT_SIZE;
    a2 = c0[i0] + fr * (c0[i1] - c0[i0]);
    b2 = c1[i0] + fr * (c1[i1] - c1[i0]);
    a += w * (a2 - a);
    b += w * (b2 - b);
  );
  phase += inc;
  wrapped = 0;
  phase >= 1 ? (
    phase -= 1;
    wrapped = 1;
  );
  wt_ok ? a + ff * (b - a) : 0;
);

// ---- one unison copy: osc1 + osc2 (osc2 can sync to osc1 and FM it)
function ucopy_reset(r1, r2) instance(prev2) (
  this.o1.osc_reset(r1);
  this.o2.osc_reset(r2);
  prev2 = 0;
);

function ucopy_process(f, r2, w1, w2, pw1, pw2, fm, sync, l1, l2) instance(prev2) local(y1, y2) (
  this.o1.osc_set_freq(f);
  this.o2.osc_set_freq(f * r2);
  // FM uses osc2's previous sample so sync (osc1 -> osc2) and FM (osc2 -> osc1) can coexist
  // wavetable oscillators read the per-voice positions g_wpos1 / g_wpos2 (set in voice_render)
  y1 = wt_osc1 ? this.o1.wt_process(wt_bank1_i, g_wpos1, fm * prev2) : this.o1.osc_process(w1, pw1, fm * prev2);
  sync && this.o1.wrapped ? this.o2.osc_sync(this.o1.phase, this.o1.inc);
  y2 = wt_osc2 ? this.o2.wt_process(wt_bank2_i, g_wpos2, 0) : this.o2.osc_process(w2, pw2, 0);
  prev2 = y2;
  y1 * l1 + y2 * l2;
);

// ---- voice (namespace v0..v7)
function sound_fx_random() instance(rnd) (
  rnd *= 16807;
  rnd -= floor(rnd / 2147483647) * 2147483647;
  rnd / 2147483647;
);

function sound_fx_reset(vid, vel) instance(time phase lp1 lp2 env rnd claps drops) local(i) (
  time = 0; phase = 0; lp1 = 0; lp2 = 0; env = 0;
  rnd = 901 + (v_age[vid] % 997) * 37 + floor(vel * 127 + 0.5) * 17;
  claps = sfx_claps + vid * 36;
  drops = sfx_drops + vid * 24;
  i = 0;
  loop(18,
    claps[2 * i] = (0.002 + 0.013 * i) * srate / sfx_rate;
    claps[2 * i + 1] = 0;
    i += 1;
  );
  i = 0;
  loop(6,
    drops[4 * i] = (0.001 + 0.011 * i) * srate / sfx_rate;
    drops[4 * i + 1] = 0;
    drops[4 * i + 2] = 0;
    drops[4 * i + 3] = 0;
    i += 1;
  );
);

function sound_fx_noise() instance(time phase lp1 lp2 env rnd claps drops)
  local(nz, ph, blade, y, sumenv, i, o, t, crack, reflection, strength, dropsum) (
  nz = noise_white();
  lp1 += sfx_a1 * (nz - lp1);
  lp2 += sfx_a2 * (nz - lp2);
  noise_type_i === 4 ? (
    ph = phase;
    phase += 11 * sfx_rate / srate;
    phase >= 1 ? phase -= 1;
    blade = exp(-18 * ph);
    y = 3 * (lp1 * (0.12 + 0.88 * blade) + lp2 * 0.12 * blade
      + 0.22 * sin(2 * $pi * 4 * ph) * exp(-10 * ph));
  ) : noise_type_i === 5 ? (
    sumenv = 0; i = 0;
    loop(18,
      o = 2 * i;
      claps[o] -= 1;
      claps[o] <= 0 ? (
        claps[o] = (0.12 + 0.36 * this.sound_fx_random()) * srate / sfx_rate;
        claps[o + 1] = 0.4 + 0.6 * this.sound_fx_random();
      );
      claps[o + 1] *= sfx_clap_decay;
      sumenv += claps[o + 1];
      i += 1;
    );
    env += sfx_clap_attack * (sumenv - env);
    y = 1.8 * (lp1 - lp2) * env;
  ) : noise_type_i === 7 ? (
    dropsum = 0; i = 0;
    loop(6,
      o = 4 * i;
      drops[o] -= 1;
      drops[o] <= 0 ? (
        drops[o] = (0.015 + 0.16 * this.sound_fx_random()) * srate / sfx_rate;
        strength = this.sound_fx_random();
        drops[o + 1] = 0.15 + 0.85 * strength * strength;
        drops[o + 2] = 0;
        drops[o + 3] = (1200 + 3300 * this.sound_fx_random()) / srate;
      );
      drops[o + 1] *= sfx_drop_decay;
      drops[o + 2] += drops[o + 3];
      drops[o + 2] >= 1 ? drops[o + 2] -= 1;
      dropsum += (0.6 * sin(2 * $pi * drops[o + 2]) + 0.4 * nz) * drops[o + 1];
      i += 1;
    );
    y = 0.45 * (lp1 - lp2) + 0.35 * dropsum;
  ) : (
    t = time;
    time += sfx_rate / srate;
    crack = nz - lp1;
    reflection = t >= 0.007 ? exp(-(t - 0.007) / 0.004) : 0;
    y = 6 * (crack * (exp(-t / 0.0015) + 0.18 * reflection)
      + 0.35 * (lp1 - lp2) * exp(-t / 0.018));
  );
  y;
);

// op: 0 set index, 1 reset (fresh voice), 2 gate off, 3 envelopes, 4 retune,
//     5 set pitch (a = hz, b = glide_oct), 6 trigger (a = velocity 1..127), 7 get glide_oct, 8 get base_hz,
//     9 set polyphonic aftertouch (a = 0..1)
function voice_op(op, a, b, c, d) instance(idx velocity base_hz glide_oct rnd poly_at) local(spread, r1, r2) (
  op === 0 ? (
    idx = a;
    this.sfx.claps = sfx_claps + idx * 36;
    this.sfx.drops = sfx_drops + idx * 24;
  ) : op === 1 ? (
    spread = unison_n > 1;
    // same random call order as the JS code: per copy osc1 (if spread) then osc2
    r1 = spread ? random_unit() : 0; r2 = random_unit(); this.u0.ucopy_reset(r1, r2);
    r1 = spread ? random_unit() : 0; r2 = random_unit(); this.u1.ucopy_reset(r1, r2);
    r1 = spread ? random_unit() : 0; r2 = random_unit(); this.u2.ucopy_reset(r1, r2);
    r1 = spread ? random_unit() : 0; r2 = random_unit(); this.u3.ucopy_reset(r1, r2);
    r1 = spread ? random_unit() : 0; r2 = random_unit(); this.u4.ucopy_reset(r1, r2);
    r1 = spread ? random_unit() : 0; r2 = random_unit(); this.u5.ucopy_reset(r1, r2);
    r1 = spread ? random_unit() : 0; r2 = random_unit(); this.u6.ucopy_reset(r1, r2);
    r1 = spread ? random_unit() : 0; r2 = random_unit(); this.u7.ucopy_reset(r1, r2);
    r1 = spread ? random_unit() : 0; r2 = random_unit(); this.u8.ucopy_reset(r1, r2);
    this.sub.osc_reset(0);
    this.nz.nz_reg = 1; this.nz.nz_phase = 0; this.nz.nz_out = 0;
    this.nzf.svf_reset();
    this.fl1.svf_reset(); this.fl2.svf_reset(); this.fr1.svf_reset(); this.fr2.svf_reset();
    this.aenv.value = 0;
    this.fenv.value = 0;
    this.menv.value = 0;
  ) : op === 2 ? (
    this.aenv.adsr_gate_off();
    this.fenv.adsr_gate_off();
    this.menv.adsr_gate_off();
  ) : op === 3 ? (
    this.aenv.adsr_set(amp_attack_ms, amp_decay_ms, amp_sustain, amp_release_ms);
    this.fenv.adsr_set(filter_env_attack_ms, filter_env_decay_ms, filter_env_sustain, filter_env_release_ms);
    this.menv.adsr_set(mod_env_attack_ms, mod_env_decay_ms, mod_env_sustain, mod_env_release_ms);
    this.nzf.svf_set(noise_filter_hz, 1);
  ) : op === 4 ? (
    v_active[idx] ? base_hz = tuning_note_to_hz(v_pitch[idx]);
  ) : op === 5 ? (
    base_hz = a;
    glide_oct = b;
    poly_at = 0;
  ) : op === 6 ? (
    velocity = a / 127;
    this.aenv.adsr_gate_on();
    this.fenv.adsr_gate_on();
    this.menv.adsr_gate_on();
    rnd = mod_random();
    noise_type_i >= 4 ? this.sfx.sound_fx_reset(idx, velocity);
  ) : op === 7 ? (
    glide_oct;
  ) : op === 8 ? (
    base_hz;
  ) : op === 9 ? (
    poly_at = a;
  );
);

// chip / S&H noise of a voice: 15-bit shift register in plain arithmetic (same as voice_noise in synth.js)
function voice_noise(hz) instance(nz_reg nz_phase nz_out) local(r, tap, b0, bx) (
  nz_phase += min(1, (hz * noise_clock) / srate);
  nz_phase >= 1 ? (
    nz_phase -= 1;
    noise_type_i === 3 ? (
      nz_out = noise_white();
    ) : (
      r = nz_reg;
      tap = noise_type_i === 2 ? 64 : 2;
      b0 = r - 2 * floor(r / 2);
      bx = floor(r / tap) - 2 * floor(r / (2 * tap));
      nz_reg = floor(r / 2) + (b0 === bx ? 0 : 16384);
      nz_out = nz_reg - 2 * floor(nz_reg / 2) ? 1 : -1;
    );
  );
  nz_out;
);

function ucopy_mix(y, u) (
  y *= un_w[u];
  stereo ? ( xl += y * un_gl[u]; xr += y * un_gr[u]; ) : xl += y;
);

function voice_render() instance(idx velocity base_hz glide_oct rnd poly_at press)
  local(hz, fenv, menv, r2, common, nz, nlev, env_scale, oct, fc, yl, yr, aenv, g, pw1, pw2, kf, fmc, j, src, dst, pmod) (
  v_active[idx] ? (
    hz = base_hz * g_pitch_ratio;
    glide_oct !== 0 ? (
      hz *= pow(2, glide_oct);
      glide_oct *= glide_coef;
      abs(glide_oct) < 0.0001 ? glide_oct = 0;
    );
    fenv = this.fenv.adsr_process();
    menv = this.menv.adsr_process();
    aenv = this.aenv.adsr_process();
    pw1 = g_pw1; pw2 = g_pw2; kf = filter_k; fmc = fm_cycles;

    // mod matrix, per voice: the global sums plus this note's own sources
    mm_n > 0 ? (
      m_press ? press += (max(pressure, poly_at) - press) * press_a;
      memcpy(mm_v, mm_g, N_DST);
      j = 0;
      loop(mm_n,
        src = mm_src[j];
        dst = mm_dst[j];
        dst < 9 || dst > 10 ? (
          src === 3 ? mm_v[dst] += menv * mm_amt[j]
          : src === 4 ? mm_v[dst] += velocity * mm_amt[j]
          : src === 5 ? mm_v[dst] += (log(base_hz / 261.6256) / log(2)) * mm_amt[j]
          : src === 7 ? mm_v[dst] += press * mm_amt[j]
          : src === 8 ? mm_v[dst] += rnd * mm_amt[j];
        );
        j += 1;
      );
      m_pitch ? hz *= pow(2, mm_v[1] / 1200);
      m_res ? kf = 2 - 1.98 * sqrt(clamp(filter_resonance + mm_v[3], 0, 1));
      m_pw ? (
        pw1 = clamp(osc1_pulse_width + g_lfo * lfo_pulse_width + mm_v[4], 0.02, 0.98);
        pw2 = clamp(osc2_pulse_width + g_lfo * lfo_pulse_width + mm_v[4], 0.02, 0.98);
      );
      m_fm ? fmc = max(0, fm_index + mm_v[6]) / (2 * $pi);
    );
    r2 = m_osc2 ? pow(2, (g_osc2_cents + fenv * osc2_env_pitch_cents + mm_v[5]) / 1200)
      : osc2_env_pitch_cents !== 0 ? pow(2, (g_osc2_cents + fenv * osc2_env_pitch_cents) / 1200) : g_osc2_ratio;
    g_wpos1 = 0;
    g_wpos2 = 0;
    wt_osc1 || wt_osc2 ? (
      pmod = g_wt_lfo + fenv * wt_position_filter_env + aenv * wt_position_amp_env;
      g_wpos1 = clamp(osc1_wt_position + pmod, 0, 1);
      g_wpos2 = clamp(osc2_wt_position + pmod, 0, 1);
    );

    // oscillators x unison (xl / xr are globals summed by ucopy_mix)
    xl = 0; xr = 0;
    ucopy_mix(this.u0.ucopy_process(hz * un_ratio[0], r2, osc1_waveform, osc2_waveform, pw1, pw2, fmc, g_sync, osc1_level, osc2_level), 0);
    unison_n > 1 ? ucopy_mix(this.u1.ucopy_process(hz * un_ratio[1], r2, osc1_waveform, osc2_waveform, pw1, pw2, fmc, g_sync, osc1_level, osc2_level), 1);
    unison_n > 2 ? ucopy_mix(this.u2.ucopy_process(hz * un_ratio[2], r2, osc1_waveform, osc2_waveform, pw1, pw2, fmc, g_sync, osc1_level, osc2_level), 2);
    unison_n > 3 ? ucopy_mix(this.u3.ucopy_process(hz * un_ratio[3], r2, osc1_waveform, osc2_waveform, pw1, pw2, fmc, g_sync, osc1_level, osc2_level), 3);
    unison_n > 4 ? ucopy_mix(this.u4.ucopy_process(hz * un_ratio[4], r2, osc1_waveform, osc2_waveform, pw1, pw2, fmc, g_sync, osc1_level, osc2_level), 4);
    unison_n > 5 ? ucopy_mix(this.u5.ucopy_process(hz * un_ratio[5], r2, osc1_waveform, osc2_waveform, pw1, pw2, fmc, g_sync, osc1_level, osc2_level), 5);
    unison_n > 6 ? ucopy_mix(this.u6.ucopy_process(hz * un_ratio[6], r2, osc1_waveform, osc2_waveform, pw1, pw2, fmc, g_sync, osc1_level, osc2_level), 6);
    unison_n > 7 ? ucopy_mix(this.u7.ucopy_process(hz * un_ratio[7], r2, osc1_waveform, osc2_waveform, pw1, pw2, fmc, g_sync, osc1_level, osc2_level), 7);
    unison_n > 8 ? ucopy_mix(this.u8.ucopy_process(hz * un_ratio[8], r2, osc1_waveform, osc2_waveform, pw1, pw2, fmc, g_sync, osc1_level, osc2_level), 8);
    xl *= unison_norm;
    xr *= unison_norm;

    common = 0;
    nlev = m_noise ? clamp(noise_level + mm_v[11], 0, 1) : noise_level;
    sub_osc_level > 0 ? (
      this.sub.osc_set_freq(hz * 0.5);
      common += this.sub.osc_process(1, 0.5, 0) * sub_osc_level;
    );
    // FX clocks continue while muted; unmuting must not replay an old shot.
    nlev > 0 || noise_type_i >= 4 ? (
      nz = noise_type_i >= 4 ? this.sfx.sound_fx_noise()
        : noise_type_i === 0 ? noise_white() : this.nz.voice_noise(hz);
      noise_filter_i > 0 ? (
        this.nzf.svf_process(nz);
        nz = this.nzf.svf_output(noise_filter_i - 1);
      );
      common += nz * nlev;
    );
    xl += common;
    stereo ? xr += common;
    filter_drive > 0 ? (
      xl = soft_clip(xl * drive_gain) * drive_makeup;
      stereo ? xr = soft_clip(xr * drive_gain) * drive_makeup;
    );

    // filter
    env_scale = 1 - filter_velocity_amount + filter_velocity_amount * velocity;
    oct = fenv * filter_env_amount_oct * env_scale + g_lfo_filter_oct;
    mm_n > 0 ? oct += mm_v[2];
    // key tracking relative to middle C (261.63 Hz), works for any tuning
    fc = g_cutoff * pow(2, oct) * pow(base_hz / 261.6256, filter_key_tracking);
    yr = 0;
    filter_slope >= 0.5 ? (
      this.fl1.svf_set(fc, 1.414);
      this.fl2.svf_set(fc, kf);
      this.fl1.svf_process(xl);
      this.fl2.svf_process(this.fl1.svf_output(filter_mode));
      yl = this.fl2.svf_output(filter_mode);
      stereo ? (
        this.fr1.svf_copy(this.fl1.g, this.fl1.k, this.fl1.a1, this.fl1.a2, this.fl1.a3);
        this.fr2.svf_copy(this.fl2.g, this.fl2.k, this.fl2.a1, this.fl2.a2, this.fl2.a3);
        this.fr1.svf_process(xr);
        this.fr2.svf_process(this.fr1.svf_output(filter_mode));
        yr = this.fr2.svf_output(filter_mode);
      );
    ) : (
      this.fl1.svf_set(fc, kf);
      this.fl1.svf_process(xl);
      yl = this.fl1.svf_output(filter_mode);
      stereo ? (
        this.fr1.svf_copy(this.fl1.g, this.fl1.k, this.fl1.a1, this.fl1.a2, this.fl1.a3);
        this.fr1.svf_process(xr);
