desc:AmiSynth Synth (polyphonic subtractive, microtonal)
//tags: instrument synthesizer
//author: AmiSynth
// Port of src/dsp/synth.js. Parameter names = slider variable names = ids in
// src/dsp/params.js (the block between the generated markers is rewritten by
// `npm run gen:jsfx`; do not edit it by hand).
// Tuning: the EDO sliders, or a shared Scala scale in REAPER/Data/AmiSynth/tuning.txt (tuning_source).

options:gmem=AmiSynth

// <generated sliders>
slider1:tuning_divisions=12<1,72,1>Tuning Divisions Per Period [steps]
slider2:tuning_period_cents=1200<100,2400,0.001>Tuning Period [cents]
slider3:tuning_ref_note=69<0,127,1>Tuning Reference Note [note]
slider4:tuning_ref_hz=440<100,1000,0.01>Tuning Reference Frequency [Hz]
slider5:osc1_waveform=0<0,3,1{Saw,Pulse,Triangle,Sine}>Osc1 Waveform
slider6:osc1_pulse_width=0.5<0.05,0.95,0.001>Osc1 Pulse Width
slider7:osc1_level=0.8<0,1,0.001>Osc1 Level
slider8:osc2_waveform=1<0,3,1{Saw,Pulse,Triangle,Sine}>Osc2 Waveform
slider9:osc2_pulse_width=0.5<0.05,0.95,0.001>Osc2 Pulse Width
slider10:osc2_level=0.5<0,1,0.001>Osc2 Level
slider11:osc2_transpose_cents=0<-2400,2400,1>Osc2 Transpose [cents]
slider12:osc2_detune_cents=7<-100,100,0.1>Osc2 Detune [cents]
slider13:sub_osc_level=0<0,1,0.001>Sub Osc Level
slider14:noise_level=0<0,1,0.001>Noise Level
slider15:osc2_hard_sync=0<0,1,1{Off,On}>Osc2 Hard Sync
slider16:osc2_env_pitch_cents=0<-4800,4800,1>Osc2 Env Pitch [cents]
slider17:fm_index=0<0,10,0.01>FM Index [rad]
slider18:filter_mode=0<0,3,1{Low-pass,High-pass,Band-pass,Notch}>Filter Mode
slider19:filter_cutoff_hz=1800<20,20000,1>Filter Cutoff [Hz]
slider20:filter_resonance=0.3<0,1,0.001>Filter Resonance
slider21:filter_slope=1<0,1,1{12 dB/oct,24 dB/oct}>Filter Slope
slider22:filter_drive=0<0,1,0.001>Filter Drive
slider23:filter_env_amount_oct=3<-8,8,0.01>Filter Env Amount [oct]
slider24:filter_key_tracking=0.5<0,1,0.001>Filter Key Tracking
slider25:filter_velocity_amount=0.3<0,1,0.001>Filter Velocity Amount
slider26:filter_env_attack_ms=5<0.5,5000,0.1>Filter Env Attack [ms]
slider27:filter_env_decay_ms=300<1,10000,1>Filter Env Decay [ms]
slider28:filter_env_sustain=0.2<0,1,0.001>Filter Env Sustain
slider29:filter_env_release_ms=300<1,10000,1>Filter Env Release [ms]
slider30:amp_attack_ms=3<0.5,5000,0.1>Amp Attack [ms]
slider31:amp_decay_ms=400<1,10000,1>Amp Decay [ms]
slider32:amp_sustain=0.7<0,1,0.001>Amp Sustain
slider33:amp_release_ms=250<1,10000,1>Amp Release [ms]
slider34:amp_velocity_amount=0.7<0,1,0.001>Amp Velocity Amount
slider35:lfo_waveform=0<0,5,1{Sine,Triangle,Saw Down,Square,Sample & Hold,Duck (pump)}>LFO Waveform
slider36:lfo_rate_hz=5<0.05,20,0.01>LFO Rate [Hz]
slider37:lfo_pitch_cents=0<0,1200,0.1>LFO Pitch Depth [cents]
slider38:lfo_filter_oct=0<0,4,0.01>LFO Filter Depth [oct]
slider39:lfo_pulse_width=0<0,0.45,0.001>LFO Pulse Width Depth
slider40:lfo_amp=0<0,1,0.001>LFO Tremolo Depth
slider41:modwheel_vibrato_cents=30<0,200,0.1>Mod Wheel Vibrato Depth [cents]
slider42:modwheel_filter_oct=0<0,4,0.01>Mod Wheel Filter LFO Depth [oct]
slider43:pitch_bend_range_cents=200<0,2400,1>Pitch Bend Range [cents]
slider44:voice_count=8<1,8,1>Max Voices [voices]
slider45:glide_ms=0<0,1000,1>Glide Time [ms]
slider46:unison_voices=1<1,9,1>Unison Voices [voices]
slider47:unison_detune_cents=15<0,100,0.1>Unison Detune [cents]
slider48:unison_stereo_width=0.7<0,1,0.001>Unison Stereo Width
slider49:master_volume_db=-6<-60,6,0.1>Master Volume [dB]
slider50:transpose_semitones=0<-24,24,1>Transpose [semitones]
slider51:voice_mode=0<0,2,1{Poly,Mono,Legato}>Voice Mode
slider52:glide_mode=0<0,1,1{Always,Legato only}>Glide Mode
slider53:unison_detune_curve=0<0,1,0.001>Unison Detune Curve
slider54:unison_side_level=1<0,1,0.001>Unison Side Level
slider55:lfo_sync=0<0,16,1{Off,4 bars,2 bars,1/1,1/2,1/2 dotted,1/2 triplet,1/4,1/4 dotted,1/4 triplet,1/8,1/8 dotted,1/8 triplet,1/16,1/16 dotted,1/16 triplet,1/32}>LFO Sync
slider56:arp_mode=0<0,6,1{Off,Up,Down,Up-Down,Random,As Played,Chord}>Arp Mode
slider57:arp_rate=4<0,6,1{1/4,1/8,1/8 triplet,1/8 dotted,1/16,1/16 triplet,1/32}>Arp Rate
slider58:arp_octaves=1<1,4,1>Arp Octave Range [oct]
slider59:arp_gate=0.5<0.05,1,0.001>Arp Gate
slider60:arp_swing_percent=50<50,75,0.1>Arp Swing [%]
slider61:arp_steps=16<1,16,1>Arp Pattern Length [steps]
slider62:arp_step_1=1<0,1,1{Off,On}>Arp Step 1
slider63:arp_step_2=1<0,1,1{Off,On}>Arp Step 2
slider64:arp_step_3=1<0,1,1{Off,On}>Arp Step 3
slider65:arp_step_4=1<0,1,1{Off,On}>Arp Step 4
slider66:arp_step_5=1<0,1,1{Off,On}>Arp Step 5
slider67:arp_step_6=1<0,1,1{Off,On}>Arp Step 6
slider68:arp_step_7=1<0,1,1{Off,On}>Arp Step 7
slider69:arp_step_8=1<0,1,1{Off,On}>Arp Step 8
slider70:arp_step_9=1<0,1,1{Off,On}>Arp Step 9
slider71:arp_step_10=1<0,1,1{Off,On}>Arp Step 10
slider72:arp_step_11=1<0,1,1{Off,On}>Arp Step 11
slider73:arp_step_12=1<0,1,1{Off,On}>Arp Step 12
slider74:arp_step_13=1<0,1,1{Off,On}>Arp Step 13
slider75:arp_step_14=1<0,1,1{Off,On}>Arp Step 14
slider76:arp_step_15=1<0,1,1{Off,On}>Arp Step 15
slider77:arp_step_16=1<0,1,1{Off,On}>Arp Step 16
slider78:noise_type=0<0,3,1{White,Chip Long (LFSR),Chip Short (metallic),Sample & Hold}>Noise Type
slider79:noise_clock_oct=0<-4,4,0.01>Noise Clock [oct]
slider80:noise_filter_mode=0<0,3,1{Off,Low-pass,High-pass,Band-pass}>Noise Filter
slider81:noise_filter_hz=4000<20,20000,1>Noise Filter Cutoff [Hz]
slider82:cc_cutoff_number=74<0,127,1>Cutoff CC Number [cc]
slider83:cc_cutoff_depth_oct=4<0,8,0.01>Cutoff CC Depth [oct]
slider84:tuning_source=0<0,2,1{EDO sliders,Scale file (Data/AmiSynth/tuning.txt),Shared (AmiSynth Tuning)}>Tuning Source
slider85:tuning_slot=1<1,8,1>Tuning Slot
// </generated sliders>

import amisynth_lib.jsfx-inc
import amisynth_meter.jsfx-inc

in_pin:none
out_pin:Left
out_pin:Right

@init
meter.meter_init();
voice_steals = 0;
MAX_VOICES = 8;
MAX_UNISON = 9;
MAX_HELD = 16;
noise_seed(12345);

v_active = mem_alloc(MAX_VOICES);
v_note = mem_alloc(MAX_VOICES); // key the voice answers to (note-off matching)
v_pitch = mem_alloc(MAX_VOICES); // note number it sounds at (key + transpose)
v_gate = mem_alloc(MAX_VOICES);
v_sus = mem_alloc(MAX_VOICES);
v_age = mem_alloc(MAX_VOICES);
un_ratio = mem_alloc(MAX_UNISON);
un_gl = mem_alloc(MAX_UNISON);
un_gr = mem_alloc(MAX_UNISON);
un_w = mem_alloc(MAX_UNISON);
// mono / legato note stack (last note priority)
stack_key = mem_alloc(MAX_HELD);
stack_pitch = mem_alloc(MAX_HELD);
stack_vel = mem_alloc(MAX_HELD);
stack_n = 0;
// arpeggiator: held keys (in the order played), notes it is sounding, work arrays
arp_key = mem_alloc(MAX_HELD);
arp_vel = mem_alloc(MAX_HELD);
arp_snd = mem_alloc(MAX_HELD);
arp_ordk = mem_alloc(MAX_HELD);
arp_ordv = mem_alloc(MAX_HELD);
arp_newk = mem_alloc(MAX_HELD);
arp_newv = mem_alloc(MAX_HELD);
arp_pat = mem_alloc(16);
arp_n = 0;
arp_snd_n = 0;
arp_last = 0;
arp_off_pos = 0;
arp_idx = 0;
arp_cur_mode = 0;

// note values in beats (same tables as LFO_SYNC_BEATS / ARP_RATE_BEATS in params.js)
lfo_sync_tab = mem_alloc(17);
lfo_sync_tab[0] = 0; lfo_sync_tab[1] = 16; lfo_sync_tab[2] = 8; lfo_sync_tab[3] = 4; lfo_sync_tab[4] = 2;
lfo_sync_tab[5] = 3; lfo_sync_tab[6] = 4 / 3; lfo_sync_tab[7] = 1; lfo_sync_tab[8] = 1.5; lfo_sync_tab[9] = 2 / 3;
lfo_sync_tab[10] = 0.5; lfo_sync_tab[11] = 0.75; lfo_sync_tab[12] = 1 / 3; lfo_sync_tab[13] = 0.25;
lfo_sync_tab[14] = 0.375; lfo_sync_tab[15] = 1 / 6; lfo_sync_tab[16] = 0.125;
arp_rate_tab = mem_alloc(7);
arp_rate_tab[0] = 1; arp_rate_tab[1] = 0.5; arp_rate_tab[2] = 1 / 3; arp_rate_tab[3] = 0.75;
arp_rate_tab[4] = 0.25; arp_rate_tab[5] = 1 / 6; arp_rate_tab[6] = 0.125;

age_counter = 0;
bend = 0;
modwheel = 0;
sustain_pedal = 0;
last_hz = 0;
cutoff_smooth.smoother_init(1000);
cutoff_smooth.smoother_set(15);
gain_smooth.smoother_init(0);
gain_smooth.smoother_set(20);
// cutoff CC (value 64 = centre)
cc_cutoff_value = 64;
cc_mult = 1;
// clock of the chip / S&H noise in multiples of the note frequency (same as NOISE_CLOCK in synth.js)
noise_clock_tab = mem_alloc(4);
noise_clock_tab[0] = 0; noise_clock_tab[1] = 32; noise_clock_tab[2] = 93; noise_clock_tab[3] = 8;
// host transport: beats (quarter notes), advanced every sample, resynced in @block while playing
beat = 0;
beat_inc = 120 / 60 / srate;

// ---- one unison copy: osc1 + osc2 (osc2 can sync to osc1 and FM it)
function ucopy_reset(r1, r2) instance(prev2) (
  this.o1.osc_reset(r1);
  this.o2.osc_reset(r2);
  prev2 = 0;
);

function ucopy_process(f, r2, w1, w2, pw1, pw2, fm, sync, l1, l2) instance(prev2) local(y1, y2) (
  this.o1.osc_set_freq(f);
  this.o2.osc_set_freq(f * r2);
  // FM uses osc2's previous sample so sync (osc1 -> osc2) and FM (osc2 -> osc1) can coexist
  y1 = this.o1.osc_process(w1, pw1, fm * prev2);
  sync && this.o1.wrapped ? this.o2.osc_sync(this.o1.phase, this.o1.inc);
  y2 = this.o2.osc_process(w2, pw2, 0);
  prev2 = y2;
  y1 * l1 + y2 * l2;
);

// ---- voice (namespace v0..v7)
// op: 0 set index, 1 reset (fresh voice), 2 gate off, 3 envelopes, 4 retune,
//     5 set pitch (a = hz, b = glide_oct), 6 trigger (a = velocity 1..127), 7 get glide_oct, 8 get base_hz
function voice_op(op, a, b, c, d) instance(idx velocity base_hz glide_oct) local(spread, r1, r2) (
  op === 0 ? (
    idx = a;
  ) : op === 1 ? (
    spread = unison_n > 1;
    // same random call order as the JS code: per copy osc1 (if spread) then osc2
    r1 = spread ? random_unit() : 0; r2 = random_unit(); this.u0.ucopy_reset(r1, r2);
    r1 = spread ? random_unit() : 0; r2 = random_unit(); this.u1.ucopy_reset(r1, r2);
    r1 = spread ? random_unit() : 0; r2 = random_unit(); this.u2.ucopy_reset(r1, r2);
    r1 = spread ? random_unit() : 0; r2 = random_unit(); this.u3.ucopy_reset(r1, r2);
    r1 = spread ? random_unit() : 0; r2 = random_unit(); this.u4.ucopy_reset(r1, r2);
    r1 = spread ? random_unit() : 0; r2 = random_unit(); this.u5.ucopy_reset(r1, r2);
    r1 = spread ? random_unit() : 0; r2 = random_unit(); this.u6.ucopy_reset(r1, r2);
    r1 = spread ? random_unit() : 0; r2 = random_unit(); this.u7.ucopy_reset(r1, r2);
    r1 = spread ? random_unit() : 0; r2 = random_unit(); this.u8.ucopy_reset(r1, r2);
    this.sub.osc_reset(0);
    this.nz.nz_reg = 1; this.nz.nz_phase = 0; this.nz.nz_out = 0;
    this.nzf.svf_reset();
    this.fl1.svf_reset(); this.fl2.svf_reset(); this.fr1.svf_reset(); this.fr2.svf_reset();
    this.aenv.value = 0;
    this.fenv.value = 0;
  ) : op === 2 ? (
    this.aenv.adsr_gate_off();
    this.fenv.adsr_gate_off();
  ) : op === 3 ? (
    this.aenv.adsr_set(amp_attack_ms, amp_decay_ms, amp_sustain, amp_release_ms);
    this.fenv.adsr_set(filter_env_attack_ms, filter_env_decay_ms, filter_env_sustain, filter_env_release_ms);
    this.nzf.svf_set(noise_filter_hz, 1);
  ) : op === 4 ? (
    v_active[idx] ? base_hz = tuning_note_to_hz(v_pitch[idx]);
  ) : op === 5 ? (
    base_hz = a;
    glide_oct = b;
  ) : op === 6 ? (
    velocity = a / 127;
    this.aenv.adsr_gate_on();
    this.fenv.adsr_gate_on();
  ) : op === 7 ? (
    glide_oct;
  ) : op === 8 ? (
    base_hz;
  );
);

// chip / S&H noise of a voice: 15-bit shift register in plain arithmetic (same as voice_noise in synth.js)
function voice_noise(hz) instance(nz_reg nz_phase nz_out) local(r, tap, b0, bx) (
  nz_phase += min(1, (hz * noise_clock) / srate);
  nz_phase >= 1 ? (
    nz_phase -= 1;
    noise_type_i === 3 ? (
      nz_out = noise_white();
    ) : (
      r = nz_reg;
      tap = noise_type_i === 2 ? 64 : 2;
      b0 = r - 2 * floor(r / 2);
      bx = floor(r / tap) - 2 * floor(r / (2 * tap));
      nz_reg = floor(r / 2) + (b0 === bx ? 0 : 16384);
      nz_out = nz_reg - 2 * floor(nz_reg / 2) ? 1 : -1;
    );
  );
  nz_out;
);

function ucopy_mix(y, u) (
  y *= un_w[u];
  stereo ? ( xl += y * un_gl[u]; xr += y * un_gr[u]; ) : xl += y;
);

function voice_render() instance(idx velocity base_hz glide_oct) local(hz, fenv, r2, common, nz, env_scale, oct, fc, yl, yr, aenv, g) (
  v_active[idx] ? (
    hz = base_hz * g_pitch_ratio;
    glide_oct !== 0 ? (
      hz *= pow(2, glide_oct);
      glide_oct *= glide_coef;
      abs(glide_oct) < 0.0001 ? glide_oct = 0;
    );
    fenv = this.fenv.adsr_process();
    r2 = osc2_env_pitch_cents !== 0 ? pow(2, (g_osc2_cents + fenv * osc2_env_pitch_cents) / 1200) : g_osc2_ratio;

    // oscillators x unison (xl / xr are globals summed by ucopy_mix)
    xl = 0; xr = 0;
    ucopy_mix(this.u0.ucopy_process(hz * un_ratio[0], r2, osc1_waveform, osc2_waveform, g_pw1, g_pw2, fm_cycles, g_sync, osc1_level, osc2_level), 0);
    unison_n > 1 ? ucopy_mix(this.u1.ucopy_process(hz * un_ratio[1], r2, osc1_waveform, osc2_waveform, g_pw1, g_pw2, fm_cycles, g_sync, osc1_level, osc2_level), 1);
    unison_n > 2 ? ucopy_mix(this.u2.ucopy_process(hz * un_ratio[2], r2, osc1_waveform, osc2_waveform, g_pw1, g_pw2, fm_cycles, g_sync, osc1_level, osc2_level), 2);
    unison_n > 3 ? ucopy_mix(this.u3.ucopy_process(hz * un_ratio[3], r2, osc1_waveform, osc2_waveform, g_pw1, g_pw2, fm_cycles, g_sync, osc1_level, osc2_level), 3);
    unison_n > 4 ? ucopy_mix(this.u4.ucopy_process(hz * un_ratio[4], r2, osc1_waveform, osc2_waveform, g_pw1, g_pw2, fm_cycles, g_sync, osc1_level, osc2_level), 4);
    unison_n > 5 ? ucopy_mix(this.u5.ucopy_process(hz * un_ratio[5], r2, osc1_waveform, osc2_waveform, g_pw1, g_pw2, fm_cycles, g_sync, osc1_level, osc2_level), 5);
    unison_n > 6 ? ucopy_mix(this.u6.ucopy_process(hz * un_ratio[6], r2, osc1_waveform, osc2_waveform, g_pw1, g_pw2, fm_cycles, g_sync, osc1_level, osc2_level), 6);
    unison_n > 7 ? ucopy_mix(this.u7.ucopy_process(hz * un_ratio[7], r2, osc1_waveform, osc2_waveform, g_pw1, g_pw2, fm_cycles, g_sync, osc1_level, osc2_level), 7);
    unison_n > 8 ? ucopy_mix(this.u8.ucopy_process(hz * un_ratio[8], r2, osc1_waveform, osc2_waveform, g_pw1, g_pw2, fm_cycles, g_sync, osc1_level, osc2_level), 8);
    xl *= unison_norm;
    xr *= unison_norm;

    common = 0;
    sub_osc_level > 0 ? (
      this.sub.osc_set_freq(hz * 0.5);
      common += this.sub.osc_process(1, 0.5, 0) * sub_osc_level;
    );
    noise_level > 0 ? (
      nz = noise_type_i === 0 ? noise_white() : this.nz.voice_noise(hz);
      noise_filter_i > 0 ? (
        this.nzf.svf_process(nz);
        nz = this.nzf.svf_output(noise_filter_i - 1);
      );
      common += nz * noise_level;
    );
    xl += common;
    stereo ? xr += common;
    filter_drive > 0 ? (
      xl = soft_clip(xl * drive_gain) * drive_makeup;
      stereo ? xr = soft_clip(xr * drive_gain) * drive_makeup;
    );

    // filter
    env_scale = 1 - filter_velocity_amount + filter_velocity_amount * velocity;
    oct = fenv * filter_env_amount_oct * env_scale + g_lfo_filter_oct;
    // key tracking relative to middle C (261.63 Hz), works for any tuning
    fc = g_cutoff * pow(2, oct) * pow(base_hz / 261.6256, filter_key_tracking);
    yr = 0;
    filter_slope >= 0.5 ? (
      this.fl1.svf_set(fc, 1.414);
      this.fl2.svf_set(fc, filter_k);
      this.fl1.svf_process(xl);
      this.fl2.svf_process(this.fl1.svf_output(filter_mode));
      yl = this.fl2.svf_output(filter_mode);
      stereo ? (
        this.fr1.svf_copy(this.fl1.g, this.fl1.k, this.fl1.a1, this.fl1.a2, this.fl1.a3);
        this.fr2.svf_copy(this.fl2.g, this.fl2.k, this.fl2.a1, this.fl2.a2, this.fl2.a3);
        this.fr1.svf_process(xr);
        this.fr2.svf_process(this.fr1.svf_output(filter_mode));
        yr = this.fr2.svf_output(filter_mode);
      );
    ) : (
      this.fl1.svf_set(fc, filter_k);
      this.fl1.svf_process(xl);
      yl = this.fl1.svf_output(filter_mode);
      stereo ? (
        this.fr1.svf_copy(this.fl1.g, this.fl1.k, this.fl1.a1, this.fl1.a2, this.fl1.a3);
        this.fr1.svf_process(xr);
        yr = this.fr1.svf_output(filter_mode);
      );
    );

    // amp
    aenv = this.aenv.adsr_process();
    g = aenv * (1 - amp_velocity_amount + amp_velocity_amount * velocity);
    mix_l += yl * g;
    mix_r += (stereo ? yr : yl) * g;

    this.aenv.stage === 0 ? (
      v_active[idx] = 0;
      v_note[idx] = -1;
    );
  );
);

/** 8-way dispatch (EEL2 has no arrays of namespaces) */
function vcall(i, op, a, b, c, d) (
  i === 0 ? v0.voice_op(op, a, b, c, d) : i === 1 ? v1.voice_op(op, a, b, c, d) :
  i === 2 ? v2.voice_op(op, a, b, c, d) : i === 3 ? v3.voice_op(op, a, b, c, d) :
  i === 4 ? v4.voice_op(op, a, b, c, d) : i === 5 ? v5.voice_op(op, a, b, c, d) :
  i === 6 ? v6.voice_op(op, a, b, c, d) : v7.voice_op(op, a, b, c, d);
);

i = 0;
loop(MAX_VOICES,
  vcall(i, 0, i, 0, 0, 0);
  v_active[i] = 0; v_note[i] = -1; v_pitch[i] = 0; v_gate[i] = 0; v_sus[i] = 0; v_age[i] = 0;
  i += 1;
);

// ---- voice engine (poly): voices answer to `key`, sound at `pitch`
function voice_limit() ( clamp(floor(voice_count + 0.5), 1, MAX_VOICES); );

function voice_allocate() local(n, i, best, best_score, score, found) (
  n = voice_limit();
  best = -1; best_score = -1; found = -1;
  i = 0;
  while (i < n && found < 0) (
    !v_active[i] ? found = i : (
      // prefer stealing released voices, then the oldest
      score = (v_gate[i] ? 0 : 1000000000000) + (age_counter - v_age[i]);
      score > best_score ? ( best_score = score; best = i; );
    );
    i += 1;
  );
  found < 0 ? voice_steals += 1;
  found >= 0 ? found : best;
);

function any_gate() local(i, r) (
  r = 0; i = 0;
  loop(MAX_VOICES, v_active[i] && v_gate[i] ? r = 1; i += 1;);
  r;
);

function poly_note_on(key, pitch, vel) local(n, held, i, idx, hz) (
  n = voice_limit();
  held = glide_legato ? any_gate() : 1;
  idx = -1;
  i = 0;
  loop(n, v_active[i] && v_note[i] === key ? idx = i; i += 1;);
  idx < 0 ? idx = voice_allocate();
  hz = tuning_note_to_hz(pitch);
  !v_active[idx] ? vcall(idx, 1, 0, 0, 0, 0);
  vcall(idx, 5, hz, glide_coef > 0 && last_hz > 0 && held ? clamp(log(last_hz / hz) / log(2), -8, 8) : 0, 0, 0);
  last_hz = hz;
  v_active[idx] = 1;
  v_gate[idx] = 1;
  v_sus[idx] = 0;
  v_note[idx] = key;
  v_pitch[idx] = pitch;
  age_counter += 1;
  v_age[idx] = age_counter;
  vcall(idx, 6, vel, 0, 0, 0);
);

function poly_note_off(key) local(i) (
  i = 0;
  loop(MAX_VOICES,
    v_active[i] && v_gate[i] && v_note[i] === key ? (
      v_gate[i] = 0;
      sustain_pedal ? v_sus[i] = 1 : vcall(i, 2, 0, 0, 0, 0);
    );
    i += 1;
  );
);

// ---- mono / legato: voice 0 only, last-note priority
function mono_play(key, pitch, vel, retrig, overlap) local(hz, g) (
  hz = tuning_note_to_hz(pitch);
  !v_active[0] ? v0.voice_op(1, 0, 0, 0, 0);
  glide_coef > 0 && (overlap || !glide_legato) ? (
    // glide from where the pitch is right now (it may still be gliding)
    g = v_active[0] ? clamp(v0.voice_op(7, 0, 0, 0, 0) + log(v0.voice_op(8, 0, 0, 0, 0) / hz) / log(2), -8, 8)
      : last_hz > 0 ? clamp(log(last_hz / hz) / log(2), -8, 8) : 0;
  ) : g = 0;
  v0.voice_op(5, hz, g, 0, 0);
  last_hz = hz;
  v_active[0] = 1;
  v_gate[0] = 1;
  v_sus[0] = 0;
  v_note[0] = key;
  v_pitch[0] = pitch;
  age_counter += 1;
  v_age[0] = age_counter;
  retrig ? v0.voice_op(6, vel, 0, 0, 0);
);

function stack_remove(key) local(i, j) (
  i = 0; j = 0;
  loop(stack_n,
    stack_key[i] !== key ? (
      stack_key[j] = stack_key[i];
      stack_pitch[j] = stack_pitch[i];
      stack_vel[j] = stack_vel[i];
      j += 1;
    );
    i += 1;
  );
  stack_n = j;
);

function mono_note_on(key, pitch, vel) local(i, overlap) (
  stack_remove(key);
  stack_n >= MAX_HELD ? (
    // forget the oldest key
    i = 1;
    loop(MAX_HELD - 1,
      stack_key[i - 1] = stack_key[i];
      stack_pitch[i - 1] = stack_pitch[i];
      stack_vel[i - 1] = stack_vel[i];
      i += 1;
    );
    stack_n = MAX_HELD - 1;
  );
  stack_key[stack_n] = key;
  stack_pitch[stack_n] = pitch;
  stack_vel[stack_n] = vel;
  stack_n += 1;
  overlap = v_active[0] && v_gate[0] ? 1 : 0;
  mono_play(key, pitch, vel, voice_legato && overlap ? 0 : 1, overlap);
);

function mono_note_off(key) local(t) (
  stack_remove(key);
  v_active[0] && v_gate[0] && v_note[0] === key && stack_n > 0 ? (
    // back to the most recent key still held
    t = stack_n - 1;
    mono_play(stack_key[t], stack_pitch[t], stack_vel[t], voice_legato ? 0 : 1, 1);
  );
);

function engine_on(key, pitch, vel) (
  voice_mono ? mono_note_on(key, pitch, vel) : poly_note_on(key, pitch, vel);
);

function engine_off(key) (
  voice_mono ? mono_note_off(key);
  // releases voice 0 when no other key is held, and any voice left from a mode change
  poly_note_off(key);
);

// ---- arpeggiator: steps locked to the host beat grid (step k starts at beat k * arp_step_beats,
// every 2nd step delayed by the swing); each step plays the next note of the held chord
function arp_key_on(key, vel) local(i, found, pos, k) (
  found = 0;
  i = 0;
  loop(arp_n, arp_key[i] === key ? ( arp_vel[i] = vel; found = 1; ); i += 1;);
  !found && arp_n < MAX_HELD ? (
    arp_n === 0 ? (
      // first key: start from the bottom and play the current step at once (a key pressed in
      // the last 10 % of a step waits for the next one instead)
      pos = beat / arp_step_beats;
      k = floor(pos + 0.000001);
      arp_idx = 0;
      arp_last = pos - k > 0.9 ? k : k - 1;
    );
    arp_key[arp_n] = key;
    arp_vel[arp_n] = vel;
    arp_n += 1;
  );
);

function arp_key_off(key) local(i, j) (
  i = 0; j = 0;
  loop(arp_n,
    arp_key[i] !== key ? (
      arp_key[j] = arp_key[i];
      arp_vel[j] = arp_vel[i];
      j += 1;
    );
    i += 1;
  );
  arp_n = j;
);

function arp_release() local(i) (
  i = 0;
  loop(arp_snd_n, engine_off(arp_snd[i]); i += 1;);
  arp_snd_n = 0;
);

/** play one step: work out the new notes, then hand over from the previous step's notes */
function arp_fire() local(n, m, i, j, len, cycle, oct, k) (
  n = arp_n;
  m = 0;
  arp_mode_i === 6 ? (
    i = 0;
    loop(n, arp_newk[i] = arp_key[i] + transpose_n; arp_newv[i] = arp_vel[i]; i += 1;);
    m = n;
  ) : (
    // order: as played, or sorted low to high (insertion sort keeps equal keys in play order)
    i = 0;
    loop(n,
      j = i;
      arp_mode_i !== 5 ? (
        while (j > 0 && arp_ordk[j - 1] > arp_key[i]) (
          arp_ordk[j] = arp_ordk[j - 1];
          arp_ordv[j] = arp_ordv[j - 1];
          j -= 1;
        );
      );
      arp_ordk[j] = arp_key[i];
      arp_ordv[j] = arp_vel[i];
      i += 1;
    );
    len = n * arp_oct_n;
    arp_mode_i === 2 ? (
      i = len - 1 - (arp_idx % len);
    ) : arp_mode_i === 3 ? (
      len > 1 ? (
        cycle = 2 * len - 2;
        j = arp_idx % cycle;
        i = j < len ? j : cycle - j;
      ) : i = 0;
    ) : arp_mode_i === 4 ? (
      i = min(len - 1, floor(random_unit() * len));
    ) : (
      i = arp_idx % len;
    );
    arp_idx += 1;
    oct = floor(i / n);
    k = i - oct * n;
    arp_newk[0] = arp_ordk[k] + oct * tuning_size + transpose_n;
    arp_newv[0] = arp_ordv[k];
    m = 1;
  );
  // 1. notes struck again are released first (so they restart)
  j = 0;
  loop(arp_snd_n,
    i = 0;
    loop(m,
      arp_snd[j] === arp_newk[i] ? ( engine_off(arp_snd[j]); arp_snd[j] = -1000; );
      i += 1;
    );
    j += 1;
  );
  // 2. new notes, 3. then the rest of the old ones (overlapping, so Legato mode slurs at gate 1)
  i = 0;
  loop(m, engine_on(arp_newk[i], arp_newk[i], arp_newv[i]); i += 1;);
  j = 0;
  loop(arp_snd_n, arp_snd[j] !== -1000 ? engine_off(arp_snd[j]); j += 1;);
  i = 0;
  loop(m, arp_snd[i] = arp_newk[i]; i += 1;);
  arp_snd_n = m;
);

/** once per sample, before the voices render */
function arp_tick() local(pos, k, fired, odd, start, step) (
  pos = beat / arp_step_beats;
  k = floor(pos + 0.000001);
  fired = 0;
  arp_n > 0 && k !== arp_last ? (
    odd = k - 2 * floor(k / 2);
    start = k + odd * arp_swing;
    pos >= start - 0.000001 ? (
      arp_last = k;
      step = k - arp_steps_n * floor(k / arp_steps_n);
      arp_pat[step] ? (
        fired = 1;
        arp_off_pos = start + arp_gate_v * (odd ? 1 - arp_swing : 1 + arp_swing);
        arp_fire();
      );
    );
  );
  // end of the gate (also when the host jumped back, e.g. a loop)
  !fired && arp_snd_n > 0 && (pos >= arp_off_pos - 0.000001 || pos < arp_off_pos - 4) ? arp_release();
);

// ---- MIDI input
function release_all() local(i) (
  i = 0;
  loop(MAX_VOICES, v_gate[i] = 0; v_sus[i] = 0; vcall(i, 2, 0, 0, 0, 0); i += 1;);
  stack_n = 0;
  arp_n = 0;
  arp_snd_n = 0;
);

function note_off(note) (
  arp_mode_i > 0 ? arp_key_off(note) : engine_off(note);
);

function note_on(note, vel) (
  vel <= 0 ? note_off(note)
  : arp_mode_i > 0 ? arp_key_on(note, vel)
  : engine_on(note, note + transpose_n, vel);
);

function sustain(on) local(i) (
  sustain_pedal = on ? 1 : 0;
  !on ? (
    i = 0;
    loop(MAX_VOICES, v_sus[i] ? ( v_sus[i] = 0; vcall(i, 2, 0, 0, 0, 0); ); i += 1;);
  );
);

function handle_midi(m1, m2, m3) local(type) (
  type = m1 & 0xF0;
  type === 0x90 ? note_on(m2, m3)
  : type === 0x80 ? note_off(m2)
  : type === 0xE0 ? bend = clamp(((m3 * 128 + m2) / 8192) - 1, -1, 1)
  : type === 0xB0 ? (
    cc_cutoff_num > 0 && m2 === cc_cutoff_num ? (
      cc_cutoff_value = m3;
      cc_mult = pow(2, clamp((m3 - 64) / 63, -1, 1) * cc_cutoff_depth_oct);
    );
    m2 === 1 ? modwheel = clamp(m3 / 127, 0, 1)
    : m2 === 64 ? sustain(m3 >= 64)
    : m2 === 120 || m2 === 123 ? release_all();
  );
);

@slider
// EDO sliders, the scale file or a shared AmiSynth Tuning slot
tuning_apply();
master_gain = db_to_gain(master_volume_db);
// resonance 0..1 -> SVF damping k 2..0.02
filter_k = 2 - 1.98 * sqrt(clamp(filter_resonance, 0, 1));
lfo.inc = lfo_rate_hz / srate;
lfo_sync_beats = lfo_sync_tab[clamp(floor(lfo_sync + 0.5), 0, 16)];
glide_coef = glide_ms > 0 ? tau_coef(glide_ms / 3) : 0;
glide_legato = glide_mode >= 0.5 ? 1 : 0;
drive_gain = 1 + 8 * filter_drive;
drive_makeup = 1 / (1 + 1.5 * filter_drive);
fm_cycles = fm_index / (2 * $pi);
transpose_n = floor(transpose_semitones + 0.5);
voice_mono = voice_mode >= 0.5 ? 1 : 0;
voice_legato = voice_mode >= 1.5 ? 1 : 0;
noise_type_i = clamp(floor(noise_type + 0.5), 0, 3);
noise_clock = noise_clock_tab[noise_type_i] * pow(2, noise_clock_oct);
noise_filter_i = clamp(floor(noise_filter_mode + 0.5), 0, 3);
cc_cutoff_num = floor(cc_cutoff_number + 0.5);
cc_mult = pow(2, clamp((cc_cutoff_value - 64) / 63, -1, 1) * cc_cutoff_depth_oct);

// unison: copies spread over +/- detune/2 (evenly, or bunched toward the centre by the curve),
// panned evenly; the centre copy (two for an even count) is at full level
unison_n = clamp(floor(unison_voices + 0.5), 1, MAX_UNISON);
wsum = 0;
u = 0;
loop(MAX_UNISON,
  upos = unison_n > 1 ? u / (unison_n - 1) - 0.5 : 0;
  dpos = upos;
  unison_detune_curve > 0 ? dpos = (upos < 0 ? -0.5 : 0.5) * pow(abs(2 * upos), 1 + 2 * unison_detune_curve);
  un_ratio[u] = pow(2, (dpos * unison_detune_cents) / 1200);
  ua = (upos * unison_stereo_width + 0.5) * 0.5 * $pi;
  un_gl[u] = cos(ua) * 1.41421356;
  un_gr[u] = sin(ua) * 1.41421356;
  un_w[u] = abs(u - (unison_n - 1) / 2) < 0.75 ? 1 : unison_side_level;
  u < unison_n ? wsum += un_w[u] * un_w[u];
  u += 1;
);
unison_norm = 1 / sqrt(wsum);
stereo = unison_n > 1 && unison_stereo_width > 0 ? 1 : 0;

// arpeggiator; switching it on or off releases everything so no note is left hanging
arp_mode_i = clamp(floor(arp_mode + 0.5), 0, 6);
arp_mode_i !== arp_cur_mode && (arp_mode_i === 0 || arp_cur_mode === 0) ? release_all();
arp_cur_mode = arp_mode_i;
arp_step_beats = arp_rate_tab[clamp(floor(arp_rate + 0.5), 0, 6)];
arp_oct_n = clamp(floor(arp_octaves + 0.5), 1, 4);
arp_gate_v = clamp(arp_gate, 0.05, 1);
arp_swing = clamp((2 * arp_swing_percent) / 100 - 1, 0, 0.5);
arp_steps_n = clamp(floor(arp_steps + 0.5), 1, 16);
arp_pat[0] = arp_step_1 >= 0.5; arp_pat[1] = arp_step_2 >= 0.5; arp_pat[2] = arp_step_3 >= 0.5; arp_pat[3] = arp_step_4 >= 0.5;
arp_pat[4] = arp_step_5 >= 0.5; arp_pat[5] = arp_step_6 >= 0.5; arp_pat[6] = arp_step_7 >= 0.5; arp_pat[7] = arp_step_8 >= 0.5;
arp_pat[8] = arp_step_9 >= 0.5; arp_pat[9] = arp_step_10 >= 0.5; arp_pat[10] = arp_step_11 >= 0.5; arp_pat[11] = arp_step_12 >= 0.5;
arp_pat[12] = arp_step_13 >= 0.5; arp_pat[13] = arp_step_14 >= 0.5; arp_pat[14] = arp_step_15 >= 0.5; arp_pat[15] = arp_step_16 >= 0.5;

i = 0;
loop(MAX_VOICES, vcall(i, 3, 0, 0, 0, 0); vcall(i, 4, 0, 0, 0, 0); i += 1;);

@block
active_voices = 0; released_voices = 0; meter_i = 0;
loop(MAX_VOICES,
  v_active[meter_i] ? (active_voices += 1; !v_gate[meter_i] ? released_voices += 1;);
  meter_i += 1;
);
midi_queue_read();
// a shared scale (AmiSynth Tuning) changed: retune, sounding notes included
tuning_shared_changed() ? (
  tuning_apply();
  i = 0;
  loop(MAX_VOICES, vcall(i, 4, 0, 0, 0, 0); i += 1;);
);
// host transport (play_state: 1 playing, 5 recording); when stopped the beat keeps counting
tempo > 0 ? beat_inc = tempo / 60 / srate;
play_state & 1 ? beat = beat_position;

@sample
while (midi_pop()) ( handle_midi(midi_m1, midi_m2, midi_m3); );
midi_tick();

arp_mode_i > 0 ? arp_tick();

// global modulation (once per sample)
lfo_sync_beats > 0 ? (
  lph = beat / lfo_sync_beats;
  lph -= floor(lph);
  g_lfo = lfo.lfo_process_at(lfo_waveform, lph);
) : (
  g_lfo = lfo.lfo_process(lfo_waveform);
);
g_pitch_ratio = pow(2, (bend * pitch_bend_range_cents + g_lfo * (lfo_pitch_cents + modwheel * modwheel_vibrato_cents)) / 1200);
g_osc2_cents = osc2_transpose_cents + osc2_detune_cents;
g_osc2_ratio = pow(2, g_osc2_cents / 1200);
g_cutoff = cutoff_smooth.smoother_process(filter_cutoff_hz * cc_mult);
g_lfo_filter_oct = g_lfo * (lfo_filter_oct + modwheel * modwheel_filter_oct);
g_pw1 = clamp(osc1_pulse_width + g_lfo * lfo_pulse_width, 0.02, 0.98);
g_pw2 = clamp(osc2_pulse_width + g_lfo * lfo_pulse_width, 0.02, 0.98);
g_tremolo = 1 - lfo_amp * (0.5 - 0.5 * g_lfo);
g_sync = osc2_hard_sync >= 0.5;

mix_l = 0;
mix_r = 0;
v0.voice_render(); v1.voice_render(); v2.voice_render(); v3.voice_render();
v4.voice_render(); v5.voice_render(); v6.voice_render(); v7.voice_render();

out_gain = gain_smooth.smoother_process(master_gain) * 0.5 * g_tremolo;
spl0 = soft_clip(mix_l * out_gain);
spl1 = soft_clip(mix_r * out_gain);
meter.meter_tick(spl0, spl1);
beat += beat_inc;

@gfx 520 210
meter.meter_draw();
meter.match_request ? (
  master_volume_db = clamp(master_volume_db + meter.correction, -60, 6);
  master_gain = db_to_gain(master_volume_db);
  sliderchange(slider49); slider_automate(slider49);
);
gfx_x = 12; gfx_y = 145;
gfx_printf("Voices %d / %d   released/sustained %d   steals %d", active_voices, voice_limit(), released_voices, voice_steals);
gfx_x = 12; gfx_y = 174;
gfx_drawstr("8-note polyphony; unison copies do not consume note voices.");
