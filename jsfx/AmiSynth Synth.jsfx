    m2 === 1 ? modwheel = clamp(m3 / 127, 0, 1)
    : m2 === 64 ? sustain(m3 >= 64)
    : m2 === 120 || m2 === 123 ? release_all();
  );
);

@slider
// EDO sliders, the scale file or a shared AmiSynth Tuning slot
tuning_apply();
master_gain = db_to_gain(master_volume_db);
// resonance 0..1 -> SVF damping k 2..0.02
filter_k = 2 - 1.98 * sqrt(clamp(filter_resonance, 0, 1));
lfo_inc = lfo_rate_hz / srate;
lfo.inc = lfo_inc;
lfo_sync_beats = lfo_sync_tab[clamp(floor(lfo_sync + 0.5), 0, 16)];
lfo2_inc = lfo2_rate_hz / srate;
lfo2.inc = lfo2_inc;
lfo2_sync_beats = lfo_sync_tab[clamp(floor(lfo2_sync + 0.5), 0, 16)];
// mod matrix: keep only the slots that do something
memset(mm_use, 0, N_SRC);
memset(mm_has, 0, N_DST);
mm_n = 0;
mm_slot(mod1_source, mod1_destination, mod1_amount);
mm_slot(mod2_source, mod2_destination, mod2_amount);
mm_slot(mod3_source, mod3_destination, mod3_amount);
mm_slot(mod4_source, mod4_destination, mod4_amount);
glide_coef = glide_ms > 0 ? tau_coef(glide_ms / 3) : 0;
glide_legato = glide_mode >= 0.5 ? 1 : 0;
drive_gain = 1 + 8 * filter_drive;
drive_makeup = 1 / (1 + 1.5 * filter_drive);
fm_cycles = fm_index / (2 * $pi);
transpose_n = floor(transpose_semitones + 0.5);
voice_mono = voice_mode >= 0.5 ? 1 : 0;
voice_legato = voice_mode >= 1.5 ? 1 : 0;
// wavetable oscillators: build the selected banks (once; the tables do not depend on srate)
wt_osc1 = osc1_waveform >= 3.5 ? 1 : 0;
wt_osc2 = osc2_waveform >= 3.5 ? 1 : 0;
wt_bank1_i = clamp(floor(osc1_wt_bank + 0.5), 0, WT_BANKS - 1);
wt_bank2_i = clamp(floor(osc2_wt_bank + 0.5), 0, WT_BANKS - 1);
wt_osc1 ? wt_build(wt_bank1_i);
wt_osc2 ? wt_build(wt_bank2_i);
noise_type_i = clamp(floor(noise_type + 0.5), 0, 7);
noise_clock = noise_type_i < 4 ? noise_clock_tab[noise_type_i] * pow(2, noise_clock_oct) : 0;
sfx_rate = pow(2, noise_clock_oct);
sfx_a1 = 1 - exp(-2 * $pi * (noise_type_i === 4 ? 400 : noise_type_i === 5 ? 6000 : noise_type_i === 7 ? 8000 : noise_type_i === 6 ? 3500 : 700) / srate);
sfx_a2 = 1 - exp(-2 * $pi * (noise_type_i === 4 ? 2800 : noise_type_i === 5 ? 1200 : 400) / srate);
sfx_clap_decay = exp(-1 / (0.006 * srate));
sfx_clap_attack = 1 - exp(-1 / (0.00035 * srate));
sfx_drop_decay = exp(-1 / (0.006 * srate));
noise_filter_i = clamp(floor(noise_filter_mode + 0.5), 0, 3);
cc_cutoff_num = floor(cc_cutoff_number + 0.5);
cc_mult = pow(2, clamp((cc_cutoff_value - 64) / 63, -1, 1) * cc_cutoff_depth_oct);

// unison: copies spread over +/- detune/2 (evenly, or bunched toward the centre by the curve),
// panned evenly; the centre copy (two for an even count) is at full level
unison_n = clamp(floor(unison_voices + 0.5), 1, MAX_UNISON);
wsum = 0;
u = 0;
loop(MAX_UNISON,
  upos = unison_n > 1 ? u / (unison_n - 1) - 0.5 : 0;
  dpos = upos;
  unison_detune_curve > 0 ? dpos = (upos < 0 ? -0.5 : 0.5) * pow(abs(2 * upos), 1 + 2 * unison_detune_curve);
  un_ratio[u] = pow(2, (dpos * unison_detune_cents) / 1200);
  ua = (upos * unison_stereo_width + 0.5) * 0.5 * $pi;
  un_gl[u] = cos(ua) * 1.41421356;
  un_gr[u] = sin(ua) * 1.41421356;
  un_w[u] = abs(u - (unison_n - 1) / 2) < 0.75 ? 1 : unison_side_level;
  u < unison_n ? wsum += un_w[u] * un_w[u];
  u += 1;
);
unison_norm = 1 / sqrt(wsum);
stereo = unison_n > 1 && unison_stereo_width > 0 ? 1 : 0;

// arpeggiator; switching it on or off releases everything so no note is left hanging
arp_mode_i = clamp(floor(arp_mode + 0.5), 0, 6);
arp_mode_i !== arp_cur_mode && (arp_mode_i === 0 || arp_cur_mode === 0) ? release_all();
arp_cur_mode = arp_mode_i;
arp_step_beats = arp_rate_tab[clamp(floor(arp_rate + 0.5), 0, 6)];
arp_oct_n = clamp(floor(arp_octaves + 0.5), 1, 4);
arp_gate_v = clamp(arp_gate, 0.05, 1);
arp_swing = clamp((2 * arp_swing_percent) / 100 - 1, 0, 0.5);
arp_steps_n = clamp(floor(arp_steps + 0.5), 1, 16);
arp_pat[0] = arp_step_1 >= 0.5; arp_pat[1] = arp_step_2 >= 0.5; arp_pat[2] = arp_step_3 >= 0.5; arp_pat[3] = arp_step_4 >= 0.5;
arp_pat[4] = arp_step_5 >= 0.5; arp_pat[5] = arp_step_6 >= 0.5; arp_pat[6] = arp_step_7 >= 0.5; arp_pat[7] = arp_step_8 >= 0.5;
arp_pat[8] = arp_step_9 >= 0.5; arp_pat[9] = arp_step_10 >= 0.5; arp_pat[10] = arp_step_11 >= 0.5; arp_pat[11] = arp_step_12 >= 0.5;
arp_pat[12] = arp_step_13 >= 0.5; arp_pat[13] = arp_step_14 >= 0.5; arp_pat[14] = arp_step_15 >= 0.5; arp_pat[15] = arp_step_16 >= 0.5;

// effects; switching one on clears its memory, so no stale tail from earlier comes back
fx_on = fx_chorus_on >= 0.5 ? 1 : 0;
fx_on && !fx_chorus_i ? fxc.chorus_clear();
fx_chorus_i = fx_on;
chorus_base = 7 * 0.001 * srate;
chorus_depth = clamp(fx_chorus_depth_ms, 0, 8) * 0.001 * srate;
chorus_inc = fx_chorus_rate_hz / srate;
fx_on = fx_delay_on >= 0.5 ? 1 : 0;
delay_sync_beats = delay_sync_tab[clamp(floor(fx_delay_sync + 0.5), 0, 14)];
delay_fb = clamp(fx_delay_feedback, 0, 0.95);
delay_a = 1 - exp((-2 * $pi * clamp(fx_delay_high_cut_hz, 20, srate * 0.49)) / srate);
delay_pp = fx_delay_ping_pong >= 0.5 ? 1 : 0;
delay_retime();
fx_on && !fx_delay_i ? (
  fxd.echo_clear();
  delay_d = delay_target; // start at the right time instead of gliding to it
);
fx_delay_i = fx_on;
fx_on = fx_reverb_on >= 0.5 ? 1 : 0;
fx_on && !fx_reverb_i ? fxr.reverb_clear();
fx_reverb_i = fx_on;
fxr.reverb_set(0.5 + 1.5 * clamp(fx_reverb_size, 0, 1), fx_reverb_decay_ms, 1 - 0.8 * clamp(fx_reverb_damping, 0, 1));

i = 0;
loop(MAX_VOICES, vcall(i, 3, 0, 0, 0, 0); vcall(i, 4, 0, 0, 0, 0); i += 1;);

@block
active_voices = 0; released_voices = 0; meter_i = 0;
loop(MAX_VOICES,
  v_active[meter_i] ? (active_voices += 1; !v_gate[meter_i] ? released_voices += 1;);
  meter_i += 1;
);
midi_queue_read();
// a shared scale (AmiSynth Tuning) changed: retune, sounding notes included
tuning_shared_changed() ? (
  tuning_apply();
  i = 0;
  loop(MAX_VOICES, vcall(i, 4, 0, 0, 0, 0); i += 1;);
);
// host transport (play_state: 1 playing, 5 recording); when stopped the beat keeps counting
tempo > 0 ? (
  beat_inc = tempo / 60 / srate;
  host_tempo = tempo;
  delay_retime(); // a synced delay follows tempo changes (gliding)
);
play_state & 1 ? beat = beat_position;

@sample
while (midi_pop()) ( handle_midi(midi_m1, midi_m2, midi_m3); );
midi_tick();

arp_mode_i > 0 ? arp_tick();

// global modulation (once per sample)
lfo_sync_beats > 0 ? (
  lph = beat / lfo_sync_beats;
  lph -= floor(lph);
  g_lfo = lfo.lfo_process_at(lfo_waveform, lph);
) : (
  g_lfo = lfo.lfo_process(lfo_waveform);
);
// mod matrix, global part: LFO 1 / LFO 2 / mod wheel for every destination, channel pressure for
// the global ones (LFO rates, which take effect from the next sample)
mm_n > 0 ? (
  g_lfo2 = mm_use[2] ? lfo2.lfo2_tick(lfo2_waveform) : 0;
  mm_use[7] ? press_g += (pressure - press_g) * press_a;
  memset(mm_g, 0, N_DST);
  j = 0;
  loop(mm_n,
    src = mm_src[j];
    dst = mm_dst[j];
    src === 1 ? mm_g[dst] += g_lfo * mm_amt[j]
    : src === 2 ? mm_g[dst] += g_lfo2 * mm_amt[j]
    : src === 6 ? mm_g[dst] += modwheel * mm_amt[j]
    : src === 7 && dst >= 9 && dst <= 10 ? mm_g[dst] += press_g * mm_amt[j];
    j += 1;
  );
  // total rate offset limited to +/- 6 oct (= LFO_RATE_MOD_OCT in synth.js): 2^4800 would leave the phase at inf
  mm_has[9] ? lfo.inc = lfo_inc * pow(2, clamp(mm_g[9], -6, 6));
  mm_has[10] ? lfo2.inc = lfo2_inc * pow(2, clamp(mm_g[10], -6, 6));
);
m_pitch = mm_n > 0 && mm_has[1];
m_res = mm_n > 0 && mm_has[3];
m_pw = mm_n > 0 && mm_has[4];
m_osc2 = mm_n > 0 && mm_has[5];
m_fm = mm_n > 0 && mm_has[6];
m_amp = mm_n > 0 && mm_has[7];
m_pan = mm_n > 0 && mm_has[8];
m_noise = mm_n > 0 && mm_has[11];
m_press = mm_n > 0 && mm_use[7];
g_pitch_ratio = pow(2, (bend * pitch_bend_range_cents + g_lfo * (lfo_pitch_cents + modwheel * modwheel_vibrato_cents)) / 1200);
g_osc2_cents = osc2_transpose_cents + osc2_detune_cents;
g_osc2_ratio = pow(2, g_osc2_cents / 1200);
g_cutoff = cutoff_smooth.smoother_process(filter_cutoff_hz * cc_mult);
g_lfo_filter_oct = g_lfo * (lfo_filter_oct + modwheel * modwheel_filter_oct);
g_pw1 = clamp(osc1_pulse_width + g_lfo * lfo_pulse_width, 0.02, 0.98);
g_pw2 = clamp(osc2_pulse_width + g_lfo * lfo_pulse_width, 0.02, 0.98);
g_tremolo = 1 - lfo_amp * (0.5 - 0.5 * g_lfo);
g_sync = osc2_hard_sync >= 0.5;
g_wt_lfo = g_lfo * wt_position_lfo;

mix_l = 0;
mix_r = 0;
v0.voice_render(); v1.voice_render(); v2.voice_render(); v3.voice_render();
v4.voice_render(); v5.voice_render(); v6.voice_render(); v7.voice_render();

out_gain = gain_smooth.smoother_process(master_gain) * 0.5 * g_tremolo;
fx_l = mix_l * out_gain;
fx_r = mix_r * out_gain;

// effects: chorus -> delay -> reverb, each a dry/wet crossfade
fx_chorus_i ? (
  fxc.chorus_process(fx_l, fx_r, chorus_base, chorus_depth, chorus_inc);
  fx_l = fx_l * (1 - fx_chorus_mix) + fxc.l * fx_chorus_mix;
  fx_r = fx_r * (1 - fx_chorus_mix) + fxc.r * fx_chorus_mix;
);
fx_delay_i ? (
  delay_d = delay_target + delay_coef * (delay_d - delay_target);
  fxd.echo_process(fx_l, fx_r, delay_d, delay_fb, delay_a, delay_pp);
  fx_l = fx_l * (1 - fx_delay_mix) + fxd.l * fx_delay_mix;
  fx_r = fx_r * (1 - fx_delay_mix) + fxd.r * fx_delay_mix;
);
fx_reverb_i ? (
  fxr.reverb_process(fx_l, fx_r);
  fx_l = fx_l * (1 - fx_reverb_mix) + fxr.l * fx_reverb_mix;
  fx_r = fx_r * (1 - fx_reverb_mix) + fxr.r * fx_reverb_mix;
);

spl0 = soft_clip(fx_l);
spl1 = soft_clip(fx_r);
meter.meter_tick(spl0, spl1);
beat += beat_inc;

@gfx 520 210
meter.meter_draw();
meter.match_request ? (
  master_volume_db = clamp(master_volume_db + meter.correction, -60, 6);
  master_gain = db_to_gain(master_volume_db);
  sliderchange(slider49); slider_automate(slider49);
);
gfx_x = 12; gfx_y = 145;
gfx_printf("Voices %d / %d   released/sustained %d   steals %d", active_voices, voice_limit(), released_voices, voice_steals);
gfx_x = 12; gfx_y = 174;
gfx_drawstr("8-note polyphony; unison copies do not consume note voices.");
