/** 8-way dispatch (EEL2 has no arrays of namespaces) */
function vcall(i, op, a, b, c, d) (
  i === 0 ? v0.voice_op(op, a, b, c, d) : i === 1 ? v1.voice_op(op, a, b, c, d) :
  i === 2 ? v2.voice_op(op, a, b, c, d) : i === 3 ? v3.voice_op(op, a, b, c, d) :
  i === 4 ? v4.voice_op(op, a, b, c, d) : i === 5 ? v5.voice_op(op, a, b, c, d) :
  i === 6 ? v6.voice_op(op, a, b, c, d) : v7.voice_op(op, a, b, c, d);
);

i = 0;
loop(MAX_VOICES,
  vcall(i, 0, i, 0, 0, 0);
  v_active[i] = 0; v_note[i] = -1; v_pitch[i] = 0; v_gate[i] = 0; v_sus[i] = 0; v_age[i] = 0;
  i += 1;
);

// ---- voice engine (poly): voices answer to `key`, sound at `pitch`
function voice_limit() ( clamp(floor(voice_count + 0.5), 1, MAX_VOICES); );

function voice_allocate() local(n, i, best, best_score, score, found) (
  n = voice_limit();
  best = -1; best_score = -1; found = -1;
  i = 0;
  while (i < n && found < 0) (
    !v_active[i] ? found = i : (
      // prefer stealing released voices, then the oldest
      score = (v_gate[i] ? 0 : 1000000000000) + (age_counter - v_age[i]);
      score > best_score ? ( best_score = score; best = i; );
    );
    i += 1;
  );
  found < 0 ? voice_steals += 1;
  found >= 0 ? found : best;
