function arp_key_off(key) local(i, j) (
  i = 0; j = 0;
  loop(arp_n,
    arp_key[i] !== key ? (
      arp_key[j] = arp_key[i];
      arp_vel[j] = arp_vel[i];
      j += 1;
    );
    i += 1;
  );
  arp_n = j;
);

function arp_release() local(i) (
  i = 0;
  loop(arp_snd_n, engine_off(arp_snd[i]); i += 1;);
  arp_snd_n = 0;
);

/** play one step: work out the new notes, then hand over from the previous step's notes */
function arp_fire() local(n, m, i, j, len, cycle, oct, k) (
  n = arp_n;
  m = 0;
  arp_mode_i === 6 ? (
    i = 0;
    loop(n, arp_newk[i] = arp_key[i] + transpose_n; arp_newv[i] = arp_vel[i]; i += 1;);
    m = n;
  ) : (
    // order: as played, or sorted low to high (insertion sort keeps equal keys in play order)
    i = 0;
    loop(n,
      j = i;
      arp_mode_i !== 5 ? (
        while (j > 0 && arp_ordk[j - 1] > arp_key[i]) (
          arp_ordk[j] = arp_ordk[j - 1];
          arp_ordv[j] = arp_ordv[j - 1];
          j -= 1;
        );
      );
      arp_ordk[j] = arp_key[i];
      arp_ordv[j] = arp_vel[i];
      i += 1;
    );
    len = n * arp_oct_n;
    arp_mode_i === 2 ? (
      i = len - 1 - (arp_idx % len);
    ) : arp_mode_i === 3 ? (
      len > 1 ? (
        cycle = 2 * len - 2;
        j = arp_idx % cycle;
        i = j < len ? j : cycle - j;
      ) : i = 0;
    ) : arp_mode_i === 4 ? (
      i = min(len - 1, floor(random_unit() * len));
    ) : (
      i = arp_idx % len;
    );
    arp_idx += 1;
    oct = floor(i / n);
    k = i - oct * n;
    arp_newk[0] = arp_ordk[k] + oct * tuning_size + transpose_n;
    arp_newv[0] = arp_ordv[k];
    m = 1;
  );
