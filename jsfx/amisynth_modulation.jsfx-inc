// Generated by npm run gen:jsfx. Display hints only; slider values keep their original domain.
@init
function mod_amount_draw(slot, dest, amount) local(r, step) (
  dest === 0 ? (#mod_dest = "Off"; #mod_unit = ""; r = 1; step = 0.001;) :
  dest === 1 ? (#mod_dest = "Pitch"; #mod_unit = "cents"; r = 2400; step = 0.1;) :
  dest === 2 ? (#mod_dest = "Filter Cutoff"; #mod_unit = "oct"; r = 8; step = 0.01;) :
  dest === 3 ? (#mod_dest = "Filter Resonance"; #mod_unit = ""; r = 1; step = 0.001;) :
  dest === 4 ? (#mod_dest = "Pulse Width"; #mod_unit = ""; r = 0.45; step = 0.001;) :
  dest === 5 ? (#mod_dest = "Osc2 Pitch"; #mod_unit = "cents"; r = 4800; step = 1;) :
  dest === 6 ? (#mod_dest = "FM Index"; #mod_unit = "rad"; r = 10; step = 0.01;) :
  dest === 7 ? (#mod_dest = "Amp"; #mod_unit = "dB"; r = 48; step = 0.1;) :
  dest === 8 ? (#mod_dest = "Pan"; #mod_unit = ""; r = 1; step = 0.001;) :
  dest === 9 ? (#mod_dest = "LFO 1 Rate"; #mod_unit = "oct"; r = 6; step = 0.01;) :
  dest === 10 ? (#mod_dest = "LFO 2 Rate"; #mod_unit = "oct"; r = 6; step = 0.01;) :
  dest === 11 ? (#mod_dest = "Noise Level"; #mod_unit = ""; r = 1; step = 0.001;) :
  dest === 12 ? (#mod_dest = "Osc1 WT Position"; #mod_unit = "position"; r = 1; step = 0.001;) :
  dest === 13 ? (#mod_dest = "Osc2 WT Position"; #mod_unit = "position"; r = 1; step = 0.001;);
  sprintf(#mod_amount_text, "Mod %d %s: %.6g %s (suggested +/-%.3g; step %.3g)", slot, #mod_dest, amount, #mod_unit, r, step);
  gfx_set(0.8, 0.85, 0.9, 1); gfx_x = 8; gfx_y = 210 + (slot - 1) * 16; gfx_drawstr(#mod_amount_text);
);
