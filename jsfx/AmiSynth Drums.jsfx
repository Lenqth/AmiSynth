import amisynth_lib.jsfx-inc
import amisynth_meter.jsfx-inc

in_pin:none
// 1/2 = main mix; 3..10 = one stereo pair per group of parts (always on; the *_bus_in_main
// sliders decide whether a group is also in the main mix). Give the track 10 channels to use them.
out_pin:Main L
out_pin:Main R
out_pin:Kick L
out_pin:Kick R
out_pin:Snare/Clap/Rim L
out_pin:Snare/Clap/Rim R
out_pin:Hats/Cymbals L
out_pin:Hats/Cymbals R
out_pin:Toms/Perc L
out_pin:Toms/Perc R

@init
meter.meter_init();
kick_meter.meter_init(); snare_meter.meter_init(); hats_meter.meter_init(); perc_meter.meter_init();
noise_seed(12345);

// ---- metallic cymbal circuit: 6 detuned squares (808 ratios) + noise -> BP -> HP
function hat_init() instance(value choke vel mul) (
  mul = 1;
  this.o0.phase = random_unit(); this.o1.phase = random_unit(); this.o2.phase = random_unit();
  this.o3.phase = random_unit(); this.o4.phase = random_unit(); this.o5.phase = random_unit();
  this.env.value = 0;
  choke = 0;
);

// square cluster at the hat's pitch times its variant multiplier
function hat_tune() instance(pitch_hz mul) local(f) (
  f = pitch_hz * mul;
  this.o0.inc = clamp((f * 1) / srate, 0, 0.49);
  this.o1.inc = clamp((f * 1.4827) / srate, 0, 0.49);
  this.o2.inc = clamp((f * 1.8003) / srate, 0, 0.49);
  this.o3.inc = clamp((f * 2.546) / srate, 0, 0.49);
  this.o4.inc = clamp((f * 2.6303) / srate, 0, 0.49);
  this.o5.inc = clamp((f * 3.8967) / srate, 0, 0.49);
);

function hat_update(pitch, tone, level_db, pan, bp_hz, hp_base_hz) instance(gain pitch_hz) (
  this.pan_gains(pan);
  gain = db_to_gain(level_db);
  pitch_hz = pitch;
  this.hat_tune();
  this.hp.svf_set(hp_base_hz * pow(4, tone), 1.2);
  this.bp.svf_set(bp_hz, 1.0);
);

function hat_trigger(vgain, decay_ms) instance(vel choke) (
  vel = vgain;
  choke = 0;
  this.env.decay_env_trigger(1, decay_ms);
);

function hat_render(metal_mix) instance(vel gain choke choke_coef) local(metal, x) (
  this.env.value === 0 ? 0 : (
    choke ? this.env.value *= choke_coef;
    metal = this.o0.square_naive_process() + this.o1.square_naive_process() + this.o2.square_naive_process()
          + this.o3.square_naive_process() + this.o4.square_naive_process() + this.o5.square_naive_process();
    x = metal * (1 / 6) * metal_mix + noise_white() * (1 - metal_mix);
    this.bp.svf_process(x);
    this.hp.svf_process(this.bp.bp);
    this.hp.hp * this.env.decay_env_process() * vel * gain * 3;
  );
);

// ---- tom: sine with a short downward bend + stick noise
function tom_update(level_db, pan) instance(gain pitch_coef) (
  this.pan_gains(pan);
  gain = db_to_gain(level_db);
  pitch_coef = tau_coef(40);
  this.hp.onepole_set(1500);
);

function tom_trigger(vgain, decay_ms) instance(vel pitch_env) (
  this.osc.phase = 0;
  pitch_env = 1;
  vel = vgain;
  this.env.decay_env_trigger(1, decay_ms);
  this.noise_env.decay_env_trigger(1, 25);
);

function tom_render(pitch_hz, tone) instance(vel gain pitch_env pitch_coef mul) local(body, stick) (
  this.env.value === 0 ? 0 : (
    this.osc.inc = (pitch_hz * mul * pow(2, tone * pitch_env)) / srate;
    pitch_env *= pitch_coef;
    body = this.osc.sine_process() * this.env.decay_env_process();
    stick = this.hp.onepole_hp(noise_white()) * this.noise_env.decay_env_process() * tone * 0.4;
    (body + stick) * vel * gain;
  );
);

// ---- GM percussion: hand drum (conga / bongo / timbale): sine + second mode bent up at the
// slap, plus slap noise. ratio / share = second mode ratio and its decay share.
function hand_set(level_db, pan, pitch, tone, decay_ms, ratio, share, hp_hz) instance(gain hz tn dms mul dmul lmul rt sh) (
  this.pan_gains(pan);
  gain = db_to_gain(level_db) * lmul;
  hz = pitch * mul;
  tn = tone;
  dms = decay_ms * dmul;
  rt = ratio;
  sh = share;
  this.hp.onepole_set(hp_hz);
);

function hand_trigger(vgain) instance(vel pitch_env dms sh) (
  this.osc.phase = 0;
  this.osc2.phase = 0;
  pitch_env = 1;
  vel = vgain;
  this.env.decay_env_trigger(1, dms);
  this.env2.decay_env_trigger(1, dms * sh);
  this.noise_env.decay_env_trigger(1, 15);
);

function hand_render() instance(vel gain hz tn rt pitch_env) local(f, body, slap) (
  this.env.value === 0 ? 0 : (
    f = hz * pow(2, 0.5 * tn * pitch_env);
    pitch_env *= hand_pitch_coef;
    this.osc.inc = clamp(f / srate, 0, 0.49);
    this.osc2.inc = clamp((f * rt) / srate, 0, 0.49);
    body = this.osc.sine_process() * this.env.decay_env_process() + 0.35 * this.osc2.sine_process() * this.env2.decay_env_process();
    slap = this.hp.onepole_hp(noise_white()) * this.noise_env.decay_env_process() * tn * 0.5;
    (body + slap) * vel * gain;
  );
);

// ---- agogo bell: two band-passed squares
function bell_set() instance(gain mul lmul dmul) local(f) (
  this.pan_gains(agogo_pan);
  gain = db_to_gain(agogo_level_db) * lmul;
  f = agogo_pitch_hz * mul;
  this.osc1.inc = clamp(f / srate, 0, 0.49);
  this.osc2.inc = clamp((f * 1.6) / srate, 0, 0.49);
  this.bp.svf_set(f * 1.3 * pow(3, agogo_tone), 0.8);
);

function bell_trigger(vgain) instance(vel dmul) (
  vel = vgain;
  this.fast.decay_env_trigger(1, 25);
  this.slow.decay_env_trigger(1, agogo_decay_ms * dmul);
);

function bell_render() instance(vel gain) local(env) (
  this.slow.value === 0 ? 0 : (
    env = 0.5 * this.fast.decay_env_process() + 0.5 * this.slow.decay_env_process();
    this.bp.svf_process((this.osc1.square_naive_process() + this.osc2.square_naive_process()) * 0.5);
    this.bp.bp * env * vel * gain * 2;
  );
);

// ---- claves / wood block: sine + wood bar mode (2.76x) + click
function knock_set() instance(gain mul lmul) local(f) (
  this.pan_gains(claves_pan);
  gain = db_to_gain(claves_level_db) * lmul;
  f = claves_pitch_hz * mul;
  this.osc.inc = clamp(f / srate, 0, 0.49);
  this.osc2.inc = clamp((f * 2.76) / srate, 0, 0.49);
  this.hp.onepole_set(3000);
);

function knock_trigger(vgain) instance(vel dmul) local(ms) (
  this.osc.phase = 0;
  this.osc2.phase = 0;
  vel = vgain;
  ms = claves_decay_ms * dmul;
  this.env.decay_env_trigger(1, ms);
  this.env2.decay_env_trigger(1, ms * 0.4);
  this.click.decay_env_trigger(1, 2);
);

function knock_render() instance(vel gain) local(body, click) (
  this.env.value === 0 ? 0 : (
    body = this.osc.sine_process() * this.env.decay_env_process() + 0.4 * claves_tone * this.osc2.sine_process() * this.env2.decay_env_process();
    click = this.hp.onepole_hp(noise_white()) * this.click.decay_env_process() * claves_tone * 0.6;
    (body + click) * vel * gain * 1.2;
  );
);

// variant voices: pitch / decay / level multipliers (GM_DRUM_VARIANTS in params.js)
function variant(m, dm, lm) instance(mul dmul lmul) ( mul = m; dmul = dm; lmul = lm; );

closed_hat.hat_init();
open_hat.hat_init();
crash.hat_init();
ride.hat_init();
clap.t = -1;
low_tom.mul = 1; mid_tom.mul = 1; high_tom.mul = 1;
tambourine.hat_init();
crash2.hat_init();
ride2.hat_init();
floor_tom_low.mul = 0.75; floor_tom_low.dmul = 1.15;
floor_tom_high.mul = 0.87; floor_tom_high.dmul = 1.1;
hi_mid_tom.mul = 1.2; hi_mid_tom.dmul = 1;
hand60.variant(2, 0.6, 0.9);
hand61.variant(1.5, 0.7, 0.9);
hand62.variant(1.05, 0.25, 1);
hand63.variant(1, 1, 1);
hand64.variant(0.75, 1.2, 1);
hand65.variant(1, 1, 1);
hand66.variant(0.78, 1.1, 1);
bell67.variant(1, 1, 1);
bell68.variant(0.75, 1, 1);
knock75.variant(1, 1, 1);
knock76.variant(0.62, 0.6, 1);
knock77.variant(0.47, 0.6, 1);
tri_r0 = 1; tri_r1 = 2.05; tri_r2 = 3.13; tri_r3 = 4.27; tri_r4 = 5.4;

function cymbal_variant(note) local(m, dm, lm) (
  // china / splash / crash 2 share one voice, bell / ride 2 another, retuned per note
  note === 52 ? (m = 0.8; dm = 0.8; lm = 1;)
  : note === 55 ? (m = 1.45; dm = 0.3; lm = 0.9;)
  : note === 57 ? (m = 1.1; dm = 1; lm = 1;)
  : note === 53 ? (m = 1.55; dm = 0.7; lm = 1;)
  : (m = 0.92; dm = 1; lm = 1;);
  note === 53 || note === 59 ? (
    ride2.mul = m;
    ride2.hat_tune();
    ride2.hat_trigger(vg * lm, ride_decay_ms * dm);
  ) : (
    crash2.mul = m;
    crash2.hat_tune();
    crash2.hat_trigger(vg * lm, crash_decay_ms * dm);
  );
);

function note_on(note, velocity) local(vel, vgain, dmul, ms) (
  vel = clamp(velocity / 127, 0, 1);
  vgain = 0.2 + 0.8 * vel * vel;
  dmul = 1;
  // variants that retrigger the part itself
  note === 35 ? (note = 36)
  : note === 40 ? (note = 38)
  : note === 69 ? (note = 70)
  : note === 44 ? (note = 42; vgain *= 0.6; dmul = 0.8;);
  note === 36 ? (
    kick.osc.phase = 0;
    kick.pitch_env = 1;
    kick.vel = vgain;
    kick.env.decay_env_trigger(1, kick_decay_ms);
    kick.click.decay_env_trigger(1, 4);
  ) : note === 38 ? (
    snare.osc1.phase = 0;
    snare.osc2.phase = 0;
    snare.pitch_env = 1;
    snare.pitch_coef = tau_coef(15);
    snare.vel = vgain;
    snare.body_env.decay_env_trigger(1, min(snare_decay_ms, 180));
    snare.noise_env.decay_env_trigger(1, snare_decay_ms);
  ) : note === 39 ? (
    clap.t = 0;
    clap.tail = 0;
    clap.vel = vgain;
    clap.bp.svf_reset();
  ) : note === 42 ? (
    // choke: the closed hat fades the open hat out within a few ms
    open_hat.choke = 1;
    open_hat.choke_coef = t60_coef(8);
    closed_hat.hat_trigger(vgain, closed_hat_decay_ms * dmul);
  ) : note === 46 ? (
    open_hat.hat_trigger(vgain, open_hat_decay_ms);
  ) : note === 49 ? (
    crash.hat_trigger(vgain, crash_decay_ms);
  ) : note === 51 ? (
    ride.hat_trigger(vgain, ride_decay_ms);
  ) : note === 45 ? (
    low_tom.tom_trigger(vgain, low_tom_decay_ms);
  ) : note === 47 ? (
    mid_tom.tom_trigger(vgain, mid_tom_decay_ms);
  ) : note === 50 ? (
    high_tom.tom_trigger(vgain, high_tom_decay_ms);
  ) : note === 37 ? (
    rimshot.osc1.phase = 0;
    rimshot.osc2.phase = 0;
    rimshot.vel = vgain;
    rimshot.env.decay_env_trigger(1, rimshot_decay_ms);
    rimshot.click.decay_env_trigger(1, 3);
  ) : note === 56 ? (
    cowbell.vel = vgain;
    cowbell.fast.decay_env_trigger(1, 40);
    cowbell.slow.decay_env_trigger(1, cowbell_decay_ms);
  ) : note === 70 ? (
    shaker.vel = vgain;
    shaker.attack = 0;
    shaker.env.decay_env_trigger(1, shaker_decay_ms);
  ) : note === 41 ? (
    floor_tom_low.tom_trigger(vgain, low_tom_decay_ms * floor_tom_low.dmul);
  ) : note === 43 ? (
    floor_tom_high.tom_trigger(vgain, low_tom_decay_ms * floor_tom_high.dmul);
  ) : note === 48 ? (
    hi_mid_tom.tom_trigger(vgain, mid_tom_decay_ms * hi_mid_tom.dmul);
  ) : note === 52 || note === 55 || note === 57 || note === 53 || note === 59 ? (
    vg = vgain;
    cymbal_variant(note);
  ) : note === 54 ? (
    tambourine.hat_trigger(vgain, tambourine_decay_ms);
  ) : note === 60 ? hand60.hand_trigger(vgain)
  : note === 61 ? hand61.hand_trigger(vgain)
  : note === 62 ? hand62.hand_trigger(vgain)
  : note === 63 ? hand63.hand_trigger(vgain)
  : note === 64 ? hand64.hand_trigger(vgain)
  : note === 65 ? hand65.hand_trigger(vgain)
  : note === 66 ? hand66.hand_trigger(vgain)
  : note === 67 ? bell67.bell_trigger(vgain)
  : note === 68 ? bell68.bell_trigger(vgain)
  : note === 75 ? knock75.knock_trigger(vgain)
  : note === 76 ? knock76.knock_trigger(vgain)
  : note === 77 ? knock77.knock_trigger(vgain)
  : note === 80 || note === 81 ? (
    // one voice: the mute triangle (80) cuts the open one short
    tri0.phase = 0; tri1.phase = 0; tri2.phase = 0; tri3.phase = 0; tri4.phase = 0;
    triangle.vel = vgain;
    ms = max(30, triangle_decay_ms * (note === 80 ? 0.05 : 1));
    triangle.env.decay_env_trigger(1, ms);
    triangle.env2.decay_env_trigger(1, ms * 0.5);
    triangle.click.decay_env_trigger(1, 3);
  );
);

@slider
master_gain = db_to_gain(drum_master_volume_db);
main_kick = kick_bus_in_main >= 0.5 ? 1 : 0;
main_snare = snare_bus_in_main >= 0.5 ? 1 : 0;
main_hats = hats_bus_in_main >= 0.5 ? 1 : 0;
main_perc = perc_bus_in_main >= 0.5 ? 1 : 0;

kick.pan_gains(kick_pan);
kick.gain = db_to_gain(kick_level_db);
kick.pitch_coef = tau_coef(kick_sweep_ms);
kick.click_hp.onepole_set(2000 + 8000 * kick_tone);

snare.pan_gains(snare_pan);
snare.gain = db_to_gain(snare_level_db);
snare.bp.svf_set(1500 * pow(6, snare_tone), 1.2); // noise band 1.5 .. 9 kHz
snare.hp.onepole_set(400);

clap.pan_gains(clap_pan);
clap.gain = db_to_gain(clap_level_db);
clap.bp.svf_set(clap_pitch_hz, 2 - 1.75 * clap_tone);
clap.spread = max(1, floor(clap_spread_ms * 0.001 * srate + 0.5));
clap.burst_coef = t60_coef(clap_spread_ms * 0.9);
clap.tail_coef = t60_coef(clap_decay_ms);

closed_hat.hat_update(closed_hat_pitch_hz, closed_hat_tone, closed_hat_level_db, closed_hat_pan, 10000, 3000);
open_hat.hat_update(open_hat_pitch_hz, open_hat_tone, open_hat_level_db, open_hat_pan, 10000, 3000);
crash.hat_update(crash_pitch_hz, crash_tone, crash_level_db, crash_pan, 6500, 1500);
ride.hat_update(ride_pitch_hz, ride_tone, ride_level_db, ride_pan, 8000, 2000);

low_tom.tom_update(low_tom_level_db, low_tom_pan);
mid_tom.tom_update(mid_tom_level_db, mid_tom_pan);
high_tom.tom_update(high_tom_level_db, high_tom_pan);

rimshot.pan_gains(rimshot_pan);
rimshot.gain = db_to_gain(rimshot_level_db);
rimshot.osc1.inc = clamp(rimshot_pitch_hz / srate, 0, 0.49);
rimshot.osc2.inc = clamp((rimshot_pitch_hz * 0.27) / srate, 0, 0.49);
rimshot.hp.onepole_set(3000);

cowbell.pan_gains(cowbell_pan);
cowbell.gain = db_to_gain(cowbell_level_db);
cowbell.osc1.inc = clamp(cowbell_pitch_hz / srate, 0, 0.49);
cowbell.osc2.inc = clamp((cowbell_pitch_hz * 1.4815) / srate, 0, 0.49);
cowbell.bp.svf_set(cowbell_pitch_hz * 1.6 * pow(3, cowbell_tone), 1.0);

shaker.pan_gains(shaker_pan);
shaker.gain = db_to_gain(shaker_level_db);
shaker.bp.svf_set(shaker_pitch_hz, 1.0);
shaker.attack_inc = 1 / ((1 + 40 * shaker_tone) * 0.001 * srate);

// GM percussion
tambourine.hat_update(tambourine_pitch_hz, tambourine_tone, tambourine_level_db, tambourine_pan, 9000, 4000);
floor_tom_low.tom_update(low_tom_level_db, low_tom_pan);
floor_tom_high.tom_update(low_tom_level_db, low_tom_pan);
hi_mid_tom.tom_update(mid_tom_level_db, mid_tom_pan);
crash2.hat_update(crash_pitch_hz, crash_tone, crash_level_db, crash_pan, 6500, 1500);
ride2.hat_update(ride_pitch_hz, ride_tone, ride_level_db, ride_pan, 8000, 2000);
hand_pitch_coef = tau_coef(25);
hand60.hand_set(conga_level_db, conga_pan, conga_pitch_hz, conga_tone, conga_decay_ms, 1.59, 0.35, 1200);
hand61.hand_set(conga_level_db, conga_pan, conga_pitch_hz, conga_tone, conga_decay_ms, 1.59, 0.35, 1200);
hand62.hand_set(conga_level_db, conga_pan, conga_pitch_hz, conga_tone, conga_decay_ms, 1.59, 0.35, 1200);
hand63.hand_set(conga_level_db, conga_pan, conga_pitch_hz, conga_tone, conga_decay_ms, 1.59, 0.35, 1200);
hand64.hand_set(conga_level_db, conga_pan, conga_pitch_hz, conga_tone, conga_decay_ms, 1.59, 0.35, 1200);
hand65.hand_set(timbale_level_db, timbale_pan, timbale_pitch_hz, timbale_tone, timbale_decay_ms, 2.32, 0.8, 3000);
hand66.hand_set(timbale_level_db, timbale_pan, timbale_pitch_hz, timbale_tone, timbale_decay_ms, 2.32, 0.8, 3000);
bell67.bell_set();
bell68.bell_set();
knock75.knock_set();
knock76.knock_set();
knock77.knock_set();
triangle.pan_gains(triangle_pan);
triangle.gain = db_to_gain(triangle_level_db);
tri0.inc = clamp((triangle_pitch_hz * tri_r0) / srate, 0, 0.49);
tri1.inc = clamp((triangle_pitch_hz * tri_r1) / srate, 0, 0.49);
tri2.inc = clamp((triangle_pitch_hz * tri_r2) / srate, 0, 0.49);
tri3.inc = clamp((triangle_pitch_hz * tri_r3) / srate, 0, 0.49);
tri4.inc = clamp((triangle_pitch_hz * tri_r4) / srate, 0, 0.49);
triangle.hp.onepole_set(4000);

@block
midi_queue_read();

@sample
while (midi_pop()) (
  (midi_m1 & 0xF0) === 0x90 && midi_m3 > 0 ? note_on(midi_m2, midi_m3);
);
midi_tick();

// one stereo bus per output group
kick_l = 0; kick_r = 0;
sn_l = 0; sn_r = 0;
hat_l = 0; hat_r = 0;
perc_l = 0; perc_r = 0;

// kick
kick.env.value > 0 ? (
  hz = kick_pitch_hz * pow(2, kick_sweep_oct * kick.pitch_env);
  kick.pitch_env *= kick.pitch_coef;
  kick.osc.inc = hz / srate;
  y = kick.osc.sine_process() * kick.env.decay_env_process();
  y += kick.click_hp.onepole_hp(noise_white()) * kick.click.decay_env_process() * kick_tone * 0.6;
  drive = 1 + 3 * kick_tone;
  y = soft_clip(y * drive) / soft_clip(drive) * kick.vel * kick.gain;
  kick_l += y * kick.gl;
  kick_r += y * kick.gr;
);

// snare
snare.noise_env.value > 0 || snare.body_env.value > 0 ? (
  bend = 1 + 0.5 * snare.pitch_env;
  snare.pitch_env *= snare.pitch_coef;
  snare.osc1.inc = (snare_pitch_hz * bend) / srate;
  snare.osc2.inc = (snare_pitch_hz * 1.63 * bend) / srate;
  body = (snare.osc1.sine_process() + 0.6 * snare.osc2.sine_process()) * 0.6 * snare.body_env.decay_env_process();
  snare.bp.svf_process(noise_white());
  nz = snare.hp.onepole_hp(snare.bp.bp + 0.3 * snare.bp.hp) * snare.noise_env.decay_env_process() * 2.5;
  y = (body * (1 - snare_snappy) + nz * snare_snappy) * snare.vel * snare.gain;
  sn_l += y * snare.gl;
  sn_r += y * snare.gr;
);

// clap: 3 short bursts, then a 4th that becomes the tail
clap.t >= 0 ? (
  clap.t < 3 * clap.spread ? (
    env = pow(clap.burst_coef, clap.t % clap.spread);
    clap.t += 1;
  ) : (
    clap.t === 3 * clap.spread ? clap.tail = 1;
    env = clap.tail;
    clap.tail *= clap.tail_coef;
    clap.tail < 0.000001 ? clap.t = -1 : clap.t += 1;
  );
  clap.bp.svf_process(noise_white());
  y = clap.bp.bp * env * clap.vel * clap.gain * 3.5;
  sn_l += y * clap.gl;
  sn_r += y * clap.gr;
);

y = closed_hat.hat_render(closed_hat_metal_mix); hat_l += y * closed_hat.gl; hat_r += y * closed_hat.gr;
y = open_hat.hat_render(open_hat_metal_mix); hat_l += y * open_hat.gl; hat_r += y * open_hat.gr;
y = crash.hat_render(crash_metal_mix); hat_l += y * crash.gl; hat_r += y * crash.gr;
y = ride.hat_render(ride_metal_mix); hat_l += y * ride.gl; hat_r += y * ride.gr;

lt = low_tom.tom_render(low_tom_pitch_hz, low_tom_tone);
mt = mid_tom.tom_render(mid_tom_pitch_hz, mid_tom_tone);
ht = high_tom.tom_render(high_tom_pitch_hz, high_tom_tone);
perc_l += lt * low_tom.gl + mt * mid_tom.gl + ht * high_tom.gl;
perc_r += lt * low_tom.gr + mt * mid_tom.gr + ht * high_tom.gr;

// rimshot
rimshot.env.value > 0 ? (
  env = rimshot.env.decay_env_process();
  body = (rimshot.osc1.sine_process() * 0.7 + rimshot.osc2.sine_process() * 0.5) * env;
  click = rimshot.hp.onepole_hp(noise_white()) * rimshot.click.decay_env_process() * 0.5;
  drive = 1 + 4 * rimshot_tone;
  y = (soft_clip((body + click) * drive) / soft_clip(drive)) * rimshot.vel * rimshot.gain;
  sn_l += y * rimshot.gl;
  sn_r += y * rimshot.gr;
);

// cowbell
cowbell.slow.value > 0 ? (
  env = 0.6 * cowbell.fast.decay_env_process() + 0.4 * cowbell.slow.decay_env_process();
  cowbell.bp.svf_process((cowbell.osc1.square_naive_process() + cowbell.osc2.square_naive_process()) * 0.5);
  y = cowbell.bp.bp * env * cowbell.vel * cowbell.gain * 2;
  perc_l += y * cowbell.gl;
  perc_r += y * cowbell.gr;
);

// shaker
shaker.env.value > 0 ? (
  shaker.attack < 1 ? (
    shaker.attack = min(1, shaker.attack + shaker.attack_inc);
    env = shaker.attack * shaker.attack;
  ) : (
    env = shaker.env.decay_env_process();
  );
  shaker.bp.svf_process(noise_white());
  y = shaker.bp.bp * env * shaker.vel * shaker.gain * 2.5;
  perc_l += y * shaker.gl;
  perc_r += y * shaker.gr;
);

// ---- GM percussion (perc bus, except the cymbal variants on the hats bus)
y = tambourine.hat_render(0.7); perc_l += y * tambourine.gl; perc_r += y * tambourine.gr;
ft1 = floor_tom_low.tom_render(low_tom_pitch_hz, low_tom_tone);
ft2 = floor_tom_high.tom_render(low_tom_pitch_hz, low_tom_tone);
hmt = hi_mid_tom.tom_render(mid_tom_pitch_hz, mid_tom_tone);
perc_l += ft1 * floor_tom_low.gl + ft2 * floor_tom_high.gl + hmt * hi_mid_tom.gl;
perc_r += ft1 * floor_tom_low.gr + ft2 * floor_tom_high.gr + hmt * hi_mid_tom.gr;
y = crash2.hat_render(crash_metal_mix); hat_l += y * crash2.gl; hat_r += y * crash2.gr;
// ride bell: the square cluster alone (no noise)
y = ride2.hat_render(ride2.mul > 1 ? 1 : ride_metal_mix); hat_l += y * ride2.gl; hat_r += y * ride2.gr;
y = hand60.hand_render(); perc_l += y * hand60.gl; perc_r += y * hand60.gr;
y = hand61.hand_render(); perc_l += y * hand61.gl; perc_r += y * hand61.gr;
y = hand62.hand_render(); perc_l += y * hand62.gl; perc_r += y * hand62.gr;
y = hand63.hand_render(); perc_l += y * hand63.gl; perc_r += y * hand63.gr;
y = hand64.hand_render(); perc_l += y * hand64.gl; perc_r += y * hand64.gr;
y = hand65.hand_render(); perc_l += y * hand65.gl; perc_r += y * hand65.gr;
y = hand66.hand_render(); perc_l += y * hand66.gl; perc_r += y * hand66.gr;
y = bell67.bell_render(); perc_l += y * bell67.gl; perc_r += y * bell67.gr;
y = bell68.bell_render(); perc_l += y * bell68.gl; perc_r += y * bell68.gr;
y = knock75.knock_render(); perc_l += y * knock75.gl; perc_r += y * knock75.gr;
y = knock76.knock_render(); perc_l += y * knock76.gl; perc_r += y * knock76.gr;
y = knock77.knock_render(); perc_l += y * knock77.gl; perc_r += y * knock77.gr;
triangle.env.value > 0 ? (
  e1 = triangle.env.decay_env_process();
  e2 = triangle.env2.decay_env_process();
  hi = 1.5 * triangle_tone;
  x = tri0.sine_process() * (1 - 0.5 * triangle_tone) * e1
    + tri1.sine_process() * 0.7 * hi * e1
    + tri2.sine_process() * 0.55 * hi * e1
    + tri3.sine_process() * 0.45 * hi * e2
    + tri4.sine_process() * 0.35 * hi * e2;
  x += triangle.hp.onepole_hp(noise_white()) * triangle.click.decay_env_process() * 0.5;
  y = x * 0.35 * triangle.vel * triangle.gain;
  perc_l += y * triangle.gl;
  perc_r += y * triangle.gr;
);

g = master_gain * 0.8;
l = kick_l * main_kick + sn_l * main_snare + hat_l * main_hats + perc_l * main_perc;
r = kick_r * main_kick + sn_r * main_snare + hat_r * main_hats + perc_r * main_perc;
spl0 = soft_clip(l * g);
spl1 = soft_clip(r * g);
spl2 = soft_clip(kick_l * g);
spl3 = soft_clip(kick_r * g);
spl4 = soft_clip(sn_l * g);
spl5 = soft_clip(sn_r * g);
spl6 = soft_clip(hat_l * g);
spl7 = soft_clip(hat_r * g);
spl8 = soft_clip(perc_l * g);
spl9 = soft_clip(perc_r * g);
meter.meter_tick(spl0, spl1);
kick_meter.meter_tick(spl2, spl3); snare_meter.meter_tick(spl4, spl5);
hats_meter.meter_tick(spl6, spl7); perc_meter.meter_tick(spl8, spl9);

@gfx 520 205
meter.meter_draw();
meter.match_request ? (
  drum_master_volume_db = clamp(drum_master_volume_db + meter.correction, -60, 6);
  master_gain = db_to_gain(drum_master_volume_db);
  sliderchange(drum_master_volume_db); slider_automate(drum_master_volume_db);
);
gfx_x = 12; gfx_y = 145;
gfx_printf("Bus peaks: Kick %.1f / Snare %.1f dBFS",
  20 * log10(max(0.000001, max(kick_meter.peak_l, kick_meter.peak_r))),
  20 * log10(max(0.000001, max(snare_meter.peak_l, snare_meter.peak_r))));
gfx_x = 12; gfx_y = 174;
gfx_printf("Hats %.1f / Perc %.1f dBFS (dedicated outputs)",
  20 * log10(max(0.000001, max(hats_meter.peak_l, hats_meter.peak_r))),
  20 * log10(max(0.000001, max(perc_meter.peak_l, perc_meter.peak_r))));
