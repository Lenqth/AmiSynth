desc:AmiSynth Physical (string / modal / bowed / wind / 2D mesh / piano string / brass / organ)
//tags: instrument synthesizer physical-modeling
//author: AmiSynth
// Port of src/dsp/phys.js (8 voices; the 2D mesh uses at most 3).
// 0 extended Karplus-Strong string, 1 modal (8 resonators per voice), 2 bowed string
// (waveguide + bow friction), 3 wind (clarinet reed / flute jet + bore), 4 membrane / plate
// (2D finite-difference wave equation), 5 stiff string (dispersion all-passes, 2 strings per note),
// 6 brass (buzzing lip resonator + bore two periods long), 7 tonewheel organ (nine drawbar
// sines + percussion + key click). Rotary speaker (any model) after the amp.

options:gmem=AmiSynth

// <generated sliders>
slider1:tuning_divisions=12<1,72,1>Tuning Divisions Per Period [steps]
slider2:tuning_period_cents=1200<100,2400,0.001>Tuning Period [cents]
slider3:tuning_ref_note=69<0,127,1>Tuning Reference Note [note]
slider4:tuning_ref_hz=440<100,1000,0.01>Tuning Reference Frequency [Hz]
slider5:phys_model=0<0,7,1{String (Karplus-Strong),Modal (resonators),Bowed String,Wind (reed / jet),Membrane / Plate (2D mesh),Stiff String (piano),Brass (lip reed),Organ (tonewheel drawbars)}>Physical Model
slider6:string_excitation=0<0,1,1{Pluck (noise burst),Strike (hammer pulse)}>String Excitation
slider7:string_decay_ms=3000<100,20000,1>String Decay [ms]
slider8:string_damping=0.35<0,1,0.001>String Damping
slider9:string_pick_position=0.13<0.02,0.5,0.001>String Pick Position
slider10:string_brightness=0.7<0,1,0.001>String Pick Brightness
slider11:modal_material=0<0,12,1{Marimba Bar,Vibraphone Bar,Glockenspiel (free bar),Wine Glass,Church Bell,Drum Membrane,Harmonic (string-like),Kalimba Tine,Gong Ageng (gamelan),Kettle Gong (bonang),Tam-tam,Steel Drum,Tubular Bell}>Modal Material
slider12:modal_decay_ms=1500<50,20000,1>Modal Decay [ms]
slider13:modal_high_damping=0.5<0,1,0.001>Modal High Mode Damping
slider14:modal_hardness=0.5<0,1,0.001>Modal Mallet Hardness
slider15:modal_strike_position=0.22<0.02,0.5,0.001>Modal Strike Position
slider16:modal_inharmonicity=0<-0.5,0.5,0.001>Modal Ratio Stretch
slider17:bow_pressure=0.45<0,1,0.001>Bow Pressure
slider18:bow_speed=0.55<0,1,0.001>Bow Speed
slider19:bow_position=0.127<0.02,0.5,0.001>Bow Position
slider20:bow_attack_ms=90<1,2000,0.1>Bow Attack [ms]
slider21:bowed_brightness=0.6<0,1,0.001>Bowed String Brightness
slider22:wind_type=0<0,4,1{Clarinet (reed),Flute (air jet),Saxophone (conical reed),Oboe / Bassoon (double reed),Free reed (accordion / harmonica)}>Wind Type
slider23:breath_pressure=0.6<0,1,0.001>Breath Pressure
slider24:breath_noise=0.15<0,1,0.001>Breath Noise
slider25:wind_attack_ms=40<1,2000,0.1>Breath Attack [ms]
slider26:wind_embouchure=0.5<0,1,0.001>Embouchure
slider27:mesh_shape=0<0,1,1{Circular drum,Square plate}>Mesh Shape
slider28:mesh_size=12<6,16,1>Mesh Resolution [cells]
slider29:mesh_decay_ms=900<50,10000,1>Mesh Decay [ms]
slider30:mesh_high_damping=0.3<0,1,0.001>Mesh High Damping
slider31:mesh_strike_x=0.3<0,1,0.001>Mesh Strike X
slider32:mesh_strike_y=0.42<0,1,0.001>Mesh Strike Y
slider33:mesh_hardness=0.5<0,1,0.001>Mesh Mallet Hardness
slider34:piano_inharmonicity=0.35<0,1,0.001>Piano Inharmonicity
slider35:piano_hammer_hardness=0.5<0,1,0.001>Piano Hammer Hardness
slider36:piano_strike_position=0.12<0.02,0.5,0.001>Piano Strike Position
slider37:piano_decay_ms=8000<200,30000,1>Piano Decay [ms]
slider38:piano_damping=0.25<0,1,0.001>Piano Damping
slider39:piano_soundboard=0.6<0,1,0.001>Piano Soundboard
slider40:piano_unison_detune_cents=1.2<0,10,0.01>Piano Unison Detune [cents]
slider41:phys_vibrato_cents=0<0,100,0.1>Vibrato Depth [cents]
slider42:phys_vibrato_rate_hz=5.5<1,10,0.01>Vibrato Rate [Hz]
slider43:phys_release_ms=400<10,20000,1>Release Damping [ms]
slider44:phys_velocity_amount=0.8<0,1,0.001>Velocity Amount
slider45:phys_stereo_width=0.5<0,1,0.001>Stereo Width
slider46:phys_pitch_bend_range_cents=200<0,2400,1>Pitch Bend Range [cents]
slider47:phys_room_mix=0<0,1,0.001>Room
slider48:phys_room_decay_ms=1300<200,6000,1>Room Decay [ms]
slider49:phys_volume_db=-8<-60,6,0.1>Volume [dB]
slider50:brass_pressure=0.6<0,1,0.001>Brass Blowing Pressure
slider51:brass_lip=0.5<0,1,0.001>Brass Lip Buzz
slider52:brass_attack_ms=30<1,1000,0.1>Brass Attack [ms]
slider53:brass_bell=0.5<0,1,0.001>Brass Bell Brightness
slider54:tuning_source=0<0,2,1{EDO sliders,Scale file (Data/AmiSynth/tuning.txt),Shared (AmiSynth Tuning)}>Tuning Source
slider55:amp_type=0<0,4,1{Off,Clean,Crunch,Overdrive,Distortion}>Amp
slider56:amp_gain=0.5<0,1,0.001>Amp Gain
slider57:amp_tone=0.5<0,1,0.001>Amp Tone
slider58:amp_level_db=0<-24,12,0.1>Amp Level [dB]
slider59:tuning_slot=1<1,8,1>Tuning Slot
slider60:phys_sustain_mode=1<0,2,1{Off,Auto (strings / piano / modal),On (all models)}>Sustain Pedal
slider61:phys_pressure_excitation=0<0,1,0.001>Pressure to Breath / Bow
slider62:phys_pressure_vibrato_cents=0<0,100,0.1>Pressure to Vibrato [cents]
slider63:phys_pressure_brightness=0<0,1,0.001>Pressure to Brightness
slider64:organ_drawbar_16=8<0,8,1>Drawbar 16'
slider65:organ_drawbar_5_13=8<0,8,1>Drawbar 5 1/3'
slider66:organ_drawbar_8=8<0,8,1>Drawbar 8'
slider67:organ_drawbar_4=0<0,8,1>Drawbar 4'
slider68:organ_drawbar_2_23=0<0,8,1>Drawbar 2 2/3'
slider69:organ_drawbar_2=0<0,8,1>Drawbar 2'
slider70:organ_drawbar_1_35=0<0,8,1>Drawbar 1 3/5'
slider71:organ_drawbar_1_13=0<0,8,1>Drawbar 1 1/3'
slider72:organ_drawbar_1=0<0,8,1>Drawbar 1'
slider73:organ_percussion=0<0,2,1{Off,Second (4'),Third (2 2/3')}>Percussion
slider74:organ_perc_decay_ms=300<50,3000,1>Percussion Decay [ms]
slider75:organ_perc_level=0.6<0,1,0.001>Percussion Level
slider76:organ_click=0.3<0,1,0.001>Key Click
slider77:rotary_mode=0<0,2,1{Off,Slow (chorale),Fast (tremolo)}>Rotary Speaker
slider78:rotary_mix=1<0,1,0.001>Rotary Mix
slider79:free_reed_detune_cents=0<0,50,0.1>Free Reed Musette [cents]
slider80:string_sawari=0<0,1,0.001>String Sawari
slider81:sc_duck_db=0<0,48,0.1>Sidechain Duck [dB]
slider82:sc_input_gain_db=0<-24,24,0.1>Sidechain Input Gain [dB]
slider83:sc_attack_ms=1<0.1,100,0.1>Sidechain Attack [ms]
slider84:sc_release_ms=150<10,2000,1>Sidechain Release [ms]
// </generated sliders>

import amisynth_lib.jsfx-inc
import amisynth_meter.jsfx-inc

// pins 1/2 are not used (an instrument); 3/4 = sidechain (track channels 3/4)
in_pin:Input L (unused)
in_pin:Input R (unused)
in_pin:Sidechain L
in_pin:Sidechain R
out_pin:Left
out_pin:Right

@init
meter.meter_init();
MAX_VOICES = 8;
MESH_MAX_VOICES = 3;
NMODES = 8;
MAX_DELAY = 8192;
MESH_MAX = 16;
MESH_W = MESH_MAX + 2; // padded row length (zero border = fixed edge)
MESH_CELLS = MESH_W * MESH_W;
K_MESH = 5.5;
FLUTE_JET_RATIO = 1.03;
WIND_CLARINET = 0;
WIND_FLUTE = 1;
WIND_SAX = 2;
WIND_DOUBLE_REED = 3;
WIND_FREE_REED = 4;
FREE_REED_OVERLAP = 0.35;
SAW_GMAX = 1.5; // sawari: largest gain correction for the bridge contact's loss
FREE_REED_GAIN = 1.1;
FLUTE_JET_GAIN = 1.6;
EXC_MAX = 16384;
HAM_SUB = 4;
HAM_GAIN = 63;
SB_MODES = 16;
N_AP = 4;
MODEL_STRING = 0; MODEL_MODAL = 1; MODEL_BOWED = 2; MODEL_WIND = 3; MODEL_MESH = 4; MODEL_STIFF = 5; MODEL_BRASS = 6; MODEL_ORGAN = 7;
// organ: drawbar footages 16' .. 1' as harmonics of half the note; partials above the top
// tonewheel (~ 5.9 kHz) fold back an octave (see phys.js)
organ_k = mem_alloc(9);
organ_k[0] = 1; organ_k[1] = 3; organ_k[2] = 2; organ_k[3] = 4; organ_k[4] = 6;
organ_k[5] = 8; organ_k[6] = 10; organ_k[7] = 12; organ_k[8] = 16;
organ_w = mem_alloc(9);
organ_sn = mem_alloc(17);
ORGAN_FOLD_HZ = 6000;
ORGAN_GAIN = 0.12;
function organ_bar_w(x) local(b) ( b = clamp(floor(x + 0.5), 0, 8); b > 0 ? ORGAN_GAIN * db_to_gain(3 * (b - 8)) : 0; );
// rotary speaker
rot_line.delay_init(1024);
modwheel = 0;
horn_ph = 0;
drum_ph = 0;
horn_hz = 0.8;
drum_hz = 0.65;
BRASS_GAIN = 2.5;
BRASS_STEEP = 1.5;
BRASS_BOOST = 6;
BRASS_BOOST_PERIODS = 10;
BRASS_SEED = 0.15;
STEEP_LEN = 4096;
// conical bore (sax, double reed): reed position along the loop and output gain (see phys.js)
cone_pos = mem_alloc(4);
cone_pos[2] = 0.4; cone_pos[3] = 0.35;
cone_gain = mem_alloc(4);
cone_gain[2] = 0.7; cone_gain[3] = 0.9;
// brass: minimum lip drive per note (notes 28, 32, .. 104), drive multiples, tuning residual
// (cents sharp, 4 multiples x 20 notes) - see phys.js
brass_min = mem_alloc(20);
function brass_min_row(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19) (
  brass_min[0] = a0; brass_min[1] = a1; brass_min[2] = a2; brass_min[3] = a3; brass_min[4] = a4;
  brass_min[5] = a5; brass_min[6] = a6; brass_min[7] = a7; brass_min[8] = a8; brass_min[9] = a9;
  brass_min[10] = a10; brass_min[11] = a11; brass_min[12] = a12; brass_min[13] = a13; brass_min[14] = a14;
  brass_min[15] = a15; brass_min[16] = a16; brass_min[17] = a17; brass_min[18] = a18; brass_min[19] = a19;
);
brass_min_row(0.0542, 0.0308, 0.0275, 0.0219, 0.0175, 0.0124, 0.0099, 0.0079, 0.0063, 0.005,
  0.0045, 0.004, 0.004, 0.004, 0.004, 0.004, 0.004, 0.004, 0.004, 0.004);
brass_mults = mem_alloc(4);
brass_mults[0] = 1.1; brass_mults[1] = 1.6; brass_mults[2] = 2.2; brass_mults[3] = 3;
brass_sharp = mem_alloc(4 * 20);
function brass_row(j, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19) local(o) (
  o = j * 20;
  brass_sharp[o] = a0; brass_sharp[o + 1] = a1; brass_sharp[o + 2] = a2; brass_sharp[o + 3] = a3; brass_sharp[o + 4] = a4;
  brass_sharp[o + 5] = a5; brass_sharp[o + 6] = a6; brass_sharp[o + 7] = a7; brass_sharp[o + 8] = a8; brass_sharp[o + 9] = a9;
  brass_sharp[o + 10] = a10; brass_sharp[o + 11] = a11; brass_sharp[o + 12] = a12; brass_sharp[o + 13] = a13; brass_sharp[o + 14] = a14;
  brass_sharp[o + 15] = a15; brass_sharp[o + 16] = a16; brass_sharp[o + 17] = a17; brass_sharp[o + 18] = a18; brass_sharp[o + 19] = a19;
);
brass_row(0, 86.5, 70.6, 73.9, 69.7, 67.9, 62.6, 59.1, 56.9, 54.9, 47.9, 44.1, 40.2, 39.7, 38.9, 37.9, 37.3, 36.7, 37.1, 39.8, 42.5);
brass_row(1, 68.9, 71.7, 75.5, 75.2, 74.7, 72.6, 71.2, 69.5, 67.8, 60.7, 55.6, 50.3, 48.4, 46.3, 44.5, 43.3, 42.4, 42.7, 46.2, 49.7);
brass_row(2, 70.8, 74.4, 72.5, 75.9, 77, 79.5, 79.5, 78.2, 76.5, 69.5, 63.6, 57.7, 54.6, 51.6, 48.9, 47.3, 46, 46.4, 50.8, 51.1);
brass_row(3, 59.4, 67.1, 61.5, 62.4, 60.8, 70.2, 70.9, 71.4, 71.8, 69.2, 63.5, 62.3, 59.2, 55.4, 52.1, 50, 48.5, 49, 54.2, 43.9);

/** mouth pressure: the knob (plus aftertouch), scaled by the velocity over up to 20 dB (Velocity Amount) */
function brass_pressure_of(vel_raw, press) (
  clamp((0.2 + 0.8 * clamp(brass_pressure + phys_pressure_excitation * press, 0, 1)) * pow(10, phys_velocity_amount * (vel_raw - 1)), 0.05, 1);
);

/** bow friction slope from Bow Pressure (plus aftertouch) */
function bow_slope(press) ( 5 - 4 * clamp(bow_pressure + phys_pressure_excitation * press, 0, 1); );

/** Wind Type as an integer (WIND_CLARINET .. WIND_FREE_REED) */
function wind_kind() ( floor(wind_type + 0.5); );

/** wind: breath pressure (plus aftertouch) -> reed pressure / jet strength */
function wind_maxv(press, slope, jet_boost) local(bp, kind) (
  bp = clamp(breath_pressure + phys_pressure_excitation * press, 0, 1);
  kind = wind_kind();
  // free reed: how far the tongue swings; a conical bore needs a little more reed pressure to start
  kind === WIND_FREE_REED ? 0.3 + 0.7 * bp
  : kind >= WIND_SAX ? (0.24 + 0.05 * bp) / -slope
  : kind === WIND_CLARINET ? (0.2 + 0.06 * bp) / -slope
  : (0.6 + 0.4 * bp) * jet_boost;
);

/** drive multiple 1.1 .. 3 from Lip Buzz and the pressure, half each */
function brass_mult_of(press) (
  1.1 + 1.9 * clamp(0.5 * brass_lip + (0.5 * (press - 0.2)) / 0.8, 0, 1);
);

function brass_col(note) ( clamp((note - 28) / 4, 0, 20 - 1.000001); );

function brass_min_drive(note) local(u, i) (
  u = brass_col(note);
  i = floor(u);
  brass_min[i] + (brass_min[i + 1] - brass_min[i]) * (u - i);
);

function brass_sharp_of(note, mult) local(u, i, fu, j, fv, a, b) (
  u = brass_col(note);
  i = floor(u);
  fu = u - i;
  j = 0;
  while (j < 2 && mult > brass_mults[j + 1]) ( j += 1; );
  fv = clamp((mult - brass_mults[j]) / (brass_mults[j + 1] - brass_mults[j]), 0, 1);
  a = j * 20;
  b = (j + 1) * 20;
  (brass_sharp[a + i] * (1 - fu) + brass_sharp[a + i + 1] * fu) * (1 - fv) + (brass_sharp[b + i] * (1 - fu) + brass_sharp[b + i + 1] * fu) * fv;
);
noise_seed(12345);

// material tables: ratio / gain, 8 modes each (same values as MATERIALS in phys.js)
NMATERIALS = 13;
mat_ratio = mem_alloc(8 * NMATERIALS);
mat_gain = mem_alloc(8 * NMATERIALS);
function mat_row(m, r0, r1, r2, r3, r4, r5, r6, r7) (
  mat_ratio[m * 8] = r0; mat_ratio[m * 8 + 1] = r1; mat_ratio[m * 8 + 2] = r2; mat_ratio[m * 8 + 3] = r3;
  mat_ratio[m * 8 + 4] = r4; mat_ratio[m * 8 + 5] = r5; mat_ratio[m * 8 + 6] = r6; mat_ratio[m * 8 + 7] = r7;
);
function mat_gains(m, g0, g1, g2, g3, g4, g5, g6, g7) (
  mat_gain[m * 8] = g0; mat_gain[m * 8 + 1] = g1; mat_gain[m * 8 + 2] = g2; mat_gain[m * 8 + 3] = g3;
  mat_gain[m * 8 + 4] = g4; mat_gain[m * 8 + 5] = g5; mat_gain[m * 8 + 6] = g6; mat_gain[m * 8 + 7] = g7;
);
mat_row(0, 1, 3.93, 9.17, 15.3, 22.6, 30.7, 39.6, 49.4);          mat_gains(0, 1, 0.55, 0.25, 0.12, 0.06, 0.04, 0.03, 0.02); // marimba
mat_row(1, 1, 4, 10, 17.6, 26.3, 35.9, 46.3, 57.4);               mat_gains(1, 1, 0.45, 0.22, 0.1, 0.05, 0.03, 0.02, 0.01);  // vibraphone
mat_row(2, 1, 2.756, 5.404, 8.933, 13.345, 18.638, 24.813, 31.87); mat_gains(2, 1, 0.7, 0.45, 0.3, 0.2, 0.12, 0.08, 0.05);   // glockenspiel
mat_row(3, 1, 2.32, 4.25, 6.63, 9.38, 12.5, 16, 19.8);            mat_gains(3, 1, 0.5, 0.25, 0.15, 0.08, 0.05, 0.03, 0.02);  // wine glass
mat_row(4, 0.5, 1, 1.183, 1.506, 2, 2.514, 2.662, 3.011);         mat_gains(4, 0.6, 0.8, 0.7, 0.4, 1, 0.5, 0.45, 0.35);      // bell
mat_row(5, 1, 1.593, 2.136, 2.296, 2.653, 2.918, 3.156, 3.501);   mat_gains(5, 1, 0.7, 0.55, 0.5, 0.4, 0.35, 0.3, 0.25);     // membrane
mat_row(6, 1, 2, 3, 4, 5, 6, 7, 8);                               mat_gains(6, 1, 0.5, 0.33, 0.25, 0.2, 0.17, 0.14, 0.12);   // harmonic
mat_row(7, 1, 5.93, 13.0, 21.9, 32.6, 45.2, 59.6, 75.8);          mat_gains(7, 1, 0.35, 0.12, 0.05, 0.03, 0.02, 0.01, 0.01); // kalimba
mat_row(8, 1, 1.004, 2.01, 2.94, 3.98, 4.62, 5.86, 7.12);         mat_gains(8, 1, 0.85, 0.4, 0.3, 0.18, 0.12, 0.08, 0.05);   // gong ageng
mat_row(9, 1, 1.005, 2.06, 2.73, 3.02, 4.17, 5.11, 6.32);         mat_gains(9, 1, 0.6, 0.45, 0.4, 0.35, 0.15, 0.1, 0.06);    // kettle gong
mat_row(10, 1, 1.38, 1.83, 2.27, 2.76, 3.31, 3.93, 4.62);         mat_gains(10, 0.7, 0.8, 0.85, 0.8, 0.75, 0.7, 0.6, 0.5);   // tam-tam
mat_row(11, 1, 1.997, 2.988, 3.97, 4.62, 5.08, 6.03, 7.4);        mat_gains(11, 1, 0.85, 0.5, 0.28, 0.14, 0.1, 0.07, 0.04);  // steel drum
mat_row(12, 0.224, 0.617, 1.208, 2, 2.985, 4.17, 5.55, 7.13);     mat_gains(12, 0.1, 0.3, 0.6, 1, 0.8, 0.6, 0.35, 0.2);      // tubular bell

// guitar amp types (same as AMP_TYPES in phys.js): pre high-pass Hz, gain at Amp Gain 0 / 1,
// clipping bias, gain stages, cabinet low-pass Hz at Amp Tone 0 / 1
amp_tab = mem_alloc(5 * 7);
function amp_row(t, hp, g0, g1, bias, stages, c0, c1) (
  amp_tab[t * 7] = hp; amp_tab[t * 7 + 1] = g0; amp_tab[t * 7 + 2] = g1; amp_tab[t * 7 + 3] = bias;
  amp_tab[t * 7 + 4] = stages; amp_tab[t * 7 + 5] = c0; amp_tab[t * 7 + 6] = c1;
);
amp_row(0, 0, 1, 1, 0, 0, 0, 0);
amp_row(1, 60, 1, 4, 0, 1, 3000, 9000);
amp_row(2, 100, 3, 30, 0.15, 1, 2500, 7000);
amp_row(3, 200, 8, 100, 0.2, 1, 2200, 6000);
amp_row(4, 150, 30, 600, 0.1, 2, 1800, 5000);

// guitar amp: pre high-pass -> asymmetric soft clipping (1 or 2 stages) -> cabinet (low-pass + 80 Hz high-pass)
function amp_set(pre_hz, cab_hz) (
  this.pre.onepole_set(pre_hz);
  this.inter.onepole_set(5000);
  this.cab.svf_set(cab_hz, 1.1);
  this.cab_hp.svf_set(80, 1.4);
);
function amp_process(x) local(y) (
  y = soft_clip(this.pre.onepole_hp(x) * amp_drive + amp_bias) - amp_bias_out;
  amp_stages > 1 ? y = soft_clip(this.inter.onepole_lp(y) * 4);
  this.cab.svf_process(y);
  this.cab_hp.svf_process(this.cab.lp);
  this.cab_hp.hp * amp_out;
);

v_active = mem_alloc(MAX_VOICES);
v_note = mem_alloc(MAX_VOICES);
v_gate = mem_alloc(MAX_VOICES);
v_sus = mem_alloc(MAX_VOICES);
sustain_pedal = 0;
v_age = mem_alloc(MAX_VOICES);
age_counter = 0;
bend_ratio = 1;
pressure = 0; // channel pressure 0..1
dc.onepole_set(20);
dc_r.onepole_set(20);
level_coef = t60_coef(300);
vib_phase = 0;

// 2D mesh: shape mask (1 = inside) and scratch vectors for the eigenvalue search
mesh_mask = mem_alloc(MESH_CELLS);
mesh_x = mem_alloc(MESH_CELLS);
mesh_y = mem_alloc(MESH_CELLS);
mesh_spans = mem_alloc(2 * MESH_MAX);
mesh_rows = 0;
mesh_n = 0;
mesh_shape_cur = -1;
mesh_mu = 1;

/** phase delay (samples) of the loop low-pass y = (1-b)x + b*y1 at hz */
function lp_phase_delay(b, hz) local(w) (
  w = (2 * $pi * hz) / srate;
  atan2(b * sin(w), 1 - b * cos(w)) / w;
);

/** cell (i, j) of the n x n grid is at (i+1)*MESH_W + (j+1); border / outside cells stay 0 */
function mesh_setup(n, shape) local(cc, rr, i, j, c, it, norm, lambda, start, end) (
  mesh_n = n;
  mesh_shape_cur = shape;
  memset(mesh_mask, 0, MESH_CELLS);
  cc = (n - 1) / 2;
  rr = n / 2;
  i = 0;
  loop(n,
    j = 0;
    loop(n,
      mesh_mask[(i + 1) * MESH_W + (j + 1)] = shape === 1 ? 1 : (i - cc) * (i - cc) + (j - cc) * (j - cc) <= rr * rr ? 1 : 0;
      j += 1;
    );
    i += 1;
  );
  // the cells inside the shape: one contiguous run per row (both shapes are convex)
  mesh_rows = 0;
  i = 0;
  loop(n,
    start = -1;
    end = -1;
    j = 0;
    loop(n,
      c = (i + 1) * MESH_W + (j + 1);
      mesh_mask[c] !== 0 ? (
        start < 0 ? start = c;
        end = c + 1;
      );
      j += 1;
    );
    start >= 0 ? (
      mesh_spans[2 * mesh_rows] = start;
      mesh_spans[2 * mesh_rows + 1] = end;
      mesh_rows += 1;
    );
    i += 1;
  );
  // lowest eigenvalue mu of -Laplacian on the shape, by power iteration on (8 - (-Lap))
  c = 0;
  loop(MESH_CELLS, mesh_x[c] = mesh_mask[c]; mesh_y[c] = 0; c += 1;);
  lambda = 0;
  it = 0;
  loop(800,
    norm = 0;
    c = 0;
    loop(MESH_CELLS,
      mesh_mask[c] !== 0 ? (
        mesh_y[c] = 4 * mesh_x[c] + mesh_x[c - 1] + mesh_x[c + 1] + mesh_x[c - MESH_W] + mesh_x[c + MESH_W];
        mesh_y[c] > norm ? norm = mesh_y[c];
      );
      c += 1;
    );
    lambda = norm;
    c = 0;
    loop(MESH_CELLS, mesh_x[c] = mesh_mask[c] === 0 ? 0 : mesh_y[c] / norm; c += 1;);
    it += 1;
  );
  mesh_mu = 8 - lambda;
  // pickup point: off-centre so most modes are heard
  mesh_pick = (floor(n * 0.62) + 1) * MESH_W + (floor(n * 0.71) + 1);
  mesh_mask[mesh_pick] === 0 ? mesh_pick = (floor(cc) + 1) * MESH_W + (floor(cc) + 1);
);

/** mesh damping s for a T60 of ms: (1-s)/(1+s) = coef^2 */
function mesh_sigma(ms) local(c, g) (
  c = t60_coef(ms);
  g = c * c;
  (1 - g) / (1 + g);
);

/** inharmonicity coefficient B: ~1.5e-4 in the bass rising to ~1e-2 at the top, scaled by the knob */
function stiff_b(hz, amount) local(k) (
  k = amount / 0.35;
  0.00015 * (1 + pow(hz / 262, 1.5)) * k * k;
);

/** dispersion all-pass coefficient that puts partial n where a string with inharmonicity B has it */
function dispersion_coef(hz, B, b_lp) local(w1, n, wn, period, target, room, lo, hi, mid, pd1, it) (
  w1 = (2 * $pi * hz) / srate;
  n = min(8, floor((0.5 * $pi) / w1));
  n < 2 || B <= 0 ? 0 : (
    wn = n * w1;
    period = srate / hz;
    target = period * (1 - 1 / sqrt(1 + B * n * n)) - (lp1_phase_delay(b_lp, w1) - lp1_phase_delay(b_lp, wn));
    target <= 0 ? 0 : (
      room = period - lp1_phase_delay(b_lp, w1) - 3;
      lo = -0.95;
      hi = 0;
      loop(40,
        mid = 0.5 * (lo + hi);
        pd1 = N_AP * ap1_phase_delay(mid, w1);
        pd1 - N_AP * ap1_phase_delay(mid, wn) > target || pd1 > room ? lo = mid : hi = mid;
      );
      0.5 * (lo + hi);
    );
  );
);

/** integer delay + Thiran all-pass for the fraction (refined at w); which 0 / 1 = string A / B */
function thiran_split(which, L, w) instance(delay_len delay_len2 tune_d tune_d2 tune_a tune_a2) local(n, d, dl, a, it) (
  n = clamp(floor(L - 0.5), 1, MAX_DELAY - 2);
  d = clamp(L - n, 0.5, 1.5);
  dl = d;
  a = 0;
  loop(4,
    a = (1 - dl) / (1 + dl);
    dl += d - ap1_phase_delay(a, w);
  );
  a = (1 - dl) / (1 + dl);
  which === 0 ? (
    delay_len = n; tune_d = d; tune_a = a;
  ) : (
    delay_len2 = n; tune_d2 = d; tune_a2 = a;
  );
);

function voice_tune(keep_decay) instance(org_inc fr_inc2 fr_inc3 hz0 damp_b delay_len delay_len2 loop_gain loop_gain2 modes mhz mt60 jet_bias jet_boost mesh_c2 mesh_omega ap_a ap_count
  vel_raw lip_a1 lip_a2 lip_g maxv dc_r refl_b bell_b rad_k press)
  local(hz, m, k, ratio, pos_w, b, total, x, sharp, w, a, det, hzA, hzB, wA, wB, t, bpress, note, mult, drive, f, r) (
  hz = hz0 * bend_ratio;
  model === MODEL_STRING ? (
    damp_b = string_damp_b;
    delay_len = clamp(srate / hz - lp_phase_delay(damp_b, hz), 2, MAX_DELAY - 2);
    !keep_decay ? loop_gain = exp(-6.907755 / (hz * max(string_decay_ms, 1) * 0.001));
  ) : model === MODEL_MODAL ? (
    m = clamp(floor(modal_material + 0.5), 0, NMATERIALS - 1);
    k = 0;
    loop(NMODES,
      // stretch: ratio^(1+x) bends the series away from / toward harmonic
      ratio = pow(mat_ratio[m * 8 + k], 1 + modal_inharmonicity);
      mhz[k] = hz * ratio;
      !keep_decay ? mt60[k] = modal_decay_ms / max(0.25, 1 + modal_high_damping * 4 * (ratio - 1));
      pos_w = abs(sin($pi * (k + 1) * modal_strike_position));
      rmem_set(modes + k * 6, mhz[k], mt60[k], mat_gain[m * 8 + k] * (0.3 + 0.7 * pos_w));
      k += 1;
    );
  ) : model === MODEL_BOWED ? (
    // loop = bow->nut line + bow->bridge line + bridge low-pass
    b = 0.1 + 0.75 * (1 - clamp(bowed_brightness + phys_pressure_brightness * press, 0, 1));
    damp_b = b;
    total = srate / hz - lp_phase_delay(b, hz);
    delay_len = clamp(total * bow_position, 2, MAX_DELAY - 2);
    delay_len2 = clamp(total * (1 - bow_position), 2, MAX_DELAY - 2);
  ) : model === MODEL_BRASS ? (
    // lip drive = a multiple of what the note needs to speak; bore + lips scaled together by
    // the tuning residual; lip bandwidth 42 Hz, narrower (Q ~7) for low notes
    bpress = brass_pressure_of(vel_raw, press);
    note = 69 + (12 * log(hz / 440)) / log(2);
    mult = brass_mult_of(bpress);
    drive = brass_min_drive(note) * mult;
    f = hz * pow(2, -brass_sharp_of(note, mult) / 1200);
    delay_len = clamp((2 * srate) / f, 2, MAX_DELAY - 2);
    r = exp((-$pi * min(42, 0.15 * f)) / srate);
    w = (2 * $pi * f) / srate;
    lip_a1 = -2 * r * cos(w);
    lip_a2 = r * r;
    lip_g = (drive * hz * 2 * sin(w) * (1 - r)) / (0.3 * bpress);
    maxv = bpress;
    dc_r = exp((-2 * $pi * 0.05 * f) / srate);
    refl_b = exp((-2 * $pi * max(1500, 5 * f)) / srate);
    rad_k = 1 / (2 * sin(w / 2));
    bell_b = exp((-2 * $pi * (1500 + 6000 * clamp(brass_bell + phys_pressure_brightness * press, 0, 1))) / srate);
  ) : model === MODEL_WIND ? (
    k = wind_kind();
    k === WIND_FREE_REED ? (
      // free reed: its own pitch, the musette reeds above / below, first-difference radiation
      org_inc = hz / srate;
      fr_inc2 = org_inc * fr_det;
      fr_inc3 = org_inc / fr_det;
      rad_k = 1 / (2 * sin(($pi * hz) / srate));
    ) : k >= WIND_SAX ? (
      // saxophone / oboe (Scavone, STK Saxofony): a cone acts like a pipe open at both ends, so
      // the loop is one period; the reed hears the bell reflection and the same wave later
      damp_b = exp((-2 * $pi * max(k === WIND_SAX ? 2500 : 3500, 6 * hz)) / srate);
      // measured residual of the reed loop (cents flat), x = octaves above C4 at 48 kHz
      x = log((hz * 48000) / (srate * 261.63)) / log(2);
      sharp = k === WIND_SAX ? clamp(2.5 + 4 * x, 2, 7) : clamp(1.5 + 3.5 * x, 1, 9);
      total = clamp((srate / hz) * pow(2, -sharp / 1200) - lp_phase_delay(damp_b, hz), 4, 2 * MAX_DELAY - 4);
      delay_len2 = clamp(cone_pos[k] * total, 2, MAX_DELAY - 2);
      delay_len = clamp(total - delay_len2, 2, MAX_DELAY - 2);
      // bell radiation: first difference, unity gain at the fundamental
      rad_k = 1 / (2 * sin(($pi * hz) / srate));
    ) : k === WIND_CLARINET ? (
      // clarinet: inverting, low-passed reflection (tone holes / bell let the highs escape)
      damp_b = exp((-2 * $pi * max(1500, 5 * hz)) / srate);
      delay_len = clamp((0.5 * srate) / hz - lp_phase_delay(damp_b, hz), 2, MAX_DELAY - 2);
    ) : (
      // flute (Fletcher / Verge style jet): jet delay ~ one period, embouchure = jet offset
      damp_b = 0.7 - (0.1 * 22050) / srate;
      x = log((hz * 48000) / (srate * 523.25)) / log(2);
      sharp = 10.7 * x + 3.1 * x * x;
      total = (srate / hz) * pow(2, sharp / 1200);
      delay_len = clamp(total - lp_phase_delay(damp_b, hz), 2, MAX_DELAY - 2);
      delay_len2 = clamp(delay_len * FLUTE_JET_RATIO, 2, MAX_DELAY - 2);
      jet_bias = 0.1 + 0.4 * wind_embouchure;
      jet_boost = clamp(1 + 0.5 * (log((hz * 48000) / (srate * 1046.5)) / log(2)), 1, 1.6);
    );
  ) : model === MODEL_ORGAN ? (
    org_inc = (0.5 * hz) / srate;
  ) : model === MODEL_MESH ? (
    w = (2 * $pi * hz) / srate;
    mesh_c2 = min(0.49, (2 * (1 - cos(w))) / mesh_mu);
    mesh_omega = w;
  ) : (
    // stiff string: two strings detuned by +/- half the unison detune
    b = (0.05 + 0.6 * piano_damping) * clamp(sqrt(262 / hz), 0.15, 1) * min(1, pow(2093 / hz, 3));
    damp_b = b;
    a = dispersion_coef(hz, stiff_b(hz, piano_inharmonicity), b);
    ap_a = a;
    det = pow(2, piano_unison_detune_cents / 2400);
    hzA = hz * det;
    hzB = hz / det;
    wA = (2 * $pi * hzA) / srate;
    wB = (2 * $pi * hzB) / srate;
    // without dispersion (top notes) the all-passes are bypassed (each is still a 1-sample delay)
    ap_count = a === 0 ? 0 : N_AP;
    this.thiran_split(0, srate / hzA - lp1_phase_delay(b, wA) - ap_count * ap1_phase_delay(a, wA), wA);
    this.thiran_split(1, srate / hzB - lp1_phase_delay(b, wB) - ap_count * ap1_phase_delay(a, wB), wB);
    !keep_decay ? (
      t = max(piano_decay_ms, 1) * clamp(pow(220 / hz, 0.4), 0.25, 2) * 0.001;
      // divide out what the loop low-pass takes off the fundamental (adds up in the top octaves)
      loop_gain = min(0.99999, exp(-6.907755 / (hzA * t)) / ((1 - b) / sqrt(1 - 2 * b * cos(wA) + b * b)));
      loop_gain2 = min(0.99999, exp(-6.907755 / (hzB * t)) / ((1 - b) / sqrt(1 - 2 * b * cos(wB) + b * b)));
    );
  );
);

// --- piano hammer and soundboard (see hammer_force / soundboard_setup in phys.js) ---
ham_hist = mem_alloc(EXC_MAX * HAM_SUB);

/** felt hammer force pulse as string velocity F/2Z into out[]; returns its length */
function hammer_force(out, hz, v0, hardness, beta) local(m, Z, K, dt, lag, max_n, vh, d, i, n, acc, F, back, done) (
  m = clamp(0.0087 * pow(262 / hz, 0.3), 0.004, 0.012);
  Z = 2 * pow(262 / hz, 0.2);
  K = 250000000 * pow(100, hardness - 0.5);
  dt = 1 / (srate * HAM_SUB);
  lag = max(1, floor((beta * srate * HAM_SUB) / hz + 0.5));
  max_n = min(EXC_MAX, floor(0.03 * srate));
  vh = v0;
  d = 0;
  i = 0;
  n = 0;
  done = 0;
  while (n < max_n && !done) (
    acc = 0;
    loop(HAM_SUB,
      F = d > 0 ? K * pow(d, 2.5) : 0;
      ham_hist[i] = F;
      back = i >= lag ? ham_hist[i - lag] : 0;
      vh -= (F / m) * dt;
      d += (vh - (F - back) / (2 * Z)) * dt;
      acc += F;
      i += 1;
    );
    out[n] = acc / (HAM_SUB * 2 * Z);
    n += 1;
    d <= 0 && vh < 0 && n > 3 ? done = 1;
  );
  n;
);

// op: 0 init(index), 1 start(note, velocity), 2 note off, 3 retune for pitch bend
function voice_op(op, a, b) instance(idx vel hz0 level frames lp_z lp_z2 loop_gain loop_gain2 damp_b delay_len delay_len2 read_gain
  exc_t exc_len exc modes mhz mt60 maxv slope mesh_u mesh_up mesh_un mesh_sig mesh_omega jet_boost flut hiss_lp
  vel_raw lip_y1 lip_y2 dc_x dc_y bell_z refl_z rad_x rad_x2 steep steep_w boost boost_c poly_at press org_perc org_clk org_ph fr_ph2 fr_ph3
  saw_env saw_dc saw_mx saw_my saw_g saw_on)
  local(others, v, n, bright, aa, pick, norm, lp, i, j, c, x, width, ia, ib, hard, g_rel, k, R, amp, sx, sy, d, len, decay, sb_a, sb_env,
    v0, scale, total, hp_a, hp_z, hp_z2, hp_z3, hp_z4, w0, re, im, mag, around, m, top, want, blen, burst, release_ms, mesh_ms) (
  op === 0 ? (
    idx = a;
    this.line.delay_init(MAX_DELAY);
    this.line2.delay_init(MAX_DELAY);
    modes = mem_alloc(NMODES * 6);
    mhz = mem_alloc(NMODES);
    mt60 = mem_alloc(NMODES);
    mesh_u = mem_alloc(MESH_CELLS);
    mesh_up = mem_alloc(MESH_CELLS);
    mesh_un = mem_alloc(MESH_CELLS);
    exc = mem_alloc(EXC_MAX);
    steep = mem_alloc(STEEP_LEN);
    steep_w = 0;
  ) : op === 1 ? (
    v = b / 127;
    vel_raw = v;
    vel = 1 - phys_velocity_amount + phys_velocity_amount * v;
    hz0 = tuning_note_to_hz(a);
    frames = 0;
    level = 1;
    poly_at = 0;
    press = pressure;
    this.pan_gains(clamp(((a - 60) / 36) * phys_stereo_width, -1, 1));
    this.voice_tune(0);
    model === MODEL_STRING ? (
      // fill the delay line with the excitation (classic Karplus-Strong initialisation)
      this.line.delay_clear();
      lp_z = 0;
      n = ceil(delay_len);
      bright = clamp(string_brightness * (0.6 + 0.4 * v), 0.02, 1);
      aa = bright * bright;
      pick = max(1, floor(string_pick_position * n + 0.5));
      norm = 1 / sqrt(aa / (2 - aa));
      lp = 0;
      i = 0;
      loop(n,
        string_excitation < 0.5 ? (
          lp += aa * (noise_white() - lp);
          x = lp * norm * 0.5;
        ) : (
          width = max(2, n * (0.5 - 0.45 * bright));
          x = i < width ? 0.5 - 0.5 * cos((2 * $pi * i) / width) : 0;
        );
        this.line.delay_write(x);
        i += 1;
      );
      // pick position comb: subtract the excitation delayed by the pick distance
      i = n - 1;
      while (i >= pick) (
        ia = (this.line.w - n + i + this.line.size) % this.line.size;
        ib = (this.line.w - n + i - pick + this.line.size) % this.line.size;
        this.line.base[ia] -= this.line.base[ib];
        i -= 1;
      );
      saw_env = 0;
      saw_dc = 0;
      saw_mx = 0;
      saw_my = 0;
      saw_g = 1;
      saw_on = 1;
      read_gain = 1.2 * vel * clamp(pow(hz0 / 220, 0.3), 0.7, 2);
    ) : model === MODEL_MODAL ? (
      k = 0;
      loop(NMODES, rmem_reset(modes + k * 6); k += 1;);
      hard = clamp(modal_hardness * (0.7 + 0.3 * v), 0, 1);
      exc_len = max(2, floor((srate / hz0) * (0.6 - 0.56 * hard) + 0.5));
      exc_t = 0;
    ) : model === MODEL_BOWED ? (
      this.env.stage === 0 ? (
        this.line.delay_clear();
        this.line2.delay_clear();
        lp_z = 0;
        this.body1.svf_reset();
        this.body2.svf_reset();
        this.env.value = 0;
      );
      this.env.adsr_set(bow_attack_ms, 1, 1, phys_release_ms);
      this.env.adsr_gate_on();
      maxv = (0.03 + 0.25 * bow_speed) * vel;
      slope = bow_slope(press);
      this.body1.svf_set(290, 0.6);
      this.body2.svf_set(1150, 0.9);
    ) : model === MODEL_BRASS ? (
      this.env.stage === 0 ? (
        this.line.delay_clear();
        lip_y1 = 0;
        lip_y2 = 0;
        dc_x = 0;
        dc_y = 0;
        bell_z = 0;
        refl_z = 0;
        rad_x = 0;
        memset(steep, 0, STEEP_LEN);
        steep_w = 0;
        this.env.value = 0;
      );
      // the tongue release: bore set moving at the note, lips boosted for the first moments
      boost = BRASS_BOOST;
      boost_c = exp(-3 / max(brass_attack_ms * 0.001 * srate, (BRASS_BOOST_PERIODS * srate) / hz0));
      this.env.stage === 0 ? (
        n = ceil(delay_len);
        w0 = (2 * $pi * 2) / delay_len;
        i = 0;
        loop(n, this.line.delay_write(BRASS_SEED * 0.3 * maxv * sin(w0 * i)); i += 1;);
      );
      this.env.adsr_set(brass_attack_ms, 1, 1, min(phys_release_ms, 400));
      this.env.adsr_gate_on();
    ) : model === MODEL_WIND ? (
      this.env.stage === 0 ? (
        this.line.delay_clear();
        this.line2.delay_clear();
        lp_z = 0;
        lp_z2 = 0;
        this.dc.z = 0;
        this.env.value = 0;
        flut = 0;
        hiss_lp = 0;
        rad_x = 0;
        rad_x2 = 0;
        this.body1.svf_reset();
        org_ph = 0;
        fr_ph2 = 0.33;
        fr_ph3 = 0.67;
      );
      this.dc.onepole_set(20);
      this.body1.svf_set(1600, 1.2);
      this.env.adsr_set(wind_attack_ms, 1, 1, min(phys_release_ms, 400));
      this.env.adsr_gate_on();
      // both only speak inside a band of blowing pressure; velocity sets the output level
      wind_kind() !== WIND_FLUTE ? slope = -(0.2 + 0.25 * wind_embouchure);
      maxv = wind_maxv(press, slope, jet_boost);
    ) : model === MODEL_ORGAN ? (
      // single-trigger percussion: only when no other key is down
      others = 0;
      i = 0;
      loop(MAX_VOICES, i !== idx && v_active[i] && v_gate[i] ? others = 1; i += 1;);
      org_perc = others ? 0 : 1;
      org_clk = org_click > 0 ? org_click_len : 0;
      this.env.adsr_set(1.5, 1, 1, phys_release_ms);
      this.env.adsr_gate_on();
    ) : model === MODEL_MESH ? (
      n = mesh_n;
      memset(mesh_u, 0, MESH_CELLS);
      memset(mesh_up, 0, MESH_CELLS);
      memset(mesh_un, 0, MESH_CELLS);
      // mallet: raised-cosine bump of radius R around the strike point, as initial velocity
      R = 0.75 + 2.5 * (1 - clamp(mesh_hardness * (0.7 + 0.3 * v), 0, 1));
      amp = (vel * 4) / (R * R);
      sx = mesh_strike_x * (n - 1);
      sy = mesh_strike_y * (n - 1);
      i = 0;
      loop(n,
        j = 0;
        loop(n,
          c = (i + 1) * MESH_W + (j + 1);
          mesh_mask[c] !== 0 ? (
            d = sqrt((i - sy) * (i - sy) + (j - sx) * (j - sx));
            d < R ? mesh_up[c] = (-0.5 - 0.5 * cos(($pi * (R - d)) / R)) * amp;
          );
          j += 1;
        );
        i += 1;
      );
      mesh_sig = mesh_sigma(mesh_decay_ms);
    ) : (
      // stiff string: hammer pulse into both strings
      this.line.delay_clear();
      this.line2.delay_clear();
      lp_z = 0;
      lp_z2 = 0;
      this.apA0.ap1_init(); this.apA1.ap1_init(); this.apA2.ap1_init(); this.apA3.ap1_init();
      this.apB0.ap1_init(); this.apB1.ap1_init(); this.apB2.ap1_init(); this.apB3.ap1_init();
      this.tuneA.ap1_init();
      this.tuneB.ap1_init();
      // felt hammer (see hammer_force): its force pulse as string velocity through the strike
      // position comb with the DC removed, normalised at the fundamental (level follows the
      // velocity, the hammer decides the upper partials), plus a little key / action thump
      n = ceil(delay_len);
      v0 = 0.3 + 4.7 * v * v * v;
      len = hammer_force(exc, hz0, v0, piano_hammer_hardness, piano_strike_position);
      pick = max(1, floor(piano_strike_position * n + 0.5));
      total = min(EXC_MAX, max(len + pick + 1, floor(0.03 * srate + 0.5)));
      i = len;
      loop(total - len, exc[i] = 0; i += 1;);
      i = total - 1;
      while (i >= pick) (
        exc[i] -= exc[i - pick];
        i -= 1;
      );
      // 4 one-pole high-passes at 0.8 x the fundamental: what the pulse has below it is not a
      // string mode and would only be heard as a click (treble: contact longer than a period)
      hp_a = 1 - exp((-2 * $pi * 0.8 * hz0) / srate);
      hp_z = hp_z2 = hp_z3 = hp_z4 = 0;
      i = 0;
      loop(total,
        x = exc[i];
        hp_z += hp_a * (x - hp_z); x -= hp_z;
        hp_z2 += hp_a * (x - hp_z2); x -= hp_z2;
        hp_z3 += hp_a * (x - hp_z3); x -= hp_z3;
        hp_z4 += hp_a * (x - hp_z4); x -= hp_z4;
        exc[i] = x;
        i += 1;
      );
      // top octaves: fade towards a windowed sine burst at the fundamental (see phys.js)
      top = clamp((hz0 - srate / 16) / (srate / 10 - srate / 16), 0, 1);
      top > 0 ? (
        mag = 0;
        around = 0;
        k = 0;
        loop(5,
          w0 = (2 * $pi * hz0 * (0.8 + 0.1 * k)) / srate;
          re = 0;
          im = 0;
          i = 0;
          loop(total,
            re += exc[i] * cos(w0 * i);
            im += exc[i] * sin(w0 * i);
            i += 1;
          );
          m = sqrt(re * re + im * im);
          k === 2 ? mag = m;
          m > around ? around = m;
          k += 1;
        );
        want = max(mag, 0.3 * around);
        blen = min(total, max(len, ceil((2 * srate) / hz0)));
        amp = want / (blen / 4);
        w0 = (2 * $pi * hz0) / srate;
        i = 0;
        loop(total,
          burst = i < blen ? amp * (0.5 - 0.5 * cos((2 * $pi * i) / blen)) * sin(w0 * i) : 0;
          exc[i] = (1 - top) * exc[i] + top * burst;
          i += 1;
        );
      );
      // magnitude at the fundamental, at least 30 % of the level around it (spectral notch)
      mag = 0;
      around = 0;
      k = 0;
      loop(5,
        w0 = (2 * $pi * hz0 * (0.8 + 0.1 * k)) / srate;
        re = 0;
        im = 0;
        i = 0;
        loop(total,
          re += exc[i] * cos(w0 * i);
          im += exc[i] * sin(w0 * i);
          i += 1;
        );
        m = sqrt(re * re + im * im);
        k === 2 ? mag = m;
        m > around ? around = m;
        k += 1;
      );
      mag = max(mag, 0.3 * around);
      scale = (HAM_GAIN * pow(clamp(hz0 / 262, 0.35, 8), -1.5) * pow(v0 / 2, 0.6)) / max(0.000000000001, mag);
      decay = exp(-1 / (0.004 * srate));
      sb_a = 1 - exp((-2 * $pi * 600) / srate);
      sb_env = 0.02 * v;
      lp = 0;
      i = 0;
      loop(total,
        lp += sb_a * (noise_white() - lp);
        exc[i] = exc[i] * scale + lp * sb_env;
        sb_env *= decay;
        i += 1;
      );
      exc_len = total;
      exc_t = 0;
      read_gain = 0.9 * vel * clamp(pow(hz0 / 220, 0.3), 0.7, 2);
    );
  ) : op === 2 ? (
    // Overrides release pending notes with the previous patch's damping on a model/policy change.
    release_ms = a > 0 ? a : phys_release_ms;
    mesh_ms = b > 0 ? b : mesh_decay_ms;
    model === MODEL_STRING ? (
      g_rel = exp(-6.907755 / (hz0 * release_ms * 0.001));
      loop_gain = min(loop_gain, g_rel);
      saw_on = 0;
      saw_g = 1;
    ) : model === MODEL_MODAL ? (
      k = 0;
      loop(NMODES,
        mt60[k] = min(mt60[k], release_ms);
        rmem_set_decay(modes + k * 6, mhz[k], mt60[k]);
        k += 1;
      );
    ) : model === MODEL_BOWED || model === MODEL_WIND || model === MODEL_BRASS || model === MODEL_ORGAN ? (
      this.env.adsr_gate_off();
    ) : model === MODEL_MESH ? (
      mesh_sig = max(mesh_sig, mesh_sigma(min(mesh_ms, release_ms)));
    ) : (
      g_rel = exp(-6.907755 / (hz0 * release_ms * 0.001));
      loop_gain = min(loop_gain, g_rel);
      loop_gain2 = min(loop_gain2, g_rel);
    );
  ) : op === 3 ? (
    this.voice_tune(1);
  ) : op === 5 ? (
    poly_at = 0;
  ) : op === 4 ? (
    // aftertouch changed (a >= 0: this key's polyphonic aftertouch): the blown / bowed models follow
    a >= 0 ? poly_at = a;
    press = max(pressure, poly_at);
    phys_pressure_excitation > 0 || phys_pressure_brightness > 0 ? (
      model === MODEL_BOWED ? (
        slope = bow_slope(press);
        phys_pressure_brightness > 0 ? this.voice_tune(1);
      ) : model === MODEL_WIND ? (
        maxv = wind_maxv(press, slope, jet_boost);
      ) : model === MODEL_BRASS ? (
        this.voice_tune(1);
      );
    );
  );
);

// --- per-model renderers (return the voice's mono output) ---

function render_string() instance(lp_z damp_b loop_gain delay_len read_gain saw_env saw_dc saw_mx saw_my saw_g saw_on)
  local(x, fb, a, b, y) (
  // read the oldest sample, damp it, feed it back
  x = this.line.delay_read(delay_len / vib);
  lp_z = (1 - damp_b) * x + damp_b * lp_z;
  fb = lp_z * loop_gain;
  string_sawari > 0 ? (
    // sawari (jawari bridge): above a fraction of its own swing the string lies on the curved
    // bridge, which throws it back - a kink every cycle that regenerates the high partials.
    // The contact point scales with the envelope, so the buzz lasts as long as the note.
    a = abs(lp_z);
    saw_env = a > saw_env ? a : saw_env * saw_env_c;
    b = saw_c * saw_env;
    y = lp_z;
    y > b ? y = b - 0.5 * (y - b);
    saw_dc += saw_dc_a * (y - saw_dc);
    y -= saw_dc;
    // the contact itself loses energy every cycle; give back what it took (mean |y| vs mean |x|)
    // so the note keeps the decay set by String Decay / Damping
    saw_mx += saw_m_a * (a - saw_mx);
    saw_my += saw_m_a * (abs(y) - saw_my);
    saw_on && saw_my > 0.000000000001 ? saw_g = min(saw_mx / saw_my, SAW_GMAX);
    fb = y * loop_gain * saw_g;
  );
  this.line.delay_write(fb);
  fb * read_gain;
);

function render_modal() instance(vel exc_t exc_len modes) local(exc, y, k) (
  exc = 0;
  exc_t < exc_len ? (
    exc = ((0.5 - 0.5 * cos((2 * $pi * exc_t) / exc_len)) * vel) / (0.5 * exc_len);
    exc_t += 1;
  );
  y = 0;
  k = 0;
  loop(NMODES, y += rmem_process(modes + k * 6, exc); k += 1;);
  y * 1.6;
);

function render_bowed() instance(maxv slope lp_z damp_b delay_len delay_len2)
  local(bow_v, bridge_out, nut_out, refl_bridge, refl_nut, string_v, dv, t, nv) (
  bow_v = this.env.adsr_process() * maxv;
  bridge_out = this.line.delay_read(delay_len / vib);
  nut_out = this.line2.delay_read(delay_len2 / vib);
  // bridge: lossy low-pass reflection; nut: rigid (inverting) reflection
  lp_z = (1 - damp_b) * bridge_out + damp_b * lp_z;
  refl_bridge = -lp_z * 0.95;
  refl_nut = -nut_out;
  string_v = refl_bridge + refl_nut;
  dv = bow_v - string_v;
  // friction curve (STK BowTable): ~1 = stick, small = slip
  t = abs(dv * slope) + 0.75;
  t = pow(t, -4);
  t > 1 ? t = 1;
  nv = dv * t;
  this.line2.delay_write(refl_bridge + nv);
  this.line.delay_write(refl_nut + nv);
  // crude violin body: two resonances added to the bridge signal
  this.body1.svf_process(bridge_out);
  this.body2.svf_process(bridge_out);
  (bridge_out + 1.2 * this.body1.bp + 0.8 * this.body2.bp) * 1.6;
);

function render_brass() instance(vel maxv delay_len lip_y1 lip_y2 lip_a1 lip_a2 lip_g dc_x dc_y dc_r bell_b bell_z refl_b refl_z rad_k rad_x
  steep steep_w boost boost_c)
  local(mouth, at_bell, bore, y, u, open, x, d, rad, per, d0, dd, pos, i0, i1, sv) (
  mouth = 0.3 * maxv * this.env.adsr_process();
  // the wave at the bell: its low part reflects back, the bell radiates its rate of change
  at_bell = this.line.delay_read(delay_len / vib);
  // wave steepening ("brassiness"): a delay shortened by the pressure, outside the loop
  steep[steep_w] = at_bell;
  steep_w = (steep_w + 1) & (STEEP_LEN - 1);
  per = delay_len * 0.5;
  d0 = min(STEEP_LEN * 0.4, per * 0.5 + 2);
  dd = clamp(d0 - BRASS_STEEP * at_bell * per, 1, 2 * d0);
  pos = steep_w - dd;
  pos < 0 ? pos += STEEP_LEN;
  i0 = floor(pos);
  i1 = (i0 + 1) & (STEEP_LEN - 1);
  sv = steep[i0] + (pos - i0) * (steep[i1] - steep[i0]);
  refl_z = (1 - refl_b) * at_bell + refl_b * refl_z;
  bore = 0.85 * refl_z;
  // lips: resonator driven by the pressure difference; opening saturates smoothly
  y = mouth - bore - lip_a1 * lip_y1 - lip_a2 * lip_y2;
  lip_y2 = lip_y1;
  lip_y1 = y;
  boost *= boost_c;
  u = lip_g * (1 + boost) * y;
  open = 1 - exp(-u * u);
  x = open * mouth + (1 - open) * bore;
  d = x - dc_x + dc_r * dc_y;
  dc_x = x;
  dc_y = d;
  this.line.delay_write(d);
  rad = (sv - rad_x) * rad_k;
  rad_x = sv;
  bell_z = (1 - bell_b) * rad + bell_b * bell_z;
  bell_z * BRASS_GAIN * vel;
);

/** air through the slot for a free-reed tongue at x (offset by the embouchure bias) */
function free_reed_flow(x) local(d) ( d = abs(x - fr_bias) - FREE_REED_OVERLAP; d > 0 ? d : 0; );

function render_wind() instance(vel maxv slope lp_z damp_b delay_len delay_len2 jet_bias flut hiss_lp rad_x rad_x2 rad_k
  org_ph org_inc fr_ph2 fr_ph3 fr_inc2 fr_inc3)
  local(en, nz, bp, hiss, bore, pd, reed, t, jet, j, kind, mouth, rad, r2, x, u) (
  en = this.env.adsr_process();
  nz = noise_white();
  // slow (~5 Hz) breath pressure wobble of about 1.5 % and an airy hiss above ~1 kHz
  flut += flut_a * (nz - flut);
  bp = en * maxv * (1 + 1.4 * flut);
  hiss_lp += hiss_a * (nz - hiss_lp);
  hiss = (nz - hiss_lp) * en * breath_noise * 0.05;
  kind = wind_kind();
  kind === WIND_FREE_REED ? (
    // the tongue swings at its own pitch; air passes while it is clear of the slot
    bp += bp * breath_noise * 0.25 * nz;
    org_ph += org_inc * vib;
    org_ph >= 1 ? org_ph -= 1;
    x = bp * sin(2 * $pi * org_ph);
    u = free_reed_flow(x);
    fr_n > 1 ? (
      fr_ph2 += fr_inc2 * vib;
      fr_ph2 >= 1 ? fr_ph2 -= 1;
      fr_ph3 += fr_inc3 * vib;
      fr_ph3 >= 1 ? fr_ph3 -= 1;
      u = 0.6 * (u + free_reed_flow(bp * sin(2 * $pi * fr_ph2)) + free_reed_flow(bp * sin(2 * $pi * fr_ph3)));
    );
    rad = (u - rad_x) * rad_k;
    rad_x = u;
    this.body1.svf_process(rad);
    ((0.7 * rad + 0.5 * this.body1.bp) * FREE_REED_GAIN + hiss) * vel;
  ) : kind >= WIND_SAX ? (
    bp += bp * breath_noise * 0.25 * nz;
    // bell side: lossy, low-passed, inverting reflection at the open end
    bore = this.line.delay_read(delay_len / vib);
    lp_z = (1 - damp_b) * bore + damp_b * lp_z;
    t = -0.95 * lp_z;
    // pressure at the reed: the fresh reflection minus the one that went on past the reed
    mouth = t - this.line2.delay_read(delay_len2 / vib);
    pd = bp - mouth;
    reed = 0.7 - slope * pd;
    reed > 1 ? reed = 1;
    reed < -1 ? reed = -1;
    this.line2.delay_write(t);
    this.line.delay_write(bp - pd * reed - t);
    rad = (t - rad_x) * rad_k;
    rad_x = t;
    kind === WIND_DOUBLE_REED ? (
      // narrow cone: plus a second difference with a fixed ~1 kHz corner (nasal formant)
      r2 = (rad - rad_x2) * reed_k;
      rad_x2 = rad;
      rad = 0.4 * rad + 0.6 * r2;
    );
    (rad * cone_gain[kind] + hiss) * vel;
  ) : kind === WIND_CLARINET ? (
    bp += bp * breath_noise * 0.25 * nz;
    bore = this.line.delay_read(delay_len / vib);
    // lossy, low-passed, inverting reflection at the bell
    lp_z = (1 - damp_b) * bore + damp_b * lp_z;
    pd = -0.95 * lp_z - bp;
    // reed: opening = clipped straight line of the pressure difference
    reed = 0.7 + slope * pd;
    reed > 1 ? reed = 1;
    reed < -1 ? reed = -1;
    this.line.delay_write(bp + pd * reed);
    (bore * 1.1 + hiss) * vel;
  ) : (
    bore = this.line.delay_read(delay_len / vib);
    lp_z = (1 - damp_b) * bore + damp_b * lp_z;
    t = this.dc.onepole_hp(lp_z);
    // the acoustic flow (plus turbulence) deflects the jet; it arrives at the edge later
    jet = this.line2.delay_read(delay_len2 / vib);
    this.line2.delay_write(t + (0.01 + 0.08 * breath_noise) * en * nz);
    // the edge splits the jet: saturating curve around the jet offset (DC removed)
    j = soft_clip(FLUTE_JET_GAIN * jet + jet_bias) - soft_clip(jet_bias);
    this.line.delay_write(bp * j + 0.5 * t);
    (bore * 0.3 + hiss) * vel;
  );
);

function render_organ() instance(vel org_ph org_inc org_perc org_clk) local(th, c2, k, j, half, top, y, w, e) (
  org_ph += org_inc * vib;
  org_ph >= 1 ? org_ph -= 1;
  th = 2 * $pi * org_ph;
  c2 = 2 * cos(th);
  organ_sn[0] = 0;
  organ_sn[1] = sin(th);
  k = 2;
  loop(15, organ_sn[k] = c2 * organ_sn[k - 1] - organ_sn[k - 2]; k += 1;);
  half = org_inc * srate;
  top = 0.45 * srate;
  y = 0;
  j = 0;
  loop(9,
    w = organ_w[j];
    w !== 0 ? (
      k = organ_k[j];
      k * half > ORGAN_FOLD_HZ && k > 3 ? k *= 0.5;
      k * half < top ? y += w * organ_sn[k];
    );
    j += 1;
  );
  org_perc_k > 0 && org_perc > 0.00001 ? (
    org_perc_k * half < top ? y += org_perc_lvl * org_perc * organ_sn[org_perc_k];
    org_perc *= org_perc_coef;
  );
  org_clk > 0 ? (
    e = org_clk / org_click_len;
    y += org_click * e * e * noise_white();
    org_clk -= 1;
  );
  y * this.env.adsr_process() * vel;
);

function render_mesh() instance(mesh_u mesh_up mesh_un mesh_c2 mesh_sig mesh_omega)
  local(u, up, un, c2, inv, d, mu, ku, kp, kn, kq, r, c, cend) (
  u = mesh_u;
  up = mesh_up;
  un = mesh_un;
  c2 = mesh_c2;
  // u' = (2u - (1-s)up + c2 Lap(u) + d (Lap(u) - Lap(up) + mu (u - up))) / (1+s), collapsed to
  // 4 coefficients with Lap(u) = (sum of the 4 neighbours) - 4u (see render_mesh in phys.js)
  inv = 1 / (1 + mesh_sig);
  d = (mesh_high_damping * 172.5) / srate;
  mu = mesh_mu;
  ku = (2 - 4 * c2 - 4 * d + d * mu) * inv;
  kp = (4 * d - d * mu - (1 - mesh_sig)) * inv;
  kn = (c2 + d) * inv;
  kq = d * inv;
  // each row of the shape is one contiguous run of cells [start, end)
  r = 0;
  loop(mesh_rows,
    c = mesh_spans[2 * r];
    cend = mesh_spans[2 * r + 1];
    while (c < cend) (
      un[c] = ku * u[c] + kp * up[c] + kn * (u[c - 1] + u[c + 1] + u[c - MESH_W] + u[c + MESH_W]) -
        kq * (up[c - 1] + up[c + 1] + up[c - MESH_W] + up[c + MESH_W]);
      c += 1;
    );
    r += 1;
  );
  // rotate the three time levels
  mesh_up = u;
  mesh_u = un;
  mesh_un = up;
  un[mesh_pick] * mesh_omega * K_MESH;
);

function render_stiff() instance(ap_a ap_count delay_len delay_len2 tune_a tune_a2 tune_d tune_d2 lp_z lp_z2 damp_b loop_gain loop_gain2 read_gain exc exc_t exc_len)
  local(a, nA, nB, tA, tB, t, x, y, fa, fb, e) (
  a = ap_a;
  nA = delay_len;
  nB = delay_len2;
  tA = tune_a;
  tB = tune_a2;
  vib !== 1 ? (
    // vibrato: re-split the scaled delay (low-frequency Thiran formula)
    t = (nA + tune_d) / vib;
    nA = floor(t - 0.5);
    t -= nA;
    tA = (1 - t) / (1 + t);
    t = (nB + tune_d2) / vib;
    nB = floor(t - 0.5);
    t -= nB;
    tB = (1 - t) / (1 + t);
  );
  // hammer + soundboard excitation, fed into both strings (the second one less)
  e = 0;
  exc_t < exc_len ? ( e = exc[exc_t]; exc_t += 1; );
  x = this.tuneA.ap1_process(this.line.delay_read(nA), tA);
  ap_count > 0 ? (
    x = this.apA0.ap1_process(x, a); x = this.apA1.ap1_process(x, a);
    x = this.apA2.ap1_process(x, a); x = this.apA3.ap1_process(x, a);
  );
  lp_z = (1 - damp_b) * x + damp_b * lp_z;
  fa = lp_z * loop_gain + 0.5 * e;
  this.line.delay_write(fa);
  y = this.tuneB.ap1_process(this.line2.delay_read(nB), tB);
  ap_count > 0 ? (
    y = this.apB0.ap1_process(y, a); y = this.apB1.ap1_process(y, a);
    y = this.apB2.ap1_process(y, a); y = this.apB3.ap1_process(y, a);
  );
  lp_z2 = (1 - damp_b) * y + damp_b * lp_z2;
  fb = lp_z2 * loop_gain2 + 0.32 * e;
  this.line2.delay_write(fb);
  (fa + fb) * read_gain;
);

function voice_render() instance(idx level frames gl gr press) local(y, a) (
  v_active[idx] ? (
    // aftertouch deepens the vibrato of this note (render_* read the global vib)
    vib = phys_pressure_vibrato_cents > 0 && press > 0
      ? pow(2, ((phys_vibrato_cents + phys_pressure_vibrato_cents * press) * vib_sin) / 1200) : vib_g;
    y = model === MODEL_STRING ? this.render_string()
      : model === MODEL_MODAL ? this.render_modal()
      : model === MODEL_BOWED ? this.render_bowed()
      : model === MODEL_WIND ? this.render_wind()
      : model === MODEL_BRASS ? this.render_brass()
      : model === MODEL_MESH ? this.render_mesh()
      : model === MODEL_ORGAN ? this.render_organ()
      : this.render_stiff();
    mix_l += y * gl;
    mix_r += y * gr;
    bridge += y;
    // voice ends once it has been quiet for a while
    a = abs(y);
    level = a > level ? a : level * level_coef;
    frames += 1;
    frames > 2000 && level < 0.00005 ? (
      v_active[idx] = 0;
      v_note[idx] = -1;
    );
  );
);

// soundboard: 16 band-passes, 8 values each: k a1 a2 a3 ic1 ic2 gainL gainR
sb = mem_alloc(SB_MODES * 8);
function soundboard_setup() local(k, f, t60, kk, g, o, gain) (
  k = 0;
  loop(SB_MODES,
    f = 75 * pow(2800 / 75, k / (SB_MODES - 1)) * (1 + 0.06 * sin(2.3 * k + 1));
    t60 = clamp(0.35 * pow(150 / f, 0.4), 0.05, 0.6);
    kk = 1 / clamp(($pi * f * t60) / 6.908, 2, 60);
    g = tan(($pi * min(f, srate * 0.45)) / srate);
    o = k * 8;
    sb[o] = kk;
    sb[o + 1] = 1 / (1 + g * (g + kk));
    sb[o + 2] = g * sb[o + 1];
    sb[o + 3] = g * sb[o + 2];
    sb[o + 4] = 0;
    sb[o + 5] = 0;
    gain = ((0.7 + 0.3 * cos(1.7 * k)) / (1 + f / 1500)) * 0.45;
    sb[o + 6] = gain * (k % 2 === 0 ? 1.3 : 0.7);
    sb[o + 7] = gain * (k % 2 === 0 ? 0.7 : 1.3);
    k += 1;
  );
);
soundboard_setup();
sb_l = sb_r = 0;

function soundboard_process(x) local(k, o, v1, v2, v3, bp) (
  sb_l = 0;
  sb_r = 0;
  k = 0;
  loop(SB_MODES,
    o = k * 8;
    v3 = x - sb[o + 5];
    v1 = sb[o + 1] * sb[o + 4] + sb[o + 2] * v3;
    v2 = sb[o + 5] + sb[o + 2] * sb[o + 4] + sb[o + 3] * v3;
    sb[o + 4] = 2 * v1 - sb[o + 4];
    sb[o + 5] = 2 * v2 - sb[o + 5];
    bp = v1 * sb[o];
    sb_l += bp * sb[o + 6];
    sb_r += bp * sb[o + 7];
    k += 1;
  );
);

// room: the shared 4-line FDN (fdn4_* in amisynth_lib) at its natural size
room.fdn4_init(8192);
room_l = room_r = 0;

function room_update(decay_ms) ( room.fdn4_set(1, decay_ms, 0.55); );

function room_process(l, r) (
  room.fdn4_process((l + r) * 0.5);
  room_l = 2.5 * room.l;
  room_r = 2.5 * room.r;
);

// rotary speaker: 800 Hz crossover, horn = swept delay (Doppler) + loudness, drum = loudness;
// two mics 90 degrees apart; the rotors speed up / slow down gradually (see phys.js)
function rotary_process(l, r) local(fast, x, lo, hc, hs, rc, rs, hl, hr) (
  fast = rot_mode === 2 || modwheel >= 0.5;
  horn_hz += horn_c * ((fast ? 6.8 : 0.8) - horn_hz);
  drum_hz += drum_c * ((fast ? 5.9 : 0.65) - drum_hz);
  horn_ph += horn_hz / srate;
  horn_ph >= 1 ? horn_ph -= 1;
  drum_ph += drum_hz / srate;
  drum_ph >= 1 ? drum_ph -= 1;
  x = (l + r) * 0.5;
  lo = rot_xo.onepole_lp(x);
  rot_line.delay_write(x - lo);
  hc = cos(2 * $pi * horn_ph);
  hs = sin(2 * $pi * horn_ph);
  rc = cos(2 * $pi * drum_ph);
  rs = sin(2 * $pi * drum_ph);
  hl = rot_line.delay_read(rot_d0 + rot_dd * (1 - hc)) * (0.65 + 0.35 * hc);
  hr = rot_line.delay_read(rot_d0 + rot_dd * (1 - hs)) * (0.65 + 0.35 * hs);
  rot_l = 1.2 * (hl + lo * (0.8 + 0.2 * rc));
  rot_r = 1.2 * (hr + lo * (0.8 + 0.2 * rs));
);

function vcall(i, op, a, b) (
  i === 0 ? p0.voice_op(op, a, b) : i === 1 ? p1.voice_op(op, a, b) :
  i === 2 ? p2.voice_op(op, a, b) : i === 3 ? p3.voice_op(op, a, b) :
  i === 4 ? p4.voice_op(op, a, b) : i === 5 ? p5.voice_op(op, a, b) :
  i === 6 ? p6.voice_op(op, a, b) : p7.voice_op(op, a, b);
);

i = 0;
loop(MAX_VOICES,
  vcall(i, 0, i, 0);
  v_active[i] = 0; v_note[i] = -1; v_gate[i] = 0; v_sus[i] = 0; v_age[i] = 0;
  i += 1;
);

function voice_allocate(limit) local(i, best, best_score, score, found) (
  best = 0; best_score = -1; found = -1;
  i = 0;
  while (i < limit && found < 0) (
    !v_active[i] ? found = i : (
      score = (v_gate[i] ? 0 : 1000000000000) + (age_counter - v_age[i]);
      score > best_score ? ( best_score = score; best = i; );
    );
    i += 1;
  );
  found >= 0 ? found : best;
);

function sustain_enabled(m, material) (
  phys_sustain_mode >= 1.5 || (phys_sustain_mode >= 0.5 && (m === MODEL_STRING || m === MODEL_STIFF ||
    (m === MODEL_MODAL && floor(material + 0.5) !== 5)));
);

function flush_sustain(release_override, mesh_override) local(i) (
  i = 0;
  loop(MAX_VOICES,
    v_sus[i] && v_active[i] ? vcall(i, 2, release_override, mesh_override);
    v_sus[i] = 0;
    i += 1;
  );
);

function sustain(on) (
  sustain_pedal = on ? 1 : 0;
  !sustain_pedal ? flush_sustain(0, 0);
);

function note_off(note) local(i) (
  i = 0;
  loop(MAX_VOICES,
    v_active[i] && v_gate[i] && v_note[i] === note ? (
      v_gate[i] = 0;
      sustain_pedal && sustain_enabled(model, modal_material) ? v_sus[i] = 1 : vcall(i, 2, 0, 0);
    );
    i += 1;
  );
);

function note_on(note, velocity) local(i, idx, limit) (
  velocity <= 0 ? note_off(note) : (
    limit = model === MODEL_MESH ? MESH_MAX_VOICES : MAX_VOICES;
    idx = -1;
    i = 0;
    loop(limit, v_active[i] && v_note[i] === note ? idx = i; i += 1;);
    idx < 0 ? idx = voice_allocate(limit);
    v_note[idx] = note;
    v_active[idx] = 1;
    v_gate[idx] = 1;
    v_sus[idx] = 0;
    age_counter += 1;
    v_age[idx] = age_counter;
    vcall(idx, 1, note, velocity);
  );
);

function all_notes_off() local(i) (
  sustain_pedal = 0;
  i = 0;
  loop(MAX_VOICES,
    v_active[i] && (v_gate[i] || v_sus[i]) ? vcall(i, 2, 0, 0);
    v_gate[i] = 0; v_sus[i] = 0;
    i += 1;
  );
);

function pitch_bend(value) local(i) (
  bend_ratio = pow(2, (clamp(value, -1, 1) * phys_pitch_bend_range_cents) / 1200);
  i = 0;
  loop(MAX_VOICES, v_active[i] ? vcall(i, 3, 0, 0); i += 1;);
);

function channel_pressure(value) local(i) (
  pressure = clamp(value, 0, 1);
  i = 0;
  loop(MAX_VOICES, v_active[i] ? vcall(i, 4, -1, 0); i += 1;);
);

function poly_pressure(note, value) local(i) (
  i = 0;
  loop(MAX_VOICES, v_active[i] && v_note[i] === note ? vcall(i, 4, clamp(value, 0, 1), 0); i += 1;);
);

/** Reset All Controllers: channel pressure and every key's aftertouch back to 0 */
function pressure_reset() local(i) (
  i = 0;
  loop(MAX_VOICES, vcall(i, 5, 0, 0); i += 1;);
  channel_pressure(0);
);

function handle_midi(m1, m2, m3) local(type) (
  type = m1 & 0xF0;
  type === 0x90 ? note_on(m2, m3)
  : type === 0x80 ? note_off(m2)
  : type === 0xE0 ? pitch_bend(((m3 * 128 + m2) / 8192) - 1)
  : type === 0xD0 ? channel_pressure(m2 / 127) // channel pressure (one data byte)
  : type === 0xA0 ? poly_pressure(m2, m3 / 127) // polyphonic aftertouch
  : type === 0xB0 ? (
    m2 === 64 ? sustain(m3 >= 64)
    : m2 === 1 ? modwheel = clamp(m3 / 127, 0, 1)
    : m2 === 120 || m2 === 123 ? all_notes_off()
    : m2 === 121 ? (sustain(0); pitch_bend(0); pressure_reset(););
  );
);

@slider
// Release deferred notes with the previous model before changing the voice engine.
(floor(phys_model + 0.5) !== model || (floor(phys_model + 0.5) === MODEL_MODAL && modal_material !== pedal_material) ||
  !sustain_enabled(floor(phys_model + 0.5), modal_material)) ? flush_sustain(pedal_release, pedal_mesh_decay);
pedal_material = modal_material;
pedal_release = phys_release_ms;
pedal_mesh_decay = mesh_decay_ms;
// EDO sliders, the scale file or a shared AmiSynth Tuning slot
tuning_apply();
out_gain = db_to_gain(phys_volume_db);
string_damp_b = 0.05 + 0.9 * string_damping; // one-pole coefficient in the loop
model = floor(phys_model + 0.5);
vib_inc = phys_vibrato_rate_hz / srate;
flut_a = 1 - exp((-2 * $pi * 5) / srate);
hiss_a = 1 - exp((-2 * $pi * 1000) / srate);
reed_k = 1 / (2 * sin(($pi * 1000) / srate));
fr_bias = 0.25 + 0.3 * wind_embouchure;
fr_det = pow(2, free_reed_detune_cents / 1200);
fr_n = free_reed_detune_cents > 0 ? 3 : 1;
saw_c = 0.8 - 0.55 * string_sawari;
sc.sidechain_set(sc_input_gain_db, sc_attack_ms, sc_release_ms, sc_duck_db);
saw_env_c = exp(-1 / (0.03 * srate));
saw_dc_a = 1 - exp((-2 * $pi * 5) / srate);
saw_m_a = 1 - exp(-1 / (0.02 * srate));
organ_w[0] = organ_bar_w(organ_drawbar_16); organ_w[1] = organ_bar_w(organ_drawbar_5_13);
organ_w[2] = organ_bar_w(organ_drawbar_8); organ_w[3] = organ_bar_w(organ_drawbar_4);
organ_w[4] = organ_bar_w(organ_drawbar_2_23); organ_w[5] = organ_bar_w(organ_drawbar_2);
organ_w[6] = organ_bar_w(organ_drawbar_1_35); organ_w[7] = organ_bar_w(organ_drawbar_1_13);
organ_w[8] = organ_bar_w(organ_drawbar_1);
org_perc_sel = floor(organ_percussion + 0.5);
org_perc_k = org_perc_sel === 1 ? 4 : org_perc_sel === 2 ? 6 : 0;
org_perc_coef = t60_coef(organ_perc_decay_ms);
org_perc_lvl = 2 * ORGAN_GAIN * organ_perc_level;
org_click_len = max(1, floor(0.004 * srate + 0.5));
org_click = 0.4 * organ_click;
rot_mode_new = floor(rotary_mode + 0.5);
rot_mode_new > 0 && rot_mode <= 0 ? (
  // the bypassed speaker kept its last sound; start it again from silence
  rot_line.delay_clear();
  rot_xo.z = 0;
);
rot_mode = rot_mode_new;
rot_mix = rotary_mix;
rot_xo.onepole_set(800);
rot_d0 = max(1, 0.0002 * srate);
rot_dd = 0.00035 * srate;
horn_c = 1 - exp(-1 / (0.5 * srate));
drum_c = 1 - exp(-1 / (3 * srate));
room_update(phys_room_decay_ms);
amp_t = clamp(floor(amp_type + 0.5), 0, 4);
amp_t > 0 ? (
  amp_drive = amp_tab[amp_t * 7 + 1] * pow(amp_tab[amp_t * 7 + 2] / amp_tab[amp_t * 7 + 1], amp_gain);
  amp_bias = amp_tab[amp_t * 7 + 3];
  amp_bias_out = soft_clip(amp_bias);
  amp_stages = amp_tab[amp_t * 7 + 4];
  amp_out = db_to_gain(amp_level_db);
  amp_cab_hz = amp_tab[amp_t * 7 + 5] * pow(amp_tab[amp_t * 7 + 6] / amp_tab[amp_t * 7 + 5], amp_tone);
  amp_l.amp_set(amp_tab[amp_t * 7], amp_cab_hz);
  amp_r.amp_set(amp_tab[amp_t * 7], amp_cab_hz);
);
mesh_n_new = clamp(floor(mesh_size + 0.5), 6, MESH_MAX);
mesh_shape_new = floor(mesh_shape + 0.5);
mesh_n_new !== mesh_n || mesh_shape_new !== mesh_shape_cur ? mesh_setup(mesh_n_new, mesh_shape_new);

@block
midi_queue_read();
// a shared scale (AmiSynth Tuning) changed: new notes use it
tuning_shared_changed() ? tuning_apply();

@sample
while (midi_pop()) ( handle_midi(midi_m1, midi_m2, midi_m3); );
midi_tick();

// vibrato for the delay-line models (ratio = 1 exactly when off); aftertouch can deepen it per note
vib_g = 1;
vib_sin = 0;
phys_vibrato_cents > 0 || phys_pressure_vibrato_cents > 0 ? (
  vib_sin = sin(2 * $pi * vib_phase);
  vib_g = pow(2, (phys_vibrato_cents * vib_sin) / 1200);
  vib_phase += vib_inc;
  vib_phase >= 1 ? vib_phase -= 1;
);

mix_l = 0;
mix_r = 0;
bridge = 0;
p0.voice_render(); p1.voice_render(); p2.voice_render(); p3.voice_render();
p4.voice_render(); p5.voice_render(); p6.voice_render(); p7.voice_render();

model === MODEL_STIFF && piano_soundboard > 0 ? (
  // what you hear of a piano is mostly its soundboard; the strings barely radiate
  soundboard_process(bridge);
  sb_dry = 1 - 0.7 * piano_soundboard;
  mix_l = mix_l * sb_dry + piano_soundboard * sb_l;
  mix_r = mix_r * sb_dry + piano_soundboard * sb_r;
);

amp_t > 0 ? (
  mix_l = amp_l.amp_process(mix_l);
  mix_r = amp_r.amp_process(mix_r);
);
rot_mode > 0 ? rotary_process(mix_l, mix_r);
rot_mode > 0 && rot_mix > 0 ? (
  mix_l += rot_mix * (rot_l - mix_l);
  mix_r += rot_mix * (rot_r - mix_r);
);
phys_room_mix > 0 ? (
  room_process(mix_l, mix_r);
  mix_l += phys_room_mix * room_l;
  mix_r += phys_room_mix * room_r;
);

g = out_gain * 0.5;
sc.duck_db > 0 ? g *= sc.sidechain_duck_gain(sc.sidechain_process(spl2, spl3));
spl0 = soft_clip(dc.onepole_hp(mix_l) * g);
spl1 = soft_clip(dc_r.onepole_hp(mix_r) * g);
meter.meter_tick(spl0, spl1);

@gfx 520 150
meter.meter_draw();
meter.match_request ? (
  phys_volume_db = clamp(phys_volume_db + meter.correction, -60, 6);
  out_gain = db_to_gain(phys_volume_db);
  sliderchange(phys_volume_db); slider_automate(phys_volume_db);
);
