# Writes a C++ header that embeds the JSFX files (and their .rpl preset banks) in the plugin.
#   cmake -DOUT=<header> -DLIST=<file listing one path per line> -DAUTOMATION=<automation.json> -P embed-jsfx.cmake
# Also embeds each parameter's group from jsfx/generated/automation.json (the CLAP parameter module).
file(STRINGS "${LIST}" FILES)
set(body "")
set(table "")
set(all "")
set(i 0)
foreach(path IN LISTS FILES)
  get_filename_component(name "${path}" NAME)
  file(READ "${path}" hex HEX)
  file(SHA1 "${path}" sum)
  string(APPEND all "${name}:${sum}\n")
  string(LENGTH "${hex}" hexlen)
  math(EXPR size "${hexlen} / 2")
  set(bytes "")
  set(pos 0)
  while(pos LESS hexlen)
    string(SUBSTRING "${hex}" ${pos} 64 chunk)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," chunk "${chunk}")
    string(APPEND bytes "${chunk}\n")
    math(EXPR pos "${pos} + 64")
  endwhile()
  string(APPEND body "static const unsigned char kFile${i}[] = {\n${bytes}0};\n")
  string(APPEND table "    {\"${name}\", kFile${i}, ${size}},\n")
  math(EXPR i "${i} + 1")
endforeach()
file(READ "${AUTOMATION}" automation)
set(groups "")
foreach(inst synth phys drums tuning)
  string(JSON count LENGTH "${automation}" instruments ${inst} parameters)
  math(EXPR last "${count} - 1")
  set(names "")
  foreach(k RANGE ${last})
    string(JSON group GET "${automation}" instruments ${inst} parameters ${k} group)
    string(APPEND names "    \"${group}\",\n")
  endforeach()
  string(APPEND groups "static const char *const kGroups_${inst}[] = {\n${names}};\n")
endforeach()
string(SHA1 hash "${all}")
string(SUBSTRING "${hash}" 0 12 hash)
file(WRITE "${OUT}.tmp" "// Generated by clap/cmake/embed-jsfx.cmake from jsfx/. Do not edit.\n#pragma once\n#include <cstddef>\n\n${body}
struct EmbeddedFile { const char *name; const unsigned char *data; size_t size; };
static const EmbeddedFile kEmbeddedFiles[] = {\n${table}};
static const char kEmbeddedHash[] = \"${hash}\";\n\n// parameter groups by slider index (jsfx/generated/automation.json)\n${groups}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
