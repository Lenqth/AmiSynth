{
  // Static assets only (no Worker script): Cloudflare serves the Vite build output.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amisynth",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
